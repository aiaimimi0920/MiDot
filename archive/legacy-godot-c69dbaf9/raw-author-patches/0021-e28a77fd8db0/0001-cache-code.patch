+      /* isBackground= */ false,
+      /* background= */
+      [](const DynamicScheme& s) -> DynamicColor { return PrimaryContainer(); },
+      /* secondBackground= */ nullopt,
+      /* contrastCurve= */ ContrastCurve(4.5, 7.0, 11.0, 21.0),
+      /* toneDeltaPair= */ nullopt);
