+   */
+  static CorePalette ContentOf(int argb);
+
+  TonalPalette primary();
+  TonalPalette secondary();
+  TonalPalette tertiary();
+  TonalPalette neutral();
+  TonalPalette neutral_variant();
+  TonalPalette error();
