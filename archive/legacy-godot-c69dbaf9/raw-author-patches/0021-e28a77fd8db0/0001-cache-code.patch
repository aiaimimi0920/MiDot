+constexpr double kContentAccentToneDelta = 15.0;
+DynamicColor highestSurface(const DynamicScheme& s) {
+  return s.is_dark ? MaterialDynamicColors::SurfaceBright()
+                   : MaterialDynamicColors::SurfaceDim();
+}
