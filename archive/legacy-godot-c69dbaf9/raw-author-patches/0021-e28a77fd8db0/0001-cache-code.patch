+#ifndef CPP_TEMPERATURE_TEMPERATURE_CACHE_H_
+#define CPP_TEMPERATURE_TEMPERATURE_CACHE_H_
+
+#include <map>
+#include <vector>
+
+#include "../cam/hct.h"
