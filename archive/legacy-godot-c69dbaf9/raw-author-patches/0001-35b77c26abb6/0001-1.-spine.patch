+#ifdef TOOLS_ENABLED
+		EditorNode::add_init_callback(editor_init_callback);
+		GDREGISTER_CLASS(SpineEditorPropertyAnimationMixes);
+		return;
+#endif
+	}
+	if (level != MODULE_INITIALIZATION_LEVEL_CORE) return;
+#else
+void register_spine_godot_types() {
