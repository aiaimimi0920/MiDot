+
+			item = Json::getItem(slotMap, "attachment");
+			if (item) data->setAttachmentName(item->_valueString);
+
+			item = Json::getItem(slotMap, "blend");
+			if (item) {
+				if (strcmp(item->_valueString, "additive") == 0) data->_blendMode = BlendMode_Additive;
