+	return _ascaleX;
+}
+
+void Bone::setAScaleX(float inValue) {
+	_ascaleX = inValue;
+}
+
+float Bone::getAScaleY() {
+	return _ascaleY;
+}
+
+void Bone::setAScaleY(float inValue) {
+	_ascaleY = inValue;
+}
