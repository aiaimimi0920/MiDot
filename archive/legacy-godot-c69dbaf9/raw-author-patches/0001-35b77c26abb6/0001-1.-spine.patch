+}
+
+void Bone::setScaleY(float inValue) {
+	_scaleY = inValue;
+}
+
+float Bone::getShearX() {
+	return _shearX;
+}
+
+void Bone::setShearX(float inValue) {
+	_shearX = inValue;
+}
+
+float Bone::getShearY() {
+	return _shearY;
+}
+
