+Color &PointAttachment::getColor() {
+	return _color;
+}
+
+Attachment *PointAttachment::copy() {
+	PointAttachment *copy = new (__FILE__, __LINE__) PointAttachment(getName());
+	copy->_x = _x;
+	copy->_y = _y;
+	copy->_rotation = _rotation;
+	return copy;
+}
