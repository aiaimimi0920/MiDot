+	if (!attachment) return nullptr;
+	Ref<SpineAttachment> attachment_ref(memnew(SpineAttachment));
+	attachment_ref->set_spine_object(*sprite->get_skeleton_data_res(), attachment);
+	return attachment_ref;
+}
