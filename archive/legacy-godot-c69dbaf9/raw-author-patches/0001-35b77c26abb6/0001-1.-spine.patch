+		for (slotMap = slots->_child, i = 0; slotMap; slotMap = slotMap->_next, ++i) {
+			SlotData *data;
+			const char *color;
+			const char *dark;
+			Json *item;
+
+			const char *boneName = Json::getString(slotMap, "bone", 0);
