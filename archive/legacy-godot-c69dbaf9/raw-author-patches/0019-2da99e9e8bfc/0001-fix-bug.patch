 	if (!opening_prev) {
 		List<String>::Element *prev_scene_item = previous_scenes.find(p_path);
 		if (prev_scene_item != nullptr) {
@@ -4042,7 +4042,7 @@ void EditorNode::open_request(const String &p_path) {
