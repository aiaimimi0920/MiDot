static void set_dynamic_flat_stylebox(Ref<Theme> &theme, const StringName &p_item, const StringName &p_type, ColorRole p_role, const Color &p_scale) {
	if (!theme->has_stylebox(p_item, p_type)) {
		return;
	}

	Ref<StyleBoxFlat> stylebox = theme->get_stylebox(p_item, p_type)->duplicate();
	if (stylebox.is_null()) {
		return;
	}

	theme->set_stylebox(p_item, p_type, stylebox);
	stylebox->set_bg_color_role(p_role);
	stylebox->set_bg_color_scale(p_scale);
}

static void set_dynamic_line_stylebox(Ref<Theme> &theme, const StringName &p_item, const StringName &p_type, ColorRole p_role, const Color &p_scale) {
	if (!theme->has_stylebox(p_item, p_type)) {
		return;
	}

	Ref<StyleBoxLine> stylebox = theme->get_stylebox(p_item, p_type)->duplicate();
	if (stylebox.is_null()) {
		return;
	}

	theme->set_stylebox(p_item, p_type, stylebox);
	stylebox->set_color_role(p_role);
	stylebox->set_color_scale(p_scale);
}

