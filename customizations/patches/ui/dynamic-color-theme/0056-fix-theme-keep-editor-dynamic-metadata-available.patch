From 7585ab90e52b1b5c3c13908b492b1fcb35c5c571 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Wed, 23 Sep 2026 20:04:05 -0700
Subject: [PATCH] fix(theme): keep editor dynamic metadata available

Godot-Patch-Topic: ui.dynamic-color-theme
---
 scene/gui/control.cpp         | 2 +-
 scene/main/window.cpp         | 2 +-
 scene/theme/default_theme.cpp | 5 +----
 3 files changed, 3 insertions(+), 6 deletions(-)

diff --git a/scene/gui/control.cpp b/scene/gui/control.cpp
index 0d39f0b83b8d7c5430636d86e9c99ddc8cf68619..41370ea8c32c15f72faefe58dfa012ba95e54261 100644
--- a/scene/gui/control.cpp
+++ b/scene/gui/control.cpp
@@ -4139,7 +4139,7 @@ Color Control::get_theme_color(const StringName &p_name, const StringName &p_the
 		WARN_PRINT_ONCE(vformat("Attempting to access theme items too early in %s; prefer NOTIFICATION_POSTINITIALIZE and NOTIFICATION_THEME_CHANGED", get_description()));
 	}
 	auto resolve_dynamic_color = [&](ColorRole p_color_role, Color &r_color) {
-		if (p_color_role == ColorRole::STATIC) {
+		if (p_color_role == ColorRole::STATIC || Engine::get_singleton()->is_editor_hint()) {
 			return false;
 		}
 
diff --git a/scene/main/window.cpp b/scene/main/window.cpp
index fd0ee830c5632bcd35cdde1a05e7fc0f564ccc45..c0c986a255a4a5b09735131c791e3bc723462cc1 100644
--- a/scene/main/window.cpp
+++ b/scene/main/window.cpp
@@ -2990,7 +2990,7 @@ Color Window::get_theme_color(const StringName &p_name, const StringName &p_them
 		WARN_PRINT_ONCE(vformat("Attempting to access theme items too early in %s; prefer NOTIFICATION_POSTINITIALIZE and NOTIFICATION_THEME_CHANGED", get_description()));
 	}
 	auto resolve_dynamic_color = [&](ColorRole p_color_role, Color &r_color) {
-		if (p_color_role == ColorRole::STATIC) {
+		if (p_color_role == ColorRole::STATIC || Engine::get_singleton()->is_editor_hint()) {
 			return false;
 		}
 
diff --git a/scene/theme/default_theme.cpp b/scene/theme/default_theme.cpp
index aad388bedaeebf7ccaeaea7043e5952b61e832b4..ba9d54efd3a865f2b3ec487f8b4c8e2b42fdabe3 100644
--- a/scene/theme/default_theme.cpp
+++ b/scene/theme/default_theme.cpp
@@ -30,7 +30,6 @@
 
 #include "default_theme.h"
 
-#include "core/config/engine.h"
 #include "core/io/image.h"
 #include "scene/resources/dpi_texture.h"
 #include "scene/resources/font.h"
@@ -1456,9 +1455,7 @@ void fill_default_theme(Ref<Theme> &theme, const Ref<Font> &default_font, const
 	theme->set_icon("resize", "Debug", icons["debug_resize"]);
 	theme->set_icon("anchor", "Debug", icons["debug_anchor"]);
 #endif
-	if (!Engine::get_singleton()->is_editor_hint()) {
-		fill_dynamic_color_metadata(theme, p_color_scheme);
-	}
+	fill_dynamic_color_metadata(theme, p_color_scheme);
 	fill_dynamic_stylebox_metadata(theme);
 
 	// Theme

