From 23f91b9ea521741148ccfeedeee878a686ecfec6 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Wed, 23 Sep 2026 02:48:23 -0700
Subject: [PATCH] fix(color-rect): honor node color schemes

Godot-Patch-Topic: ui.dynamic-color-theme
---
 scene/gui/color_rect.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/scene/gui/color_rect.cpp b/scene/gui/color_rect.cpp
index 2a0d2ec86853396275488f19f780c17d3c1c9b0a..47dafaefe30b3c41aabebd14b266c68dfa79fcea 100644
--- a/scene/gui/color_rect.cpp
+++ b/scene/gui/color_rect.cpp
@@ -84,6 +84,9 @@ void ColorRect::_update_color() {
 	Color target_color = color;
 	if (color_role != ColorRole::STATIC) {
 		Ref<ColorScheme> active_color_scheme = color_scheme;
+		if (active_color_scheme.is_null()) {
+			active_color_scheme = get_theme_color_scheme("default_color_scheme");
+		}
 		if (active_color_scheme.is_null()) {
 			active_color_scheme = get_theme_default_color_scheme();
 		}

