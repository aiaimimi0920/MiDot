From b6c3ace02d9d2545c458372c438e7757e01e6e91 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Wed, 23 Sep 2026 02:50:31 -0700
Subject: [PATCH] feat(theme): add dynamic metadata for controls

Godot-Patch-Topic: ui.dynamic-color-theme
---
 scene/theme/default_theme_dynamic_color.inc | 77 +++++++++++++++++++++
 1 file changed, 77 insertions(+)

diff --git a/scene/theme/default_theme_dynamic_color.inc b/scene/theme/default_theme_dynamic_color.inc
index 94aab7279373bc7cc16609518d046f5e486cacf2..32699dcfd05f8a1c2c8027bc38730cafc0096728 100644
--- a/scene/theme/default_theme_dynamic_color.inc
+++ b/scene/theme/default_theme_dynamic_color.inc
@@ -528,6 +528,18 @@ static void fill_dynamic_color_metadata(Ref<Theme> &theme, const Ref<ColorScheme
 	theme->set_color("font_disabled_color_scale", "TabBar", control_font_disabled_color_scale);
 	theme->set_color("font_outline_color_scale", "TabBar", Color(1, 1, 1));
 	theme->set_color("drop_mark_color_scale", "TabBar", Color(1, 1, 1));
+	theme->set_color_scheme("icon_selected_color_scheme", "TabBar", Ref<ColorScheme>());
+	theme->set_color_scheme("icon_hovered_color_scheme", "TabBar", Ref<ColorScheme>());
+	theme->set_color_scheme("icon_unselected_color_scheme", "TabBar", Ref<ColorScheme>());
+	theme->set_color_scheme("icon_disabled_color_scheme", "TabBar", Ref<ColorScheme>());
+	theme->set_color_role("icon_selected_color_role", "TabBar", ColorRole::ON_PRIMARY);
+	theme->set_color_role("icon_hovered_color_role", "TabBar", ColorRole::ON_PRIMARY);
+	theme->set_color_role("icon_unselected_color_role", "TabBar", ColorRole::ON_PRIMARY);
+	theme->set_color_role("icon_disabled_color_role", "TabBar", ColorRole::ON_PRIMARY);
+	theme->set_color("icon_selected_color_scale", "TabBar", Color(1, 1, 1));
+	theme->set_color("icon_hovered_color_scale", "TabBar", Color(1, 1, 1));
+	theme->set_color("icon_unselected_color_scale", "TabBar", Color(1, 1, 1));
+	theme->set_color("icon_disabled_color_scale", "TabBar", Color(1, 1, 1));
 	theme->set_color_scheme("default_color_scheme", "TabBar", p_color_scheme);
 	theme->set_color("font_color_scale", "ColorPickerButton", control_font_color_scale);
 	theme->set_color("font_focus_color_scale", "ColorPickerButton", control_font_focus_color_scale);
@@ -606,6 +618,54 @@ static void fill_dynamic_color_metadata(Ref<Theme> &theme, const Ref<ColorScheme
 	theme->set_color_scheme("resizer_color_scheme", "GraphEditMinimap", Ref<ColorScheme>());
 	theme->set_color_role("resizer_color_role", "GraphEditMinimap", ColorRole::PRIMARY);
 	theme->set_color("resizer_color_scale", "GraphEditMinimap", Color(1, 1, 1, 0.85));
+	theme->set_color_scheme("default_color_scheme", "FoldableContainer", p_color_scheme);
+	theme->set_color_scheme("font_color_scheme", "FoldableContainer", Ref<ColorScheme>());
+	theme->set_color_scheme("hover_font_color_scheme", "FoldableContainer", Ref<ColorScheme>());
+	theme->set_color_scheme("collapsed_font_color_scheme", "FoldableContainer", Ref<ColorScheme>());
+	theme->set_color_scheme("font_outline_color_scheme", "FoldableContainer", Ref<ColorScheme>());
+	theme->set_color_role("font_color_role", "FoldableContainer", ColorRole::ON_PRIMARY);
+	theme->set_color_role("hover_font_color_role", "FoldableContainer", ColorRole::ON_PRIMARY);
+	theme->set_color_role("collapsed_font_color_role", "FoldableContainer", ColorRole::ON_PRIMARY);
+	theme->set_color_role("font_outline_color_role", "FoldableContainer", ColorRole::OUTLINE);
+	theme->set_color("font_color_scale", "FoldableContainer", control_font_color_scale);
+	theme->set_color("hover_font_color_scale", "FoldableContainer", control_font_hover_color_scale);
+	theme->set_color("collapsed_font_color_scale", "FoldableContainer", control_font_pressed_color_scale);
+	theme->set_color("font_outline_color_scale", "FoldableContainer", control_font_outline_color_scale);
+	// SpinBox button backgrounds and icon modulation.
+	for (const StringName &item : { SNAME("up_background"), SNAME("up_background_hovered"), SNAME("up_background_pressed"), SNAME("up_background_disabled"), SNAME("down_background"), SNAME("down_background_hovered"), SNAME("down_background_pressed"), SNAME("down_background_disabled") }) {
+		theme->set_color_scheme(String(item) + "_scheme", "SpinBox", p_color_scheme);
+	}
+	for (const StringName &item : { SNAME("up_icon_modulate"), SNAME("up_hover_icon_modulate"), SNAME("up_pressed_icon_modulate"), SNAME("up_disabled_icon_modulate"), SNAME("down_icon_modulate"), SNAME("down_hover_icon_modulate"), SNAME("down_pressed_icon_modulate"), SNAME("down_disabled_icon_modulate") }) {
+		theme->set_color_scheme(String(item) + "_scheme", "SpinBox", Ref<ColorScheme>());
+		theme->set_color_role(String(item) + "_role", "SpinBox", ColorRole::ON_PRIMARY);
+		theme->set_color(String(item) + "_scale", "SpinBox", control_font_color_scale);
+	}
+	for (const StringName &item : { SNAME("panel"), SNAME("focus") }) {
+		theme->set_color_scheme(String(item) + "_scheme", "ScrollContainer", p_color_scheme);
+	}
+	theme->set_color_scheme("scroll_hint_vertical_color_scheme", "ScrollContainer", Ref<ColorScheme>());
+	theme->set_color_scheme("scroll_hint_horizontal_color_scheme", "ScrollContainer", Ref<ColorScheme>());
+	theme->set_color_role("scroll_hint_vertical_color_role", "ScrollContainer", ColorRole::ON_SURFACE);
+	theme->set_color_role("scroll_hint_horizontal_color_role", "ScrollContainer", ColorRole::ON_SURFACE);
+	theme->set_color("scroll_hint_vertical_color_scale", "ScrollContainer", control_font_color_scale);
+	theme->set_color("scroll_hint_horizontal_color_scale", "ScrollContainer", control_font_color_scale);
+	for (const StringName &type : { SNAME("SplitContainer"), SNAME("HSplitContainer"), SNAME("VSplitContainer") }) {
+		theme->set_color_scheme("touch_dragger_color_scheme", type, Ref<ColorScheme>());
+		theme->set_color_scheme("touch_dragger_pressed_color_scheme", type, Ref<ColorScheme>());
+		theme->set_color_scheme("touch_dragger_hover_color_scheme", type, Ref<ColorScheme>());
+		theme->set_color_role("touch_dragger_color_role", type, ColorRole::ON_SURFACE);
+		theme->set_color_role("touch_dragger_pressed_color_role", type, ColorRole::ON_SURFACE);
+		theme->set_color_role("touch_dragger_hover_color_role", type, ColorRole::ON_SURFACE);
+		theme->set_color("touch_dragger_color_scale", type, control_font_color_scale);
+		theme->set_color("touch_dragger_pressed_color_scale", type, control_font_color_scale);
+		theme->set_color("touch_dragger_hover_color_scale", type, control_font_color_scale);
+		theme->set_color_scheme("split_bar_background_scheme", type, p_color_scheme);
+	}
+	theme->set_color_scheme("separator_scheme", "HSeparator", p_color_scheme);
+	theme->set_color_scheme("separator_scheme", "VSeparator", p_color_scheme);
+	theme->set_color_scheme("resizer_color_scheme", "GraphFrame", Ref<ColorScheme>());
+	theme->set_color_role("resizer_color_role", "GraphFrame", ColorRole::ON_PRIMARY);
+	theme->set_color("resizer_color_scale", "GraphFrame", Color(1, 1, 1));
 }
 
 static void set_dynamic_flat_stylebox(Ref<Theme> &theme, const StringName &p_item, const StringName &p_type, ColorRole p_role, const Color &p_scale) {
@@ -725,4 +785,21 @@ static void fill_dynamic_stylebox_metadata(Ref<Theme> &theme) {
 	set_dynamic_flat_stylebox(theme, "panel", "GraphEditMinimap", ColorRole::PRIMARY, Color(0.24, 0.24, 0.24));
 	set_dynamic_flat_stylebox(theme, "camera", "GraphEditMinimap", ColorRole::PRIMARY, Color(0.65, 0.65, 0.65, 0.2));
 	set_dynamic_flat_stylebox(theme, "node", "GraphEditMinimap", ColorRole::PRIMARY, Color(1, 1, 1));
+	set_dynamic_flat_stylebox(theme, "tab_selected", "TabBar", ColorRole::SECONDARY_CONTAINER, style_normal_color_scale);
+	set_dynamic_flat_stylebox(theme, "tab_hovered", "TabBar", ColorRole::SECONDARY_CONTAINER, style_hover_color_scale);
+	set_dynamic_flat_stylebox(theme, "tab_unselected", "TabBar", ColorRole::SECONDARY_CONTAINER, style_pressed_color_scale);
+	set_dynamic_flat_stylebox(theme, "tab_disabled", "TabBar", ColorRole::SECONDARY_CONTAINER, style_disabled_color_scale);
+	set_dynamic_flat_stylebox(theme, "tab_focus", "TabBar", ColorRole::INVERSE_PRIMARY, style_focus_color_scale);
+	set_dynamic_flat_stylebox(theme, "button_pressed", "TabBar", ColorRole::PRIMARY, style_pressed_color_scale);
+	set_dynamic_flat_stylebox(theme, "button_highlight", "TabBar", ColorRole::PRIMARY, style_hover_color_scale);
+	set_dynamic_flat_stylebox(theme, "panel", "GraphFrame", ColorRole::PRIMARY, style_normal_color_scale);
+	set_dynamic_flat_stylebox(theme, "panel_selected", "GraphFrame", ColorRole::PRIMARY, style_hover_color_scale);
+	set_dynamic_flat_stylebox(theme, "titlebar", "GraphFrame", ColorRole::PRIMARY, style_normal_color_scale.lightened(0.3));
+	set_dynamic_flat_stylebox(theme, "titlebar_selected", "GraphFrame", ColorRole::PRIMARY, style_hover_color_scale);
+	set_dynamic_flat_stylebox(theme, "title_panel", "FoldableContainer", ColorRole::PRIMARY, style_pressed_color_scale);
+	set_dynamic_flat_stylebox(theme, "title_hover_panel", "FoldableContainer", ColorRole::PRIMARY, style_hover_color_scale);
+	set_dynamic_flat_stylebox(theme, "title_collapsed_panel", "FoldableContainer", ColorRole::PRIMARY, style_pressed_color_scale);
+	set_dynamic_flat_stylebox(theme, "title_collapsed_hover_panel", "FoldableContainer", ColorRole::PRIMARY, style_hover_color_scale);
+	set_dynamic_flat_stylebox(theme, "panel", "FoldableContainer", ColorRole::PRIMARY_CONTAINER, style_normal_color_scale);
+	set_dynamic_flat_stylebox(theme, "focus", "FoldableContainer", ColorRole::INVERSE_PRIMARY, style_focus_color_scale);
 }

