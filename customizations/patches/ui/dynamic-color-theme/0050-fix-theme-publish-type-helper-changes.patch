 scene/resources/theme.h                       |  2 +-
 .../color_scheme/test_color_scheme.cpp        |  6 ++
 tests/scene/test_theme.cpp                    | 78 +++++++++++++++++++
 4 files changed, 102 insertions(+), 8 deletions(-)

diff --git a/scene/resources/theme.cpp b/scene/resources/theme.cpp
index 4d07e99c440ff9fb2c9618dba01f58e44954e47d..76bcb0fd52c9f09d9d6943bed4365c881329c93d 100644
--- a/scene/resources/theme.cpp
+++ b/scene/resources/theme.cpp
@@ -1070,11 +1070,14 @@ void Theme::add_color_role_type(const StringName &p_theme_type) {
 	ERR_FAIL_COND_MSG(!is_valid_type_name(p_theme_type), vformat("Invalid type name: '%s'", p_theme_type));
 	if (!color_role_map.has(p_theme_type)) {
 		color_role_map[p_theme_type] = ThemeColorRoleMap();
+		_emit_theme_changed(true);
 	}
 }
 
 void Theme::remove_color_role_type(const StringName &p_theme_type) {
-	color_role_map.erase(p_theme_type);
+	if (color_role_map.erase(p_theme_type)) {
+		_emit_theme_changed(true);
+	}
 }
 
 void Theme::rename_color_role_type(const StringName &p_old_theme_type, const StringName &p_theme_type) {
@@ -1084,6 +1087,7 @@ void Theme::rename_color_role_type(const StringName &p_old_theme_type, const Str
 	}
 	color_role_map[p_theme_type] = color_role_map[p_old_theme_type];
 	color_role_map.erase(p_old_theme_type);
+	_emit_theme_changed(true);
 }
 
 void Theme::get_color_role_type_list(List<StringName> *p_list) const {
@@ -1184,6 +1188,7 @@ void Theme::add_color_scheme_type(const StringName &p_theme_type) {
 	ERR_FAIL_COND_MSG(!is_valid_type_name(p_theme_type), vformat("Invalid type name: '%s'", p_theme_type));
 	if (!color_scheme_map.has(p_theme_type)) {
 		color_scheme_map[p_theme_type] = ThemeColorSchemeMap();
+		_emit_theme_changed(true);
 	}
 }
 
@@ -1209,6 +1214,7 @@ void Theme::rename_color_scheme_type(const StringName &p_old_theme_type, const S
 	}
 	color_scheme_map[p_theme_type] = color_scheme_map[p_old_theme_type];
 	color_scheme_map.erase(p_old_theme_type);
+	_emit_theme_changed(true);
 }
 
 void Theme::get_color_scheme_type_list(List<StringName> *p_list) const {
@@ -1752,16 +1758,18 @@ void Theme::get_type_variation_list(const StringName &p_base_type, List<StringNa
 
 // Theme types.
 void Theme::add_type(const StringName &p_theme_type) {
+	_freeze_change_propagation();
 	// Add a record to every data type map.
 	for (int i = 0; i < Theme::DATA_TYPE_MAX; i++) {
 		Theme::DataType dt = (Theme::DataType)i;
 		add_theme_item_type(dt, p_theme_type);
 	}
 
-	_emit_theme_changed(true);
+	_unfreeze_and_propagate_changes();
 }
 
 void Theme::remove_type(const StringName &p_theme_type) {
+	_freeze_change_propagation();
 	// Gracefully remove the record from every data type map.
 	for (int i = 0; i < Theme::DATA_TYPE_MAX; i++) {
 		Theme::DataType dt = (Theme::DataType)i;
@@ -1780,10 +1788,11 @@ void Theme::remove_type(const StringName &p_theme_type) {
 		clear_type_variation(E);
 	}
 
-	_emit_theme_changed(true);
+	_unfreeze_and_propagate_changes();
 }
 
 void Theme::rename_type(const StringName &p_old_theme_type, const StringName &p_theme_type) {
+	_freeze_change_propagation();
 	// Gracefully rename the record in every data type map.
 	for (int i = 0; i < Theme::DATA_TYPE_MAX; i++) {
 		Theme::DataType dt = (Theme::DataType)i;
@@ -1809,7 +1818,7 @@ void Theme::rename_type(const StringName &p_old_theme_type, const StringName &p_
 		}
 	}
 
-	_emit_theme_changed(true);
+	_unfreeze_and_propagate_changes();
 }
 
 void Theme::get_type_list(List<StringName> *p_list) const {
@@ -2245,7 +2254,7 @@ Vector<String> Theme::_get_type_list() const {
 
 // Theme bulk manipulations.
 void Theme::_emit_theme_changed(bool p_notify_list_changed) {
-	if (no_change_propagation) {
+	if (change_propagation_depth > 0) {
 		return;
 	}
 
@@ -2256,11 +2265,12 @@ void Theme::_emit_theme_changed(bool p_notify_list_changed) {
 }
 
 void Theme::_freeze_change_propagation() {
-	no_change_propagation = true;
+	change_propagation_depth++;
 }
 
 void Theme::_unfreeze_and_propagate_changes() {
-	no_change_propagation = false;
+	ERR_FAIL_COND(change_propagation_depth == 0);
+	change_propagation_depth--;
 	_emit_theme_changed(true);
 }
 
diff --git a/scene/resources/theme.h b/scene/resources/theme.h
index 5078981fef001d4c09f1bd2f0c0d5244cac0bcda..75507417031cb2d2e16032a04ec063b766007a1d 100644
--- a/scene/resources/theme.h
+++ b/scene/resources/theme.h
@@ -72,7 +72,7 @@ public:
 	};
 
 private:
-	bool no_change_propagation = false;
+	uint32_t change_propagation_depth = 0;
 
 	void _emit_theme_changed(bool p_notify_list_changed = false);
 
