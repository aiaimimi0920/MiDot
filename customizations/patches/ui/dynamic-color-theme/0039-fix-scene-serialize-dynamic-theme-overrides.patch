+		uint32_t usage = PROPERTY_USAGE_EDITOR | PROPERTY_USAGE_CHECKABLE;
+		if (data.theme_color_role_override.has(p_name)) {
+			usage |= PROPERTY_USAGE_STORAGE | PROPERTY_USAGE_CHECKED;
