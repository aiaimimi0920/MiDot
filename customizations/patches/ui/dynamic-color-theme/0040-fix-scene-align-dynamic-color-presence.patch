Date: Wed, 23 Sep 2026 02:40:06 -0700
Subject: [PATCH] fix(scene): align dynamic color presence

Godot-Patch-Topic: ui.dynamic-color-theme
---
 scene/gui/control.cpp        | 42 ++++++++++++++++++------
 scene/main/window.cpp        | 42 ++++++++++++++++++------
 tests/scene/test_control.cpp | 63 ++++++++++++++++++++++++++++++++++++
 tests/scene/test_window.cpp  | 63 ++++++++++++++++++++++++++++++++++++
 4 files changed, 190 insertions(+), 20 deletions(-)

diff --git a/scene/gui/control.cpp b/scene/gui/control.cpp
index cca6128ca679fdf7c3242d3295200b9724d9b89a..4dc71405ed351c604b5f6a91d7d57d19817bfbd9 100644
--- a/scene/gui/control.cpp
+++ b/scene/gui/control.cpp
@@ -3989,11 +3989,15 @@ Color Control::get_theme_color(const StringName &p_name, const StringName &p_the
 		return true;
 	};
 
+	bool has_local_color_role_override = false;
 	if (p_theme_type == StringName() || p_theme_type == get_class_name() || p_theme_type == data.theme_type_variation) {
 		const ColorRole *color_role = data.theme_color_role_override.getptr(String(p_name) + "_role");
-		Color dynamic_color;
-		if (color_role && resolve_dynamic_color(*color_role, dynamic_color)) {
-			return dynamic_color;
+		if (color_role) {
+			has_local_color_role_override = true;
+			Color dynamic_color;
+			if (resolve_dynamic_color(*color_role, dynamic_color)) {
+				return dynamic_color;
+			}
 		}
 
 		const Color *color = data.theme_color_override.getptr(p_name);
@@ -4002,18 +4006,20 @@ Color Control::get_theme_color(const StringName &p_name, const StringName &p_the
 		}
 	}
 
-	if (data.theme_color_cache.has(p_theme_type) && data.theme_color_cache[p_theme_type].has(p_name)) {
+	if (!has_local_color_role_override && data.theme_color_cache.has(p_theme_type) && data.theme_color_cache[p_theme_type].has(p_name)) {
 		return data.theme_color_cache[p_theme_type][p_name];
 	}
 
 	Vector<StringName> theme_types;
 	data.theme_owner->get_theme_type_dependencies(this, p_theme_type, theme_types);
 	Color color = data.theme_owner->get_theme_item_in_types(Theme::DATA_TYPE_COLOR, p_name, theme_types);
-	if (data.theme_owner->has_theme_item_in_types(Theme::DATA_TYPE_COLOR_ROLE, String(p_name) + "_role", theme_types)) {
+	if (!has_local_color_role_override && data.theme_owner->has_theme_item_in_types(Theme::DATA_TYPE_COLOR_ROLE, String(p_name) + "_role", theme_types)) {
 		ColorRole color_role = data.theme_owner->get_theme_item_in_types(Theme::DATA_TYPE_COLOR_ROLE, String(p_name) + "_role", theme_types);
 		resolve_dynamic_color(color_role, color);
 	}
-	data.theme_color_cache[p_theme_type][p_name] = color;
+	if (!has_local_color_role_override) {
+		data.theme_color_cache[p_theme_type][p_name] = color;
+	}
 	return color;
 }
 
@@ -4281,15 +4287,31 @@ bool Control::has_theme_color(const StringName &p_name, const StringName &p_them
 		WARN_PRINT_ONCE(vformat("Attempting to access theme items too early in %s; prefer NOTIFICATION_POSTINITIALIZE and NOTIFICATION_THEME_CHANGED", get_description()));
 	}
 
-	if (p_theme_type == StringName() || p_theme_type == get_class_name() || p_theme_type == data.theme_type_variation) {
+	Vector<StringName> theme_types;
+	data.theme_owner->get_theme_type_dependencies(this, p_theme_type, theme_types);
+	const bool has_static_color = data.theme_owner->has_theme_item_in_types(Theme::DATA_TYPE_COLOR, p_name, theme_types);
+	const bool has_local_overrides = p_theme_type == StringName() || p_theme_type == get_class_name() || p_theme_type == data.theme_type_variation;
+	if (has_local_overrides) {
 		if (has_theme_color_override(p_name)) {
 			return true;
 		}
+
+		const ColorRole *color_role = data.theme_color_role_override.getptr(String(p_name) + "_role");
+		if (color_role) {
+			return has_static_color || (*color_role != ColorRole::STATIC && get_theme_color_scheme(String(p_name) + "_scheme", p_theme_type).is_valid());
+		}
 	}
 
-	Vector<StringName> theme_types;
-	data.theme_owner->get_theme_type_dependencies(this, p_theme_type, theme_types);
-	return data.theme_owner->has_theme_item_in_types(Theme::DATA_TYPE_COLOR, p_name, theme_types);
+	if (has_static_color) {
+		return true;
+	}
+
+	const StringName color_role_name = String(p_name) + "_role";
+	if (!data.theme_owner->has_theme_item_in_types(Theme::DATA_TYPE_COLOR_ROLE, color_role_name, theme_types)) {
+		return false;
+	}
+	const ColorRole color_role = data.theme_owner->get_theme_item_in_types(Theme::DATA_TYPE_COLOR_ROLE, color_role_name, theme_types);
+	return color_role != ColorRole::STATIC && get_theme_color_scheme(String(p_name) + "_scheme", p_theme_type).is_valid();
 }
 
