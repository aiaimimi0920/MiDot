From b26f8f95fdfd0f930bd8023308a9da286a915454 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Wed, 23 Sep 2026 03:44:56 -0700
Subject: [PATCH] build: require color scheme for theme system

Godot-Patch-Topic: ui.dynamic-color-theme
---
 SConstruct                            | 7 +++++++
 modules/color_scheme/color_scheme.cpp | 3 +++
 modules/color_scheme/color_scheme.h   | 2 --
 3 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/SConstruct b/SConstruct
index cf6475f172752f688124059a01d26781c5a97d94..266fa45cfad95ea6ada5d0f3a54affa8974bb4d9 100644
--- a/SConstruct
+++ b/SConstruct
@@ -514,6 +514,13 @@ env.modules_detected = modules_detected
 opts.Update(env, {**ARGUMENTS, **env.Dictionary()})
 Help(opts.GenerateHelpText(env))
 
+if not env.get("module_color_scheme_enabled", False):
+    print_error(
+        "ColorScheme is required by this engine's theme system. "
+        "Build with module_color_scheme_enabled=yes, including when modules_enabled_by_default=no."
+    )
+    Exit(255)
+
 
 # FIXME: Tool assignment happening at this stage is a direct consequence of getting the platform logic AFTER the SCons
 # environment was already been constructed. Fixing this would require a broader refactor where all options are setup
diff --git a/modules/color_scheme/color_scheme.cpp b/modules/color_scheme/color_scheme.cpp
index be2607edc7475f78daf8cf6bb29b84588b586986..b2747892b67bc35e5fd1976a295c6b88f78a677c 100644
--- a/modules/color_scheme/color_scheme.cpp
+++ b/modules/color_scheme/color_scheme.cpp
@@ -30,6 +30,9 @@
 
 #include "color_scheme.h"
 
+#include "thirdparty/material-color-utilities/quantize/celebi.h"
+#include "thirdparty/material-color-utilities/score/score.h"
+
 #include "core/object/callable_mp.h"
 #include "core/object/class_db.h"
 
diff --git a/modules/color_scheme/color_scheme.h b/modules/color_scheme/color_scheme.h
index 433d80804d0fa666d406f3f079a723eb8be5e22c..9d2760689cfee608f9eaa004763e43cc39ec6d7c 100644
--- a/modules/color_scheme/color_scheme.h
+++ b/modules/color_scheme/color_scheme.h
@@ -31,9 +31,7 @@
 #pragma once
 
 #include "color_role.h"
-#include "thirdparty/material-color-utilities/quantize/celebi.h"
 #include "thirdparty/material-color-utilities/scheme/scheme_content.h"
-#include "thirdparty/material-color-utilities/score/score.h"
 #include "thirdparty/material-color-utilities/utils/utils.h"
 
 #include "core/io/resource.h"

