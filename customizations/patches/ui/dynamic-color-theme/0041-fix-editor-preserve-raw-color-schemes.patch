From 4424576f0c0de3133c57bf89f20e25e381d2b4eb Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Wed, 23 Sep 2026 02:43:59 -0700
Subject: [PATCH] fix(editor): preserve raw color schemes

Godot-Patch-Topic: ui.dynamic-color-theme
---
 doc/classes/Theme.xml                    |  8 ++++---
 editor/scene/gui/theme_editor_plugin.cpp | 15 ++++++++-----
 scene/resources/theme.cpp                |  7 ++++++
 scene/resources/theme.h                  |  2 ++
 tests/scene/test_theme.cpp               | 27 ++++++++++++++++++++++++
 5 files changed, 51 insertions(+), 8 deletions(-)

diff --git a/doc/classes/Theme.xml b/doc/classes/Theme.xml
index 0c9778bc1844eaeef3ead4a587b7037c56d0a863..0629876dbaa75ff067ee1a3caf3630eb24e87c94 100644
--- a/doc/classes/Theme.xml
+++ b/doc/classes/Theme.xml
@@ -49,7 +49,7 @@
 			<param index="0" name="name" type="StringName" />
 			<param index="1" name="theme_type" type="StringName" />
 			<description>
-				Removes the [ColorScheme] property defined by [param name] and [param theme_type]. Fails if it does not exist; use [method has_color_scheme] to check first.
+				Removes the [ColorScheme] property defined by [param name] and [param theme_type], including an explicitly stored [code]null[/code] value. Fails if the item is not stored. Check whether [method get_color_scheme_list] contains [param name] before clearing it; [method has_color_scheme] also considers default schemes.
 			</description>
 		</method>
 		<method name="clear_constant">
@@ -165,14 +165,15 @@
 			<param index="0" name="name" type="StringName" />
 			<param index="1" name="theme_type" type="StringName" />
 			<description>
-				Returns the [ColorScheme] property defined by [param name] and [param theme_type]. If it is unavailable, this checks a [code skip-lint]default_color_scheme[/code] item for the type, then [member default_color_scheme], and finally [member ThemeDB.fallback_color_scheme].
+				Returns the [ColorScheme] property defined by [param name] and [param theme_type]. If it is missing or [code]null[/code], this checks a [code skip-lint]default_color_scheme[/code] item for the type, then [member default_color_scheme], and finally [member ThemeDB.fallback_color_scheme].
+				For editing or serialization, use [method get_color_scheme_list] to check whether the item is stored, and [method Object.get] with the property path [code]"&lt;theme_type&gt;/color_schemes/&lt;name&gt;"[/code] to read its stored value without applying these fallbacks.
 			</description>
 		</method>
 		<method name="get_color_scheme_list" qualifiers="const">
 			<return type="PackedStringArray" />
 			<param index="0" name="theme_type" type="String" />
 			<description>
-				Returns the names of [ColorScheme] properties defined for [param theme_type].
+				Returns the names of [ColorScheme] properties stored for [param theme_type], including items whose value is [code]null[/code]. Defaults and fallbacks do not add names to this list.
 			</description>
 		</method>
 		<method name="get_color_scheme_type_list" qualifiers="const">
@@ -391,6 +392,7 @@
 			<param index="1" name="theme_type" type="StringName" />
 			<description>
 				Returns [code]true[/code] if a valid [ColorScheme] is available from the property defined by [param name] and [param theme_type], the type's [code skip-lint]default_color_scheme[/code] item, or [member default_color_scheme]. This does not count [member ThemeDB.fallback_color_scheme].
+				To check whether an item is explicitly stored, including a [code]null[/code] item, check its name in [method get_color_scheme_list] instead.
 			</description>
 		</method>
 		<method name="has_constant" qualifiers="const">
diff --git a/editor/scene/gui/theme_editor_plugin.cpp b/editor/scene/gui/theme_editor_plugin.cpp
index 160b61374284ab4ccaa05dd4c36616604838a7bc..084ed272412b42e03af05e82f604a1aeac45f19e 100644
--- a/editor/scene/gui/theme_editor_plugin.cpp
+++ b/editor/scene/gui/theme_editor_plugin.cpp
@@ -905,7 +905,11 @@ void ThemeItemImportTree::_import_selected() {
 			Variant item_value = Variant();
 
 			if (cs == SELECT_IMPORT_FULL) {
-				item_value = base_theme->get_theme_item(ti.data_type, ti.item_name, ti.type_name);
+				if (ti.data_type == Theme::DATA_TYPE_COLOR_SCHEME) {
+					item_value = base_theme->get_color_scheme_nocheck(ti.item_name, ti.type_name);
+				} else {
+					item_value = base_theme->get_theme_item(ti.data_type, ti.item_name, ti.type_name);
+				}
 			} else {
 				switch (ti.data_type) {
 					case Theme::DATA_TYPE_COLOR:
@@ -1832,7 +1836,8 @@ void ThemeItemEditorDialog::_item_tree_button_pressed(Object *p_item, int p_colu
 			EditorUndoRedoManager *ur = EditorUndoRedoManager::get_singleton();
 			ur->create_action(TTR("Remove Theme Item"));
 			ur->add_do_method(*edited_theme, "clear_theme_item", (Theme::DataType)data_type, item_name, edited_item_type);
-			ur->add_undo_method(*edited_theme, "set_theme_item", (Theme::DataType)data_type, item_name, edited_item_type, edited_theme->get_theme_item((Theme::DataType)data_type, item_name, edited_item_type));
+			Variant old_value = data_type == Theme::DATA_TYPE_COLOR_SCHEME ? Variant(edited_theme->get_color_scheme_nocheck(item_name, edited_item_type)) : edited_theme->get_theme_item((Theme::DataType)data_type, item_name, edited_item_type);
+			ur->add_undo_method(*edited_theme, "set_theme_item", (Theme::DataType)data_type, item_name, edited_item_type, old_value);
 			ur->add_do_method(this, "_update_edit_item_tree", edited_item_type);
 			ur->add_undo_method(this, "_update_edit_item_tree", edited_item_type);
 			ur->commit_action();
@@ -3215,7 +3220,7 @@ void ThemeTypeEditor::_update_type_items() {
 			item_control->add_child(item_editor);
 
 			if (E.value) {
-				item_editor->set_edited_resource(edited_theme->get_color_scheme(E.key, edited_type));
+				item_editor->set_edited_resource(edited_theme->get_color_scheme_nocheck(E.key, edited_type));
 				item_editor->set_force_allow_unique(false);
 				item_editor->connect("resource_selected", callable_mp(this, &ThemeTypeEditor::_edit_resource_item));
 				item_editor->connect("resource_changed", callable_mp(this, &ThemeTypeEditor::_color_scheme_item_changed).bind(E.key));
@@ -3621,7 +3626,7 @@ void ThemeTypeEditor::_item_remove_cbk(int p_data_type, String p_item_name) {
 			ur->add_undo_method(*edited_theme, "set_color_role", p_item_name, edited_type, static_cast<int64_t>(edited_theme->get_color_role(p_item_name, edited_type)));
 		} break;
 		case Theme::DATA_TYPE_COLOR_SCHEME: {
-			Ref<ColorScheme> color_scheme = edited_theme->get_color_scheme(p_item_name, edited_type);
+			Ref<ColorScheme> color_scheme = edited_theme->get_color_scheme_nocheck(p_item_name, edited_type);
 			ur->add_do_method(*edited_theme, "clear_color_scheme", p_item_name, edited_type);
 			ur->add_undo_method(*edited_theme, "set_color_scheme", p_item_name, edited_type, color_scheme);
 		} break;
@@ -3824,7 +3829,7 @@ void ThemeTypeEditor::_color_scheme_item_changed(Ref<ColorScheme> p_value, Strin
 	ur->create_action(TTR("Set Color Scheme Item in Theme"));
 	ur->add_do_method(*edited_theme, "set_color_scheme", p_item_name, edited_type, p_value.is_valid() ? p_value : Ref<ColorScheme>());
 	if (edited_theme->has_color_scheme_nocheck(p_item_name, edited_type)) {
-		ur->add_undo_method(*edited_theme, "set_color_scheme", p_item_name, edited_type, edited_theme->get_color_scheme(p_item_name, edited_type));
+		ur->add_undo_method(*edited_theme, "set_color_scheme", p_item_name, edited_type, edited_theme->get_color_scheme_nocheck(p_item_name, edited_type));
 	} else {
 		ur->add_undo_method(*edited_theme, "clear_color_scheme", p_item_name, edited_type);
 	}
diff --git a/scene/resources/theme.cpp b/scene/resources/theme.cpp
index 2be7af6dde74c7fb13901643618c78aa669b6e6b..4d07e99c440ff9fb2c9618dba01f58e44954e47d 100644
--- a/scene/resources/theme.cpp
+++ b/scene/resources/theme.cpp
@@ -1124,6 +1124,13 @@ Ref<ColorScheme> Theme::get_color_scheme(const StringName &p_name, const StringN
 	return ThemeDB::get_singleton()->get_fallback_color_scheme();
 }
 
+Ref<ColorScheme> Theme::get_color_scheme_nocheck(const StringName &p_name, const StringName &p_theme_type) const {
+	if (!color_scheme_map.has(p_theme_type) || !color_scheme_map[p_theme_type].has(p_name)) {
+		return Ref<ColorScheme>();
+	}
+	return color_scheme_map[p_theme_type][p_name];
+}
+
 bool Theme::has_color_scheme(const StringName &p_name, const StringName &p_theme_type) const {
 	if (color_scheme_map.has(p_theme_type) && color_scheme_map[p_theme_type].has(p_name) && color_scheme_map[p_theme_type][p_name].is_valid()) {
 		return true;
diff --git a/scene/resources/theme.h b/scene/resources/theme.h
index fc0b351fec25edc010cbd128ab879dcbee5b88c6..5078981fef001d4c09f1bd2f0c0d5244cac0bcda 100644
--- a/scene/resources/theme.h
+++ b/scene/resources/theme.h
@@ -240,6 +240,8 @@ public:
 
 	void set_color_scheme(const StringName &p_name, const StringName &p_theme_type, const Ref<ColorScheme> &p_color_scheme);
 	virtual Ref<ColorScheme> get_color_scheme(const StringName &p_name, const StringName &p_theme_type) const;
+	// Returns only the value stored for this item. Use has_color_scheme_nocheck() to distinguish an absent item from a stored null scheme.
+	Ref<ColorScheme> get_color_scheme_nocheck(const StringName &p_name, const StringName &p_theme_type) const;
 	bool has_color_scheme(const StringName &p_name, const StringName &p_theme_type) const;
 	bool has_color_scheme_nocheck(const StringName &p_name, const StringName &p_theme_type) const;
 	void rename_color_scheme(const StringName &p_old_name, const StringName &p_name, const StringName &p_theme_type);
diff --git a/tests/scene/test_theme.cpp b/tests/scene/test_theme.cpp
index 5a6879b13e8a9a31f31893b8e213c5746a457c0c..4a5b01979b40f43d61151ecec396257ca7ad1c87 100644
--- a/tests/scene/test_theme.cpp
+++ b/tests/scene/test_theme.cpp
@@ -91,6 +91,33 @@ TEST_CASE("[Theme] Color role and color scheme theme items") {
 	CHECK_FALSE(theme->has_theme_item_nocheck(Theme::DATA_TYPE_COLOR_SCHEME, "font_color_scheme", "Button"));
 }
 
+TEST_CASE("[Theme] Raw color scheme access preserves stored null values") {
+	Ref<Theme> theme = memnew(Theme);
+	Ref<ColorScheme> default_scheme = memnew(ColorScheme(Color("#6750a4")));
+	Ref<ColorScheme> explicit_scheme = memnew(ColorScheme(Color("#006495")));
+	theme->set_default_color_scheme(default_scheme);
+
+	CHECK_FALSE(theme->has_color_scheme_nocheck("missing_scheme", "Button"));
+	CHECK_FALSE(theme->get_color_scheme_nocheck("missing_scheme", "Button").is_valid());
+	CHECK(theme->get_color_scheme("missing_scheme", "Button") == default_scheme);
+
+	theme->set_theme_item(Theme::DATA_TYPE_COLOR_SCHEME, "null_scheme", "Button", Ref<ColorScheme>());
+	CHECK(theme->has_color_scheme_nocheck("null_scheme", "Button"));
+	CHECK_FALSE(theme->get_color_scheme_nocheck("null_scheme", "Button").is_valid());
+	CHECK(theme->get_color_scheme("null_scheme", "Button") == default_scheme);
+	CHECK(Ref<ColorScheme>(theme->get_theme_item(Theme::DATA_TYPE_COLOR_SCHEME, "null_scheme", "Button")) == default_scheme);
+
+	Ref<Theme> snapshot = memnew(Theme);
+	snapshot->merge_with(theme);
+	CHECK(snapshot->has_color_scheme_nocheck("null_scheme", "Button"));
+	CHECK_FALSE(snapshot->get_color_scheme_nocheck("null_scheme", "Button").is_valid());
+
+	theme->set_theme_item(Theme::DATA_TYPE_COLOR_SCHEME, "explicit_scheme", "Button", explicit_scheme);
+	CHECK(theme->has_color_scheme_nocheck("explicit_scheme", "Button"));
+	CHECK(theme->get_color_scheme_nocheck("explicit_scheme", "Button") == explicit_scheme);
+	CHECK(theme->get_color_scheme("explicit_scheme", "Button") == explicit_scheme);
+}
+
 TEST_CASE("[Theme] String theme items") {
 	Ref<Theme> theme = memnew(Theme);
 

