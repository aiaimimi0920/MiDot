From ce4acab49e9522feefdce3dd120373b8297fcecf Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Wed, 23 Sep 2026 02:52:49 -0700
Subject: [PATCH] perf(color-scheme): cache extracted texture colors

Godot-Patch-Topic: ui.dynamic-color-theme
---
 modules/color_scheme/color_scheme.cpp         | 37 ++++++++++++-------
 modules/color_scheme/color_scheme.h           |  2 +
 .../color_scheme/test_color_scheme.cpp        | 15 ++++++++
 3 files changed, 40 insertions(+), 14 deletions(-)

diff --git a/modules/color_scheme/color_scheme.cpp b/modules/color_scheme/color_scheme.cpp
index 6904f9c94a50603014d1db8df1e43be0319354ff..1645f4f754137ddd33a54a72f45df506ed813f04 100644
--- a/modules/color_scheme/color_scheme.cpp
+++ b/modules/color_scheme/color_scheme.cpp
@@ -47,6 +47,7 @@ void ColorScheme::_update_color_scheme() {
 }
 
 void ColorScheme::_source_texture_changed() {
+	source_texture_color_cached = false;
 	dirty = true;
 	_update_color_scheme();
 }
@@ -54,23 +55,29 @@ void ColorScheme::_source_texture_changed() {
 material_color_utilities::SchemeContent ColorScheme::_create_scheme_content() {
 	Color cur_source_color = source_color;
 	if (source_texture.is_valid()) {
-		Ref<Image> cur_source_img = source_texture->get_image();
-		if (cur_source_img.is_valid() && !cur_source_img->is_empty() && (!cur_source_img->is_compressed() || cur_source_img->decompress() == OK)) {
-			std::vector<material_color_utilities::Argb> pixels;
-			pixels.reserve(cur_source_img->get_width() * cur_source_img->get_height());
-			for (int j = 0; j < cur_source_img->get_height(); j++) {
-				for (int i = 0; i < cur_source_img->get_width(); i++) {
-					pixels.push_back(cur_source_img->get_pixel(i, j).to_argb32());
+		if (source_texture_color_cached) {
+			cur_source_color = source_texture_color;
+		} else {
+			Ref<Image> cur_source_img = source_texture->get_image();
+			if (cur_source_img.is_valid() && !cur_source_img->is_empty() && (!cur_source_img->is_compressed() || cur_source_img->decompress() == OK)) {
+				std::vector<material_color_utilities::Argb> pixels;
+				pixels.reserve(cur_source_img->get_width() * cur_source_img->get_height());
+				for (int j = 0; j < cur_source_img->get_height(); j++) {
+					for (int i = 0; i < cur_source_img->get_width(); i++) {
+						pixels.push_back(cur_source_img->get_pixel(i, j).to_argb32());
+					}
 				}
-			}
 
-			material_color_utilities::QuantizerResult result = material_color_utilities::QuantizeCelebi(pixels, 256);
-			material_color_utilities::ScoreOptions cur_options;
-			cur_options.desired = 4;
-			std::vector<material_color_utilities::Argb> ranked = material_color_utilities::RankedSuggestions(result.color_to_count, cur_options);
-			if (!ranked.empty()) {
-				cur_source_color = get_color_from_argb(ranked.front());
+				material_color_utilities::QuantizerResult result = material_color_utilities::QuantizeCelebi(pixels, 256);
+				material_color_utilities::ScoreOptions cur_options;
+				cur_options.desired = 4;
+				std::vector<material_color_utilities::Argb> ranked = material_color_utilities::RankedSuggestions(result.color_to_count, cur_options);
+				if (!ranked.empty()) {
+					cur_source_color = get_color_from_argb(ranked.front());
+				}
 			}
+			source_texture_color = cur_source_color;
+			source_texture_color_cached = true;
 		}
 	}
 
@@ -89,6 +96,7 @@ void ColorScheme::set_source_color(Color p_source_color) {
 	}
 	source_color = p_source_color;
 	source_texture = Ref<Texture2D>();
+	source_texture_color_cached = false;
 	dirty = true;
 	_update_color_scheme();
 }
@@ -111,6 +119,7 @@ void ColorScheme::set_source_texture(const Ref<Texture2D> &p_source_texture) {
 		source_texture->connect_changed(callable_mp(this, &ColorScheme::_source_texture_changed), CONNECT_REFERENCE_COUNTED);
 	}
 	source_color = Color();
+	source_texture_color_cached = false;
 	dirty = true;
 	_update_color_scheme();
 }
diff --git a/modules/color_scheme/color_scheme.h b/modules/color_scheme/color_scheme.h
index 77e3010c87101c2a2ab3689b6470ef8f262cf307..67d579d22b63797e574524517cc7cf11dac5a440 100644
--- a/modules/color_scheme/color_scheme.h
+++ b/modules/color_scheme/color_scheme.h
@@ -45,6 +45,8 @@ class ColorScheme : public Resource {
 private:
 	Color source_color = Color("#6750a4");
 	Ref<Texture2D> source_texture;
+	Color source_texture_color;
+	bool source_texture_color_cached = false;
 	bool dark = false;
 	float contrast_level = 0.0f;
 	bool dirty = false;
diff --git a/tests/modules/color_scheme/test_color_scheme.cpp b/tests/modules/color_scheme/test_color_scheme.cpp
index 825612b19f8918a974925bb6f8a6f7ec5bc1f5f7..e778248819b46d38c30ff9a654ec1fb4630df18c 100644
--- a/tests/modules/color_scheme/test_color_scheme.cpp
+++ b/tests/modules/color_scheme/test_color_scheme.cpp
@@ -116,6 +116,21 @@ public:
 	}
 };
 
+TEST_CASE("[ColorScheme] Texture extraction is cached across scheme parameter changes") {
+	Ref<MutableTestTexture> texture = memnew(MutableTestTexture);
+	texture->set_color(Color(1, 0, 0));
+	ColorScheme scheme(texture);
+	CHECK(texture->get_image_reads() == 1);
+
+	scheme.set_dark(true);
+	CHECK(texture->get_image_reads() == 1);
+	scheme.set_contrast_level(0.5f);
+	CHECK(texture->get_image_reads() == 1);
+
+	texture->set_color(Color(0, 0, 1));
+	CHECK(texture->get_image_reads() == 2);
+}
+
 TEST_CASE("[ColorScheme] Texture palette follows content and detaches old sources") {
 	Ref<MutableTestTexture> texture = memnew(MutableTestTexture);
 	texture->set_color(Color(1, 0, 0));

