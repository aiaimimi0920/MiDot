From aa99fb9b9e029fb7406c8521bc00efe4565cdf6f Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Fri, 23 Oct 2026 00:44:56 +0800
Subject: [PATCH] fix(editor): prevent theme preview layout feedback

Measure preview content in its root-local coordinate space, stop at
Container intrinsic-size boundaries, and apply margins and editor scale
once. This preserves free-layout custom previews without feeding managed
positions from upstream 898de236c13e back into the minimum size.

Cover managed and free-layout content at 100%, 125%, and 200% editor scale.

Godot-Patch-Topic: ui.dynamic-color-theme
---
 editor/scene/gui/theme_editor_preview.cpp |  33 +++---
 tests/scene/test_theme_editor_preview.cpp | 117 ++++++++++++++++++++++
 2 files changed, 138 insertions(+), 12 deletions(-)
 create mode 100644 tests/scene/test_theme_editor_preview.cpp

diff --git a/editor/scene/gui/theme_editor_preview.cpp b/editor/scene/gui/theme_editor_preview.cpp
index d62d9c844587c9961c89ab4fe524b9fba79bb778..c04ea1891df84462d0c958061de39c38f94f30cf 100644
--- a/editor/scene/gui/theme_editor_preview.cpp
+++ b/editor/scene/gui/theme_editor_preview.cpp
@@ -74,28 +74,37 @@ void ScalableContainer::_notification(int p_what) {
 	}
 }
 
-static void _get_ocuppied_area(Node *p_node, Rect2 *r_rect) {
+static void _get_occupied_area(Node *p_node, const Transform2D &p_root_inverse, Rect2 *r_rect) {
 	if (Control *c = Object::cast_to<Control>(p_node)) {
-		r_rect->expand_to(c->get_global_rect().position + c->get_bound_minimum_size());
+		const Transform2D transform = p_root_inverse * c->get_global_transform();
+		*r_rect = r_rect->merge(transform.xform(Rect2(Point2(), c->get_bound_minimum_size())));
+		// Containers already report their intrinsic content minimum. Their children's
+		// positions depend on the assigned size and must not feed back into that minimum.
+		if (Object::cast_to<Container>(c)) {
+			return;
+		}
 	}
 	for (Node *child : p_node->iterate_children<false>()) {
-		_get_ocuppied_area(child, r_rect);
+		_get_occupied_area(child, p_root_inverse, r_rect);
 	}
 }
 
 Size2 ScalableContainer::get_minimum_size() const {
-	// Custom content could have a non Container root.
-	// This custom iteration intends to more reliably calculate the space occupied by the scene.
-	Rect2 rect;
-	rect.position = get_global_rect().position;
+	Size2 size;
 	for (Node *child : iterate_children()) {
-		_get_ocuppied_area(child, &rect);
+		Control *control = as_sortable_control(child, SortableVisibilityMode::VISIBLE);
+		if (!control) {
+			continue;
+		}
+		// Measure free-layout content in its root's local space, excluding the root
+		// position assigned by this container and applying editor scaling only once.
+		Rect2 rect;
+		_get_occupied_area(control, control->get_global_transform().affine_inverse(), &rect);
+		size = size.max(rect.size);
 	}
 
-	Size2 size = rect.size;
-	// Left and Top margin are already considered, add Bottom and Right margins.
-	size.width += get_margin_size(SIDE_RIGHT);
-	size.height += get_margin_size(SIDE_BOTTOM);
+	size.width += get_margin_size(SIDE_LEFT) + get_margin_size(SIDE_RIGHT);
+	size.height += get_margin_size(SIDE_TOP) + get_margin_size(SIDE_BOTTOM);
 
 	return size * EDSCALE;
 }
diff --git a/tests/scene/test_theme_editor_preview.cpp b/tests/scene/test_theme_editor_preview.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..57cd4689f98ce6ecbaa7e7ea4b1d5684546b0ea1
--- /dev/null
+++ b/tests/scene/test_theme_editor_preview.cpp
@@ -0,0 +1,117 @@
