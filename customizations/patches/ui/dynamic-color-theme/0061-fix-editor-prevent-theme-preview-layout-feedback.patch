+#include "tests/test_macros.h"
+
+TEST_FORCE_LINK(test_theme_editor_preview)
+
+#ifdef TOOLS_ENABLED
+
+#include "editor/scene/gui/theme_editor_preview.h"
+#include "editor/themes/editor_scale.h"
+#include "scene/main/scene_tree.h"
+#include "scene/main/window.h"
+
+namespace TestThemeEditorPreview {
+
+class EditorScaleRestore {
+	float previous = EditorScale::get_scale();
+
+public:
+	~EditorScaleRestore() { EditorScale::set_scale(previous); }
+};
+
+static Size2 _with_margins(const ScalableContainer *p_preview, Size2 p_content_size) {
+	p_content_size.x += p_preview->get_margin_size(SIDE_LEFT) + p_preview->get_margin_size(SIDE_RIGHT);
+	p_content_size.y += p_preview->get_margin_size(SIDE_TOP) + p_preview->get_margin_size(SIDE_BOTTOM);
+	return p_content_size * EDSCALE;
+}
+
+TEST_CASE("[SceneTree][Theme] Editor preview excludes managed layout positions from minimum size") {
+	EditorScaleRestore restore;
+	for (float scale : { 1.0f, 1.25f, 2.0f }) {
+		EditorScale::set_scale(scale);
+		ScalableContainer *preview = memnew(ScalableContainer);
+		SceneTree::get_singleton()->get_root()->add_child(preview);
+		preview->set_position(Point2(123, 67));
+		HBoxContainer *content = memnew(HBoxContainer);
+		preview->add_child(content);
+		Control *first = memnew(Control);
+		Control *second = memnew(Control);
+		first->set_custom_minimum_size(Size2(20, 10));
+		second->set_custom_minimum_size(Size2(30, 10));
+		content->add_child(first);
+		content->add_child(second);
+		const Size2 expected = _with_margins(preview, content->get_bound_minimum_size());
+
+		// Both positions can be assigned by a previous, larger layout pass.
+		content->set_position(Point2(40, 20));
+		second->set_position(Point2(1000, 0));
+		CHECK(preview->get_minimum_size().is_equal_approx(expected));
+		second->set_position(Point2(2000, 0));
+		CHECK(preview->get_minimum_size().is_equal_approx(expected));
+
+		memdelete(preview);
+	}
+}
+
+TEST_CASE("[SceneTree][Theme] Editor preview retains free-layout custom content extents") {
+	EditorScaleRestore restore;
+	for (float scale : { 1.0f, 1.25f, 2.0f }) {
+		EditorScale::set_scale(scale);
+		ScalableContainer *preview = memnew(ScalableContainer);
+		SceneTree::get_singleton()->get_root()->add_child(preview);
+		preview->set_position(Point2(123, 67));
+		Control *content = memnew(Control);
+		preview->add_child(content);
+		content->set_position(Point2(40, 20));
+		Control *free_child = memnew(Control);
+		content->add_child(free_child);
+		free_child->set_position(Point2(40, 30));
+		free_child->set_custom_minimum_size(Size2(20, 10));
+		HBoxContainer *nested = memnew(HBoxContainer);
+		content->add_child(nested);
+		nested->set_position(Point2(100, 80));
+		Control *managed_child = memnew(Control);
+		nested->add_child(managed_child);
+		managed_child->set_custom_minimum_size(Size2(50, 10));
+		managed_child->set_position(Point2(2000, 0));
+
+		CHECK(preview->get_minimum_size().is_equal_approx(_with_margins(preview, Size2(150, 90))));
+		free_child->set_position(Point2(200, 120));
+		CHECK(preview->get_minimum_size().is_equal_approx(_with_margins(preview, Size2(220, 130))));
+
+		memdelete(preview);
+	}
+}
+
+} // namespace TestThemeEditorPreview
+
+#endif // TOOLS_ENABLED

