From bb8d63e4f51c983fc97ba2919b53dfdf804a4090 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Wed, 23 Sep 2026 18:03:59 -0700
Subject: [PATCH] fix(theme): isolate editor static colors

Godot-Patch-Topic: ui.dynamic-color-theme
---
 editor/themes/editor_theme_manager.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/editor/themes/editor_theme_manager.cpp b/editor/themes/editor_theme_manager.cpp
index afbe4dca177a7bfd69e71c203283e969e8670c34..6b964703092e2ec714a30b8c1c3e8ccd235d1d15 100644
--- a/editor/themes/editor_theme_manager.cpp
+++ b/editor/themes/editor_theme_manager.cpp
@@ -234,6 +234,22 @@ Ref<EditorTheme> EditorThemeManager::_create_base_theme(const Ref<EditorTheme> &
 	_populate_text_editor_styles(theme, config);
 	_populate_visual_shader_styles(theme, config);
 
+	// The editor has its own explicit colors for controls and must not inherit
+	// dynamic color roles from the global default theme. Those roles are meant
+	// for project UI and can replace an editor color with a palette color that
+	// has insufficient contrast against the editor surface. Mark every color
+	// authored by the editor theme as static so the editor's palette remains
+	// authoritative while dynamic colors continue to work for project themes.
+	List<StringName> color_types;
+	theme->get_color_type_list(&color_types);
+	for (const StringName &type : color_types) {
+		List<StringName> colors;
+		theme->get_color_list(type, &colors);
+		for (const StringName &color : colors) {
+			theme->set_color_role(color, type, ColorRole::STATIC);
+		}
+	}
+
 	OS::get_singleton()->benchmark_end_measure(get_benchmark_key(), "Create Base Theme");
 	return theme;
 }

