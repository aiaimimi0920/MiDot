+namespace material_color_utilities {
+
+struct ViewingConditions {
+  double adapting_luminance = 0.0;
+  double background_lstar = 0.0;
+  double surround = 0.0;
+  bool discounting_illuminant = false;
+  double background_y_to_white_point_y = 0.0;
+  double aw = 0.0;
+  double nbb = 0.0;
+  double ncb = 0.0;
+  double c = 0.0;
