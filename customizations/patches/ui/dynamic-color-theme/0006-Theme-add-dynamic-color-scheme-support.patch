+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="ColorScheme" inherits="Resource" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
+	<brief_description>
+		Generates a semantic color palette from a source color or texture.
+	</brief_description>
+	<description>
+		Generates light or dark semantic colors from [member source_color] or the representative color of [member source_texture]. Colors can be requested by [enum ColorRole] with [method get_color], or through the role-specific getter methods.
+		The generated palette updates immediately when a source, [member dark], or [member contrast_level] changes. [Theme], [Control], [Window], [ColorRect], and dynamic [StyleBox] properties can use this resource to recolor an interface while retaining static fallback colors.
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+		<method name="get_background">
+			<return type="Color" />
+			<description>
+				Returns the [constant @GlobalScope.COLOR_ROLE_BACKGROUND] color.
+			</description>
+		</method>
+		<method name="get_color">
+			<return type="Color" />
+			<param index="0" name="color_role" type="int" enum="ColorRole" />
+			<description>
+				Returns the generated color for [param color_role]. [constant @GlobalScope.COLOR_ROLE_STATIC] and invalid role values return the source color used by the generated scheme.
+			</description>
+		</method>
+		<method name="get_error">
