+void ThemeTypeEditor::_color_role_item_changed(int p_value, String p_item_name) {
+	EditorUndoRedoManager *ur = EditorUndoRedoManager::get_singleton();
+	ur->create_action(TTR("Set Color Role Item in Theme"));
+	ur->add_do_method(*edited_theme, "set_color_role", p_item_name, edited_type, static_cast<int64_t>(p_value));
+	ur->add_undo_method(*edited_theme, "set_color_role", p_item_name, edited_type, static_cast<int64_t>(edited_theme->get_color_role(p_item_name, edited_type)));
+	ur->commit_action();
+}
+
+void ThemeTypeEditor::_color_scheme_item_changed(Ref<ColorScheme> p_value, String p_item_name) {
+	EditorUndoRedoManager *ur = EditorUndoRedoManager::get_singleton();
+	ur->create_action(TTR("Set Color Scheme Item in Theme"));
+	ur->add_do_method(*edited_theme, "set_color_scheme", p_item_name, edited_type, p_value.is_valid() ? p_value : Ref<ColorScheme>());
+	if (edited_theme->has_color_scheme_nocheck(p_item_name, edited_type)) {
+		ur->add_undo_method(*edited_theme, "set_color_scheme", p_item_name, edited_type, edited_theme->get_color_scheme(p_item_name, edited_type));
+	} else {
+		ur->add_undo_method(*edited_theme, "clear_color_scheme", p_item_name, edited_type);
+	}
+	ur->add_do_method(this, CoreStringName(call_deferred), "_update_type_items");
+	ur->add_undo_method(this, CoreStringName(call_deferred), "_update_type_items");
+	ur->commit_action();
