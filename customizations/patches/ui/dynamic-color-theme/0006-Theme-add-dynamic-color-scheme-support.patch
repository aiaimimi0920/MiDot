+
+namespace material_color_utilities {
+
+class TonalPalette {
+ public:
+  explicit TonalPalette(Argb argb);
+  TonalPalette(Hct hct);
+  TonalPalette(double hue, double chroma);
+  TonalPalette(double hue, double chroma, Hct key_color);
