From 81a9a0403e3daaa0ccb1a39f6208c70bae2732c4 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Wed, 23 Sep 2026 16:55:54 -0700
Subject: [PATCH] fix(theme): sync editor color scheme darkness

Keep the fallback ColorScheme aligned with the generated editor theme so semantic ON_SURFACE text remains readable on dark MenuBar and PopupMenu surfaces.

Godot-Patch-Topic: ui.dynamic-color-theme
---
 editor/themes/editor_theme_manager.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/editor/themes/editor_theme_manager.cpp b/editor/themes/editor_theme_manager.cpp
index 2145e5b39b3831892b8ffb57d57fec93d5754ac1..afbe4dca177a7bfd69e71c203283e969e8670c34 100644
--- a/editor/themes/editor_theme_manager.cpp
+++ b/editor/themes/editor_theme_manager.cpp
@@ -44,6 +44,7 @@
 #include "editor/themes/editor_theme.h"
 #include "editor/themes/theme_classic.h"
 #include "editor/themes/theme_modern.h"
+#include "scene/theme/theme_db.h"
 #include "scene/resources/style_box_flat.h"
 #include "scene/resources/style_box_line.h"
 #include "scene/resources/style_box_texture.h"
@@ -429,6 +430,15 @@ EditorThemeManager::ThemeConfiguration EditorThemeManager::_create_theme_config(
 	config.dark_theme = is_dark_theme();
 	config.dark_icon_and_font = is_dark_icon_and_font();
 
+	// The fallback ColorScheme is shared by the default theme and the editor
+	// theme. Keep its Material light/dark variant in sync with the editor
+	// theme; otherwise ON_SURFACE resolves to dark text while the editor uses
+	// its dark surface colors (notably in MenuBar and PopupMenu).
+	Ref<ColorScheme> fallback_color_scheme = ThemeDB::get_singleton()->get_fallback_color_scheme();
+	if (fallback_color_scheme.is_valid()) {
+		fallback_color_scheme->set_dark(config.dark_theme);
+	}
+
 	config.base_margin = config.base_spacing;
 	config.increased_margin = config.base_spacing + config.extra_spacing * 0.75;
 	config.separation_margin = (config.base_spacing + config.extra_spacing / 2) * EDSCALE;

