From 95563bfd3385515f035dce47ed806af3acfce3ff Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Thu, 22 Oct 2026 23:44:13 +0800
Subject: [PATCH] test(theme): cover sound and personal theme type coexistence

Keep established ColorRole, ColorScheme and String enum values stable, and exercise generic item and Control/Window override routes alongside upstream sound items.

Godot-Patch-Topic: ui.theme-string-items
---
 tests/scene/test_theme.cpp | 62 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/tests/scene/test_theme.cpp b/tests/scene/test_theme.cpp
index 05f2d917d9be3110749552757f15a3b7298b1d72..467a44b011cafff7d4412bdc90afd84ece0bbebd 100644
--- a/tests/scene/test_theme.cpp
+++ b/tests/scene/test_theme.cpp
@@ -32,6 +32,8 @@
 
 TEST_FORCE_LINK(test_theme)
 
+#include "scene/gui/control.h"
+#include "scene/main/window.h"
 #include "scene/resources/image_texture.h"
 #include "scene/resources/style_box_flat.h"
 #include "scene/resources/style_box_line.h"
@@ -222,6 +224,66 @@ TEST_CASE("[Theme] String theme items") {
 	CHECK_FALSE(copy->has_string("caption", "Button"));
 }
 
+TEST_CASE("[Theme] Sound and personal theme item types coexist") {
+	CHECK(Theme::DATA_TYPE_COLOR_ROLE == 6);
+	CHECK(Theme::DATA_TYPE_COLOR_SCHEME == 7);
+	CHECK(Theme::DATA_TYPE_STRING == 8);
+	CHECK(Theme::DATA_TYPE_SOUND == 9);
+	CHECK(Theme::DATA_TYPE_MAX == 10);
+
+	Ref<Theme> theme = memnew(Theme);
+	Ref<AudioStream> sound = memnew(AudioStream);
+	Ref<ColorScheme> scheme = memnew(ColorScheme);
+	theme->set_theme_item(Theme::DATA_TYPE_SOUND, "shared", "Button", sound);
+	theme->set_theme_item(Theme::DATA_TYPE_STRING, "shared", "Button", String("caption"));
+	theme->set_theme_item(Theme::DATA_TYPE_COLOR_ROLE, "shared", "Button", int64_t(ColorRole::PRIMARY));
+	theme->set_theme_item(Theme::DATA_TYPE_COLOR_SCHEME, "shared", "Button", scheme);
+
+	Ref<Theme> copy = memnew(Theme);
+	copy->merge_with(theme);
+	CHECK(Ref<AudioStream>(copy->get_theme_item(Theme::DATA_TYPE_SOUND, "shared", "Button")) == sound);
+	CHECK(copy->get_theme_item(Theme::DATA_TYPE_STRING, "shared", "Button") == Variant("caption"));
+	CHECK(int64_t(copy->get_theme_item(Theme::DATA_TYPE_COLOR_ROLE, "shared", "Button")) == int64_t(ColorRole::PRIMARY));
+	CHECK(Ref<ColorScheme>(copy->get_theme_item(Theme::DATA_TYPE_COLOR_SCHEME, "shared", "Button")) == scheme);
+	CHECK(Ref<AudioStream>(copy->get("Button/sounds/shared")) == sound);
+	CHECK(copy->get("Button/strings/shared") == Variant("caption"));
+
+	copy->clear_theme_item(Theme::DATA_TYPE_SOUND, "shared", "Button");
+	CHECK_FALSE(copy->has_sound("shared", "Button"));
+	CHECK(copy->has_string("shared", "Button"));
+	CHECK(copy->has_color_role("shared", "Button"));
+	CHECK(copy->has_color_scheme("shared", "Button"));
+}
+
+TEST_CASE("[SceneTree][Theme] Control and Window preserve sound and personal override routes") {
+	Ref<AudioStream> sound = memnew(AudioStream);
+	Ref<ColorScheme> scheme = memnew(ColorScheme);
+	Node *nodes[] = { memnew(Control), memnew(Window) };
+	for (Node *node : nodes) {
+		bool valid = false;
+		node->set("theme_override_sounds/shared", sound, &valid);
+		CHECK(valid);
+		node->set("theme_override_strings/shared", String("caption"), &valid);
+		CHECK(valid);
+		node->set("theme_override_color_roles/shared", int64_t(ColorRole::PRIMARY), &valid);
+		CHECK(valid);
+		node->set("theme_override_color_schemes/shared", scheme, &valid);
+		CHECK(valid);
+		CHECK(Ref<AudioStream>(node->get("theme_override_sounds/shared")) == sound);
+		CHECK(node->get("theme_override_strings/shared") == Variant("caption"));
+		CHECK(int64_t(node->get("theme_override_color_roles/shared")) == int64_t(ColorRole::PRIMARY));
+		CHECK(Ref<ColorScheme>(node->get("theme_override_color_schemes/shared")) == scheme);
+
+		node->set("theme_override_sounds/shared", Variant());
+		CHECK(node->get("theme_override_sounds/shared").get_type() == Variant::NIL);
+		CHECK(node->get("theme_override_strings/shared") == Variant("caption"));
+		node->set("theme_override_strings/shared", Variant());
+		CHECK(node->get("theme_override_strings/shared").get_type() == Variant::NIL);
+		CHECK(Ref<ColorScheme>(node->get("theme_override_color_schemes/shared")) == scheme);
+		memdelete(node);
+	}
+}
+
 TEST_CASE("[Theme] StyleBox dynamic colors") {
 	Ref<ColorScheme> default_scheme = memnew(ColorScheme(Color("#6750a4")));
 	Ref<ColorScheme> explicit_scheme = memnew(ColorScheme(Color("#006495")));

