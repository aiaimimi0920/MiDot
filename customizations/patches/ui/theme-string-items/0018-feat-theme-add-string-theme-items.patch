+// Strings.
+void Theme::set_string(const StringName &p_name, const StringName &p_theme_type, const String &p_string) {
+	ERR_FAIL_COND_MSG(!is_valid_item_name(p_name), vformat("Invalid item name: '%s'", p_name));
+	ERR_FAIL_COND_MSG(!is_valid_type_name(p_theme_type), vformat("Invalid type name: '%s'", p_theme_type));
+
+	const bool existing = has_string_nocheck(p_name, p_theme_type);
+	string_map[p_theme_type][p_name] = p_string;
+
+	_emit_theme_changed(!existing);
+}
+
+String Theme::get_string(const StringName &p_name, const StringName &p_theme_type) const {
+	if (string_map.has(p_theme_type) && string_map[p_theme_type].has(p_name)) {
+		return string_map[p_theme_type][p_name];
+	}
+	return String();
+}
+
+bool Theme::has_string(const StringName &p_name, const StringName &p_theme_type) const {
+	return string_map.has(p_theme_type) && string_map[p_theme_type].has(p_name);
+}
+
+bool Theme::has_string_nocheck(const StringName &p_name, const StringName &p_theme_type) const {
+	return string_map.has(p_theme_type) && string_map[p_theme_type].has(p_name);
+}
+
+void Theme::rename_string(const StringName &p_old_name, const StringName &p_name, const StringName &p_theme_type) {
+	ERR_FAIL_COND_MSG(!is_valid_item_name(p_name), vformat("Invalid item name: '%s'", p_name));
+	ERR_FAIL_COND_MSG(!is_valid_type_name(p_theme_type), vformat("Invalid type name: '%s'", p_theme_type));
+	ERR_FAIL_COND_MSG(!string_map.has(p_theme_type), "Cannot rename the string '" + String(p_old_name) + "' because the node type '" + String(p_theme_type) + "' does not exist.");
+	ERR_FAIL_COND_MSG(string_map[p_theme_type].has(p_name), "Cannot rename the string '" + String(p_old_name) + "' because the new name '" + String(p_name) + "' already exists.");
+	ERR_FAIL_COND_MSG(!string_map[p_theme_type].has(p_old_name), "Cannot rename the string '" + String(p_old_name) + "' because it does not exist.");
+
+	string_map[p_theme_type][p_name] = string_map[p_theme_type][p_old_name];
+	string_map[p_theme_type].erase(p_old_name);
+
+	_emit_theme_changed(true);
+}
+
+void Theme::clear_string(const StringName &p_name, const StringName &p_theme_type) {
+	ERR_FAIL_COND_MSG(!string_map.has(p_theme_type), "Cannot clear the string '" + String(p_name) + "' because the node type '" + String(p_theme_type) + "' does not exist.");
+	ERR_FAIL_COND_MSG(!string_map[p_theme_type].has(p_name), "Cannot clear the string '" + String(p_name) + "' because it does not exist.");
+
+	string_map[p_theme_type].erase(p_name);
+
+	_emit_theme_changed(true);
+}
+
+void Theme::get_string_list(const StringName &p_theme_type, List<StringName> *p_list) const {
+	ERR_FAIL_NULL(p_list);
+	if (!string_map.has(p_theme_type)) {
+		return;
+	}
+	for (const KeyValue<StringName, String> &E : string_map[p_theme_type]) {
+		p_list->push_back(E.key);
+	}
+}
+
+void Theme::add_string_type(const StringName &p_theme_type) {
+	ERR_FAIL_COND_MSG(!is_valid_type_name(p_theme_type), vformat("Invalid type name: '%s'", p_theme_type));
+	if (!string_map.has(p_theme_type)) {
+		string_map[p_theme_type] = ThemeStringMap();
+	}
+}
+
+void Theme::remove_string_type(const StringName &p_theme_type) {
+	string_map.erase(p_theme_type);
+}
+
+void Theme::rename_string_type(const StringName &p_old_theme_type, const StringName &p_theme_type) {
+	ERR_FAIL_COND_MSG(!is_valid_type_name(p_theme_type), vformat("Invalid type name: '%s'", p_theme_type));
+	if (!string_map.has(p_old_theme_type) || string_map.has(p_theme_type)) {
+		return;
+	}
+	string_map[p_theme_type] = string_map[p_old_theme_type];
+	string_map.erase(p_old_theme_type);
+}
+
+void Theme::get_string_type_list(List<StringName> *p_list) const {
+	ERR_FAIL_NULL(p_list);
+	for (const KeyValue<StringName, ThemeStringMap> &E : string_map) {
+		p_list->push_back(E.key);
+	}
+}
