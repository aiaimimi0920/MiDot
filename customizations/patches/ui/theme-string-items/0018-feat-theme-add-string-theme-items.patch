+		return data.theme_string_cache[p_theme_type][p_name];
+	}
+
+	Vector<StringName> theme_types;
+	data.theme_owner->get_theme_type_dependencies(this, p_theme_type, theme_types);
+	String value = data.theme_owner->get_theme_item_in_types(Theme::DATA_TYPE_STRING, p_name, theme_types);
+	data.theme_string_cache[p_theme_type][p_name] = value;
+	return value;
