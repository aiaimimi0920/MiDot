+void Button::set_text_icon(const String &p_text_icon) {
+	const String resolved = p_text_icon.is_empty() ? theme_cache.text_icon : p_text_icon;
+	const String translated = _get_translated_text(resolved);
+	if (text_icon == p_text_icon && xl_text_icon == translated) {
+		return;
+	}
+
+	text_icon = p_text_icon;
+	xl_text_icon = translated;
+	_shape_text_icon();
+	queue_redraw();
+	update_minimum_size();
+}
+
+String Button::get_text_icon() const {
+	return text_icon;
+}
