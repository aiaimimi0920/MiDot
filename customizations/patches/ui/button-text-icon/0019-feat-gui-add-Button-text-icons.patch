@@ -143,6 +146,12 @@
 		<theme_item name="font_size" data_type="font_size" type="int">
 			Font size of the [Button]'s text.
 		</theme_item>
+		<theme_item name="text_icon_font" data_type="font" type="Font">
+			[Font] used to draw the text glyph icon.
+		</theme_item>
+		<theme_item name="text_icon_font_size" data_type="font_size" type="int">
+			Font size used to draw the text glyph icon.
