From fd3d3181aada4b3250148ccae5b45af2eb317bae Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Sun, 30 Aug 2026 23:49:09 +0800
Subject: [PATCH] feat(gui): add TextureButton state text

Retain per-state icon-font fallbacks while using current theme colors, localization, and sizing behavior.

Godot-Patch-Topic: ui.texture-button-state-text
---
 doc/classes/TextureButton.xml       |  47 +++++-
 scene/gui/texture_button.cpp        | 222 +++++++++++++++++++++++++++-
 scene/gui/texture_button.h          |  38 +++++
 scene/theme/default_theme.cpp       |  10 ++
 tests/scene/test_texture_button.cpp |  53 +++++++
 5 files changed, 363 insertions(+), 7 deletions(-)

diff --git a/doc/classes/TextureButton.xml b/doc/classes/TextureButton.xml
index 39cbacb98a7bfac7c66fc1f4c9943fb6d18e3921..c66cdda2c362068490d6e72895c774cd45bc5f66 100644
--- a/doc/classes/TextureButton.xml
+++ b/doc/classes/TextureButton.xml
@@ -4,9 +4,9 @@
 		Texture-based button. Supports Pressed, Hover, Disabled and Focused states.
 	</brief_description>
 	<description>
-		[TextureButton] has the same functionality as [Button], except it uses sprites instead of Godot's [Theme] resource. It is faster to create, but it doesn't support localization like more complex [Control]s.
+		[TextureButton] has the same functionality as [Button], except it primarily uses sprites instead of Godot's [Theme] resource. It can also use localized text or icon-font glyphs as state visuals when the corresponding texture is unavailable.
 		See also [BaseButton] which contains common properties and methods associated with this node.
-		[b]Note:[/b] Setting a texture for the "normal" state ([member texture_normal]) is recommended. If [member texture_normal] is not set, the [TextureButton] will still receive input events and be clickable, but the user will not be able to see it unless they activate another one of its states with a texture assigned (e.g., hover over it to show [member texture_hover]).
+		[b]Note:[/b] Setting a texture or state text for the normal state ([member texture_normal] or [member text_normal]) is recommended. Without either, the [TextureButton] remains clickable but may not be visible until another configured state is activated.
 	</description>
 	<tutorials>
 		<link title="3D Voxel Demo">https://godotengine.org/asset-library/asset/2755</link>
@@ -28,11 +28,26 @@
 			If [code]true[/code], texture is flipped vertically.
 		</member>
 		<member name="ignore_texture_size" type="bool" setter="set_ignore_texture_size" getter="get_ignore_texture_size" default="false">
-			If [code]true[/code], the size of the texture won't be considered for minimum size calculation, so the [TextureButton] can be shrunk down past the texture size.
+			If [code]true[/code], texture and state text sizes aren't considered for minimum size calculation, so the [TextureButton] can be shrunk below its visual size.
 		</member>
 		<member name="stretch_mode" type="int" setter="set_stretch_mode" getter="get_stretch_mode" enum="TextureButton.StretchMode" default="2">
 			Controls the texture's behavior when you resize the node's bounding rectangle. See the [enum StretchMode] constants for available options.
 		</member>
+		<member name="text_disabled" type="String" setter="set_text_disabled" getter="get_text_disabled" default="&quot;&quot;">
+			Text or icon-font glyph displayed when the button is disabled and [member texture_disabled] is unavailable. If empty, [member text_normal] is used.
+		</member>
+		<member name="text_focused" type="String" setter="set_text_focused" getter="get_text_focused" default="&quot;&quot;">
+			Text or icon-font glyph overlaid when the button has focus. It can also serve as the only visual when no state texture or state text is available.
+		</member>
+		<member name="text_hover" type="String" setter="set_text_hover" getter="get_text_hover" default="&quot;&quot;">
+			Text or icon-font glyph displayed while hovering when [member texture_hover] is unavailable. If empty, the pressed or normal state text is used as appropriate.
+		</member>
+		<member name="text_normal" type="String" setter="set_text_normal" getter="get_text_normal" default="&quot;&quot;">
+			Default text or icon-font glyph displayed when no state texture is available.
+		</member>
+		<member name="text_pressed" type="String" setter="set_text_pressed" getter="get_text_pressed" default="&quot;&quot;">
+			Text or icon-font glyph displayed while pressed when [member texture_pressed] is unavailable. If empty, [member text_hover] or [member text_normal] is used.
+		</member>
 		<member name="texture_click_mask" type="BitMap" setter="set_click_mask" getter="get_click_mask">
 			Pure black and white [BitMap] image to use for click detection. On the mask, white pixels represent the button's clickable area. Use it to create buttons with curved shapes.
 		</member>
@@ -52,6 +67,32 @@
 			Texture to display on mouse down over the node, if the node has keyboard focus and the player presses the Enter key or if the player presses the [member BaseButton.shortcut] key. If not assigned, the [TextureButton] displays [member texture_hover] instead when pressed.
 		</member>
 	</members>
+	<theme_items>
