 			} else {
 				_position_rect = Rect2();
 			}
 
 			if (draw_focus) {
-				draw_texture_rect(focused, Rect2(ofs, size), false);
+				if (focused.is_valid()) {
+					const Rect2 focus_rect = texdraw.is_valid() ? Rect2(ofs, size) : _position_rect;
+					draw_texture_rect(focused, focus_rect, false);
