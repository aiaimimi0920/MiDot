+		</theme_item>
+		<theme_item name="text_hover_color" data_type="color" type="Color" default="Color(0.95, 0.95, 0.95, 1)">
+			State text color used while hovering.
+		</theme_item>
+		<theme_item name="text_normal_color" data_type="color" type="Color" default="Color(0.875, 0.875, 0.875, 1)">
+			Default state text color.
+		</theme_item>
+		<theme_item name="text_pressed_color" data_type="color" type="Color" default="Color(1, 1, 1, 1)">
+			State text color used while pressed.
+		</theme_item>
+		<theme_item name="text_icon_font" data_type="font" type="Font">
+			Font used for state text and icon-font glyphs.
+		</theme_item>
+		<theme_item name="text_icon_font_size" data_type="font_size" type="int">
+			Font size used for state text and icon-font glyphs.
+		</theme_item>
+	</theme_items>
 	<constants>
 		<constant name="STRETCH_SCALE" value="0" enum="StretchMode">
 			Scale to fit the node's bounding rectangle.
