From 6a22295cc77c619d44f8e248c4dbe5708b3773ab Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Sun, 30 Aug 2026 23:14:33 +0800
Subject: [PATCH] feat(theme): add Material elevation shadows

Preserve the six-level, three-layer shadow model without restoring the legacy Material UI framework.

Godot-Patch-Topic: ui.stylebox-elevation
---
 doc/classes/StyleBoxFlat.xml        | 12 +++-
 scene/resources/style_box_flat.cpp  | 97 ++++++++++++++++++++++++++++-
 scene/resources/style_box_flat.h    | 19 ++++++
 tests/scene/test_style_box_flat.cpp | 59 ++++++++++++++++++
 4 files changed, 181 insertions(+), 6 deletions(-)
 create mode 100644 tests/scene/test_style_box_flat.cpp

diff --git a/doc/classes/StyleBoxFlat.xml b/doc/classes/StyleBoxFlat.xml
index b5e3c0500c89396bfe6b48ddbf740e72b87fd640..36437a40ae6537697cf2bd31638427fdc651a614 100644
--- a/doc/classes/StyleBoxFlat.xml
+++ b/doc/classes/StyleBoxFlat.xml
@@ -152,9 +152,15 @@
 		<member name="corner_radius_top_right" type="int" setter="set_corner_radius" getter="get_corner_radius" default="0">
 			The top-right corner's radius. If [code]0[/code], the corner is not rounded.
 		</member>
-		<member name="draw_center" type="bool" setter="set_draw_center" getter="is_draw_center_enabled" default="true">
-			Toggles drawing of the inner part of the stylebox.
-		</member>
+			<member name="draw_center" type="bool" setter="set_draw_center" getter="is_draw_center_enabled" default="true">
+				Toggles drawing of the inner part of the stylebox.
+			</member>
+			<member name="dynamic_shadow" type="bool" setter="set_dynamic_shadow" getter="is_dynamic_shadow_enabled" default="false">
+				If [code]true[/code], draws a three-layer Material-style shadow selected by [member elevation_level]. The regular [member shadow_size] and [member shadow_offset] are ignored while this is enabled.
+			</member>
+			<member name="elevation_level" type="int" setter="set_elevation_level" getter="get_elevation_level" enum="StyleBoxFlat.ElevationLevel" default="0">
+				The Material elevation preset used by [member dynamic_shadow]. Higher levels draw larger umbra, penumbra, and ambient shadow layers.
+			</member>
 		<member name="expand_margin_bottom" type="float" setter="set_expand_margin" getter="get_expand_margin" default="0.0">
 			Expands the stylebox outside of the control rect on the bottom edge. Useful in combination with [member border_width_bottom] to draw a border outside the control rect.
 			[b]Note:[/b] Unlike [member StyleBox.content_margin_bottom], [member expand_margin_bottom] does [i]not[/i] affect the size of the clickable area for [Control]s. This can negatively impact usability if used wrong, as the user may try to click an area of the StyleBox that cannot actually receive clicks.
diff --git a/scene/resources/style_box_flat.cpp b/scene/resources/style_box_flat.cpp
index 613977623a64dc1aa0b02f3a1bb5c425e1fc530f..6f9f127b6076b43f7c148c1abf06830705e6bb5f 100644
--- a/scene/resources/style_box_flat.cpp
+++ b/scene/resources/style_box_flat.cpp
@@ -37,6 +37,25 @@
 
 #include <cfloat> // FLT_EPSILON
 
+namespace {
+
+struct ElevationShadowLayer {
+	Point2 offset;
+	int size;
+	float alpha;
+};
+
+constexpr ElevationShadowLayer ELEVATION_SHADOWS[6][3] = {
+	{ { Point2(0, 0), 0, 0.20f }, { Point2(0, 0), 0, 0.14f }, { Point2(0, 0), 0, 0.12f } },
+	{ { Point2(0, 2), 1, 0.20f }, { Point2(0, 1), 1, 0.14f }, { Point2(0, 1), 3, 0.12f } },
+	{ { Point2(0, 3), 3, 0.20f }, { Point2(0, 3), 4, 0.14f }, { Point2(0, 1), 8, 0.12f } },
+	{ { Point2(0, 3), 5, 0.20f }, { Point2(0, 6), 10, 0.14f }, { Point2(0, 1), 18, 0.12f } },
+	{ { Point2(0, 5), 5, 0.20f }, { Point2(0, 8), 10, 0.14f }, { Point2(0, 3), 14, 0.12f } },
+	{ { Point2(0, 7), 8, 0.20f }, { Point2(0, 12), 17, 0.14f }, { Point2(0, 5), 22, 0.12f } },
+};
+
+} // namespace
+
 float StyleBoxFlat::get_style_margin(Side p_side) const {
 	ERR_FAIL_INDEX_V((int)p_side, 4, 0.0);
 	return border_width[p_side];
@@ -300,6 +319,31 @@ Point2 StyleBoxFlat::get_shadow_offset() const {
 	return shadow_offset;
 }
 
+void StyleBoxFlat::set_dynamic_shadow(bool p_enabled) {
+	if (dynamic_shadow == p_enabled) {
+		return;
+	}
+	dynamic_shadow = p_enabled;
+	custom_emit_changed();
+}
+
+bool StyleBoxFlat::is_dynamic_shadow_enabled() const {
+	return dynamic_shadow;
+}
+
+void StyleBoxFlat::set_elevation_level(ElevationLevel p_elevation_level) {
+	ERR_FAIL_INDEX(static_cast<int>(p_elevation_level), 6);
+	if (elevation_level == p_elevation_level) {
+		return;
+	}
+	elevation_level = p_elevation_level;
+	custom_emit_changed();
+}
+
+StyleBoxFlat::ElevationLevel StyleBoxFlat::get_elevation_level() const {
+	return elevation_level;
+}
+
 void StyleBoxFlat::set_anti_aliased(const bool &p_anti_aliased) {
 	anti_aliased = p_anti_aliased;
 	custom_emit_changed();
@@ -538,7 +582,17 @@ inline void adapt_values(int p_index_a, int p_index_b, real_t *adapted_values, c
 Rect2 StyleBoxFlat::get_draw_rect(const Rect2 &p_rect) const {
 	Rect2 draw_rect = p_rect.grow_individual(expand_margin[SIDE_LEFT], expand_margin[SIDE_TOP], expand_margin[SIDE_RIGHT], expand_margin[SIDE_BOTTOM]);
 
-	if (shadow_size > 0) {
+	if (dynamic_shadow) {
+		const Rect2 style_rect = draw_rect;
+		for (const ElevationShadowLayer &layer : ELEVATION_SHADOWS[elevation_level]) {
+			if (layer.size <= 0) {
+				continue;
+			}
+			Rect2 shadow_rect = style_rect.grow(layer.size);
+			shadow_rect.position += layer.offset;
+			draw_rect = draw_rect.merge(shadow_rect);
+		}
+	} else if (shadow_size > 0) {
 		Rect2 shadow_rect = draw_rect.grow(shadow_size);
 		shadow_rect.position += shadow_offset;
 		draw_rect = draw_rect.merge(shadow_rect);
@@ -549,8 +603,9 @@ Rect2 StyleBoxFlat::get_draw_rect(const Rect2 &p_rect) const {
 
 void StyleBoxFlat::draw(RID p_canvas_item, const Rect2 &p_rect) const {
 	bool draw_border = (border_width[0] > 0) || (border_width[1] > 0) || (border_width[2] > 0) || (border_width[3] > 0);
-	bool draw_shadow = (shadow_size > 0);
-	if (!draw_border && !draw_center && !draw_shadow) {
+	bool draw_shadow = !dynamic_shadow && shadow_size > 0;
+	bool draw_dynamic_shadow = dynamic_shadow && elevation_level != ELEVATION_LEVEL_0;
+	if (!draw_border && !draw_center && !draw_shadow && !draw_dynamic_shadow) {
 		return;
 	}
 
@@ -635,6 +690,29 @@ void StyleBoxFlat::draw(RID p_canvas_item, const Rect2 &p_rect) const {
 		}
 	}
 
+	if (draw_dynamic_shadow) {
+		for (const ElevationShadowLayer &layer : ELEVATION_SHADOWS[elevation_level]) {
+			if (layer.size <= 0) {
+				continue;
+			}
+
+			Rect2 shadow_inner_rect = style_rect;
+			shadow_inner_rect.position += layer.offset;
+			Rect2 shadow_rect = style_rect.grow(layer.size);
+			shadow_rect.position += layer.offset;
+
+			const Color layer_color(resolved_shadow_color, layer.alpha);
+			const Color transparent_color(layer_color.r, layer_color.g, layer_color.b, 0);
+			draw_rounded_rectangle(verts, indices, colors, shadow_inner_rect, adapted_corner,
+					shadow_rect, shadow_inner_rect, layer_color, transparent_color, corner_detail, skew);
+
+			if (draw_center) {
+				draw_rounded_rectangle(verts, indices, colors, shadow_inner_rect, adapted_corner,
+						shadow_inner_rect, shadow_inner_rect, layer_color, layer_color, corner_detail, skew, true);
+			}
+		}
+	}
+
 	// Create border (no AA).
 	if (draw_border && !aa_on) {
 		draw_rounded_rectangle(verts, indices, colors, border_style_rect, adapted_corner,
@@ -789,6 +867,10 @@ void StyleBoxFlat::_bind_methods() {
 
 	ClassDB::bind_method(D_METHOD("set_shadow_offset", "offset"), &StyleBoxFlat::set_shadow_offset);
 	ClassDB::bind_method(D_METHOD("get_shadow_offset"), &StyleBoxFlat::get_shadow_offset);
+	ClassDB::bind_method(D_METHOD("set_dynamic_shadow", "enabled"), &StyleBoxFlat::set_dynamic_shadow);
+	ClassDB::bind_method(D_METHOD("is_dynamic_shadow_enabled"), &StyleBoxFlat::is_dynamic_shadow_enabled);
+	ClassDB::bind_method(D_METHOD("set_elevation_level", "elevation_level"), &StyleBoxFlat::set_elevation_level);
+	ClassDB::bind_method(D_METHOD("get_elevation_level"), &StyleBoxFlat::get_elevation_level);
 
 	ClassDB::bind_method(D_METHOD("set_anti_aliased", "anti_aliased"), &StyleBoxFlat::set_anti_aliased);
 	ClassDB::bind_method(D_METHOD("is_anti_aliased"), &StyleBoxFlat::is_anti_aliased);
@@ -839,6 +921,15 @@ void StyleBoxFlat::_bind_methods() {
 	ADD_PROPERTY(PropertyInfo(Variant::COLOR, "shadow_color_scale"), "set_shadow_color_scale", "get_shadow_color_scale");
 	ADD_PROPERTY(PropertyInfo(Variant::INT, "shadow_size", PROPERTY_HINT_RANGE, "0,100,1,or_greater,suffix:px"), "set_shadow_size", "get_shadow_size");
 	ADD_PROPERTY(PropertyInfo(Variant::VECTOR2, "shadow_offset", PROPERTY_HINT_NONE, "suffix:px"), "set_shadow_offset", "get_shadow_offset");
+	ADD_PROPERTY(PropertyInfo(Variant::BOOL, "dynamic_shadow"), "set_dynamic_shadow", "is_dynamic_shadow_enabled");
+	ADD_PROPERTY(PropertyInfo(Variant::INT, "elevation_level", PROPERTY_HINT_ENUM, "Level 0,Level 1,Level 2,Level 3,Level 4,Level 5"), "set_elevation_level", "get_elevation_level");
+
+	BIND_ENUM_CONSTANT(ELEVATION_LEVEL_0);
+	BIND_ENUM_CONSTANT(ELEVATION_LEVEL_1);
+	BIND_ENUM_CONSTANT(ELEVATION_LEVEL_2);
+	BIND_ENUM_CONSTANT(ELEVATION_LEVEL_3);
+	BIND_ENUM_CONSTANT(ELEVATION_LEVEL_4);
+	BIND_ENUM_CONSTANT(ELEVATION_LEVEL_5);
 
 	ADD_GROUP("Anti Aliasing", "anti_aliasing_");
 	ADD_PROPERTY(PropertyInfo(Variant::BOOL, "anti_aliasing"), "set_anti_aliased", "is_anti_aliased");
diff --git a/scene/resources/style_box_flat.h b/scene/resources/style_box_flat.h
index c80657b87b7d873699a7a16ad5d1f23a2d8243eb..b41fa98d73054e6417440ad45c18580d3730711d 100644
--- a/scene/resources/style_box_flat.h
+++ b/scene/resources/style_box_flat.h
@@ -35,6 +35,17 @@
 class StyleBoxFlat : public StyleBox {
 	GDCLASS(StyleBoxFlat, StyleBox);
 
+public:
+	enum ElevationLevel {
+		ELEVATION_LEVEL_0,
+		ELEVATION_LEVEL_1,
+		ELEVATION_LEVEL_2,
+		ELEVATION_LEVEL_3,
+		ELEVATION_LEVEL_4,
+		ELEVATION_LEVEL_5,
+	};
+
+private:
 	Color bg_color = Color(0.6, 0.6, 0.6);
 	Color shadow_color = Color(0, 0, 0, 0.6);
 	Color border_color = Color(0.8, 0.8, 0.8);
@@ -60,6 +71,8 @@ class StyleBoxFlat : public StyleBox {
 	int corner_detail = 8;
 	int shadow_size = 0;
 	Point2 shadow_offset;
+	bool dynamic_shadow = false;
+	ElevationLevel elevation_level = ELEVATION_LEVEL_0;
 	real_t aa_size = 1;
 
 protected:
@@ -126,6 +139,10 @@ public:
 
 	void set_shadow_offset(const Point2 &p_offset);
 	Point2 get_shadow_offset() const;
+	void set_dynamic_shadow(bool p_enabled);
+	bool is_dynamic_shadow_enabled() const;
+	void set_elevation_level(ElevationLevel p_elevation_level);
+	ElevationLevel get_elevation_level() const;
 
 	void set_anti_aliased(const bool &p_anti_aliased);
 	bool is_anti_aliased() const;
@@ -135,3 +152,5 @@ public:
 	virtual Rect2 get_draw_rect(const Rect2 &p_rect) const override;
 	virtual void draw(RID p_canvas_item, const Rect2 &p_rect) const override;
 };
+
+VARIANT_ENUM_CAST(StyleBoxFlat::ElevationLevel);
