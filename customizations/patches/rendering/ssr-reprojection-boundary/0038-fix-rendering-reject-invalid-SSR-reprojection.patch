From 82139fbd3ff552e350b0693a3fb1d199bb1de76f Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Wed, 9 Sep 2026 23:21:04 +0800
Subject: [PATCH] fix(rendering): reject invalid SSR reprojection

Godot-Patch-Topic: rendering.ssr-reprojection-boundary
---
 .../renderer_rd/shaders/effects/screen_space_reflection.glsl | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/servers/rendering/renderer_rd/shaders/effects/screen_space_reflection.glsl b/servers/rendering/renderer_rd/shaders/effects/screen_space_reflection.glsl
index 70971828e3016413d7a46fa16ea41b6088bdc04b..0437f100c65bc53e0b731a4f4bc08312bc89cb74 100644
--- a/servers/rendering/renderer_rd/shaders/effects/screen_space_reflection.glsl
+++ b/servers/rendering/renderer_rd/shaders/effects/screen_space_reflection.glsl
@@ -226,7 +226,8 @@ void main() {
 		reprojected_pos.z = cur_screen_pos.z;
 		reprojected_pos.w = 1.0;
 		reprojected_pos = scene_data.reprojection[params.view_index] * reprojected_pos;
-		reprojected_pos.xy = reprojected_pos.xy / reprojected_pos.w * 0.5 + 0.5;
+		// Reject points behind the previous camera without dividing by zero.
+		reprojected_pos.xy = reprojected_pos.w > 0.0 ? reprojected_pos.xy / reprojected_pos.w * 0.5 + 0.5 : vec2(-1.0);
 
 		// Instead of hard rejecting samples, write sample validity to the alpha channel.
 		// This allows invalid samples to write mip levels to let valid samples have smoother roughness transitions.
@@ -264,6 +265,8 @@ void main() {
 			// Blend fading out towards inner margin.
 			// 0.5 = midpoint of reflection
 			vec2 margin_grad = mix(params.screen_size - reprojected_pixel_pos, reprojected_pixel_pos, lessThan(reprojected_pixel_pos, params.screen_size * 0.5));
+			// Two negative margins must not turn an out-of-image corner into a valid sample.
+			margin_grad = max(margin_grad, vec2(0.0));
 			margin_blend = smoothstep(0.0, margin.x * margin.y, margin_grad.x * margin_grad.y);
 		}
 

