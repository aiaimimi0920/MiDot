From 2bf45c9e3efd909e3a28cf23a3fdc05e4ef6da79 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Mon, 7 Sep 2026 21:53:22 +0800
Subject: [PATCH] feat(rendering): expose unjittered projection

Preserve exact camera identity and stable depth mapping under TAA.

Godot-Patch-Topic: rendering.unjittered-projection
---
 .../scene_shader_forward_clustered.cpp             |  1 +
 .../scene_forward_clustered_inc.glsl               |  6 ++++++
 .../renderer_rd/shaders/scene_data_inc.glsl        |  2 ++
 .../storage_rd/render_scene_data_rd.cpp            | 14 ++++++++++++++
 .../renderer_rd/storage_rd/render_scene_data_rd.h  |  2 ++
 servers/rendering/shader_preprocessor.cpp          |  1 +
 servers/rendering/shader_types.cpp                 |  2 ++
 7 files changed, 28 insertions(+)

diff --git a/servers/rendering/renderer_rd/forward_clustered/scene_shader_forward_clustered.cpp b/servers/rendering/renderer_rd/forward_clustered/scene_shader_forward_clustered.cpp
index a158113733821c0dd96ab00a64b95d8563b1ecc5..0c563dd87bc4e3cc3f8a98ef41ba662ca7242b7e 100644
--- a/servers/rendering/renderer_rd/forward_clustered/scene_shader_forward_clustered.cpp
+++ b/servers/rendering/renderer_rd/forward_clustered/scene_shader_forward_clustered.cpp
@@ -712,6 +712,7 @@ void SceneShaderForwardClustered::init(const String p_defines) {
 		actions.renames["VIEW_MATRIX"] = "read_view_matrix";
 		actions.renames["INV_VIEW_MATRIX"] = "inv_view_matrix";
 		actions.renames["PROJECTION_MATRIX"] = "projection_matrix";
+		actions.renames["UNJITTERED_PROJECTION_MATRIX"] = "npr_unjittered_projection";
 		actions.renames["INV_PROJECTION_MATRIX"] = "inv_projection_matrix";
 		actions.renames["MODELVIEW_MATRIX"] = "modelview";
 		actions.renames["MODELVIEW_NORMAL_MATRIX"] = "modelview_normal";
diff --git a/servers/rendering/renderer_rd/shaders/forward_clustered/scene_forward_clustered_inc.glsl b/servers/rendering/renderer_rd/shaders/forward_clustered/scene_forward_clustered_inc.glsl
index 3342d7c3e2ec75a4bd0f0c77e815ecb77eb500ed..a69de984153b5b0501954b87c0b00741450a3dfb 100644
--- a/servers/rendering/renderer_rd/shaders/forward_clustered/scene_forward_clustered_inc.glsl
+++ b/servers/rendering/renderer_rd/shaders/forward_clustered/scene_forward_clustered_inc.glsl
@@ -5,6 +5,12 @@
 #define MAX_VOXEL_GI_INSTANCES 8
 #define MAX_VIEWS 2
 
+#ifdef USE_MULTIVIEW
+#define npr_unjittered_projection scene_data.unjittered_projection_matrix_view[ViewIndex]
+#else
+#define npr_unjittered_projection scene_data.unjittered_projection_matrix
+#endif
+
 #extension GL_KHR_shader_subgroup_ballot : enable
 #extension GL_KHR_shader_subgroup_arithmetic : enable
 
diff --git a/servers/rendering/renderer_rd/shaders/scene_data_inc.glsl b/servers/rendering/renderer_rd/shaders/scene_data_inc.glsl
index 7437b48e2c67374b824ef900c889cc3752eebcda..b42fcf0e83669804e980aac83caa0eed23d0943d 100644
--- a/servers/rendering/renderer_rd/shaders/scene_data_inc.glsl
+++ b/servers/rendering/renderer_rd/shaders/scene_data_inc.glsl
@@ -16,6 +16,7 @@
 struct SceneData {
 	mat4 projection_matrix;
 	mat4 inv_projection_matrix;
+	mat4 unjittered_projection_matrix;
 	mat3x4 inv_view_matrix;
 	mat3x4 view_matrix;
 
@@ -26,6 +27,7 @@ struct SceneData {
 	// only used for multiview
 	mat4 projection_matrix_view[MAX_VIEWS];
 	mat4 inv_projection_matrix_view[MAX_VIEWS];
+	mat4 unjittered_projection_matrix_view[MAX_VIEWS];
 	vec4 eye_offset[MAX_VIEWS];
 
 	// Used for billboards to cast correct shadows.
diff --git a/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.cpp b/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.cpp
index 8945147e625bce2c345d836bac791de5aaa5efe9..63be8dbac76f8021f3fbd60c2352eb654558faae 100644
--- a/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.cpp
+++ b/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.cpp
@@ -80,6 +80,14 @@ void RenderSceneDataRD::update_ubo(RID p_uniform_buffer, RSE::ViewportDebugDraw
 	// just for easy access..
 	UBO &ubo = ubo_data.ubo;
 	UBO &prev_ubo = ubo_data.prev_ubo;
+	// Preserve the camera mapping before temporal jitter, without subtractive
+	// reconstruction from the jittered matrix (which loses exact float identity).
+	Projection unjittered_correction;
+	unjittered_correction.set_depth_correction(flip_y);
+	RendererRD::MaterialStorage::store_camera(unjittered_correction * cam_projection, ubo.unjittered_projection_matrix);
+	for (uint32_t v = 0; v < view_count; v++) {
+		RendererRD::MaterialStorage::store_camera(unjittered_correction * view_projection[v], ubo.unjittered_projection_matrix_view[v]);
+	}
 
 	Projection correction;
 	correction.set_depth_correction(flip_y);
@@ -276,6 +284,12 @@ void RenderSceneDataRD::update_ubo(RID p_uniform_buffer, RSE::ViewportDebugDraw
 	if (calculate_motion_vectors) {
 		// Q : Should we make a complete copy or should we define a separate UBO with just the components we need?
 		memcpy(&prev_ubo, &ubo, sizeof(UBO));
+		Projection prev_unjittered_correction;
+		prev_unjittered_correction.set_depth_correction(true);
+		RendererRD::MaterialStorage::store_camera(prev_unjittered_correction * prev_cam_projection, prev_ubo.unjittered_projection_matrix);
+		for (uint32_t v = 0; v < view_count; v++) {
+			RendererRD::MaterialStorage::store_camera(prev_unjittered_correction * prev_view_projection[v], prev_ubo.unjittered_projection_matrix_view[v]);
+		}
 
 		Projection prev_correction;
 		prev_correction.set_depth_correction(true);
diff --git a/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.h b/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.h
index e02777b511f84a408a0e9113233a5375d8c4e60f..89b4c7183b76531d24c31637b01e2bada6cf53f4 100644
--- a/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.h
+++ b/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.h
@@ -119,6 +119,7 @@ private:
 	struct UBO {
 		float projection_matrix[16];
 		float inv_projection_matrix[16];
+		float unjittered_projection_matrix[16];
 		float inv_view_matrix[12];
 		float view_matrix[12];
 
@@ -128,6 +129,7 @@ private:
 
 		float projection_matrix_view[RendererSceneRender::MAX_RENDER_VIEWS][16];
 		float inv_projection_matrix_view[RendererSceneRender::MAX_RENDER_VIEWS][16];
+		float unjittered_projection_matrix_view[RendererSceneRender::MAX_RENDER_VIEWS][16];
 		float eye_offset[RendererSceneRender::MAX_RENDER_VIEWS][4];
 
 		float main_cam_inv_view_matrix[16];
diff --git a/servers/rendering/shader_preprocessor.cpp b/servers/rendering/shader_preprocessor.cpp
index fc4f07b3225d08391b51ccbda6533a226a2128f5..f9982878e5b04c45b956592f4c1015a7c06b0f81 100644
--- a/servers/rendering/shader_preprocessor.cpp
+++ b/servers/rendering/shader_preprocessor.cpp
@@ -1350,6 +1350,7 @@ void ShaderPreprocessor::_prepare_state(ShaderPreprocessor::State &rp_state, con
 		if (rendering_method == "forward_plus") {
 			insert_builtin_define("CURRENT_RENDERER", _MKSTR(2), rp_state);
 			insert_builtin_define("HAS_MATERIAL_POST_LIGHT", _MKSTR(1), rp_state);
+			insert_builtin_define("HAS_UNJITTERED_PROJECTION_MATRIX", _MKSTR(1), rp_state);
 		} else if (rendering_method == "mobile") {
 			insert_builtin_define("CURRENT_RENDERER", _MKSTR(1), rp_state);
 		} else { // gl_compatibility
diff --git a/servers/rendering/shader_types.cpp b/servers/rendering/shader_types.cpp
index 239522fd3e751861753d93ebe0c5bd3a0421cb8c..c098be10a9cd2d4ce38e5f2a25478f76e619e2e7 100644
--- a/servers/rendering/shader_types.cpp
+++ b/servers/rendering/shader_types.cpp
@@ -117,6 +117,7 @@ ShaderTypes::ShaderTypes() {
 	shader_modes[RSE::SHADER_SPATIAL].functions["vertex"].built_ins["VIEW_MATRIX"] = constt(ShaderLanguage::TYPE_MAT4);
 	shader_modes[RSE::SHADER_SPATIAL].functions["vertex"].built_ins["INV_VIEW_MATRIX"] = constt(ShaderLanguage::TYPE_MAT4);
 	shader_modes[RSE::SHADER_SPATIAL].functions["vertex"].built_ins["PROJECTION_MATRIX"] = ShaderLanguage::TYPE_MAT4;
+	shader_modes[RSE::SHADER_SPATIAL].functions["vertex"].built_ins["UNJITTERED_PROJECTION_MATRIX"] = constt(ShaderLanguage::TYPE_MAT4);
 	shader_modes[RSE::SHADER_SPATIAL].functions["vertex"].built_ins["INV_PROJECTION_MATRIX"] = constt(ShaderLanguage::TYPE_MAT4);
 	shader_modes[RSE::SHADER_SPATIAL].functions["vertex"].built_ins["MODELVIEW_MATRIX"] = ShaderLanguage::TYPE_MAT4;
 	shader_modes[RSE::SHADER_SPATIAL].functions["vertex"].built_ins["MODELVIEW_NORMAL_MATRIX"] = ShaderLanguage::TYPE_MAT3;
@@ -188,6 +189,7 @@ ShaderTypes::ShaderTypes() {
 	shader_modes[RSE::SHADER_SPATIAL].functions["fragment"].built_ins["VIEW_MATRIX"] = constt(ShaderLanguage::TYPE_MAT4);
 	shader_modes[RSE::SHADER_SPATIAL].functions["fragment"].built_ins["INV_VIEW_MATRIX"] = constt(ShaderLanguage::TYPE_MAT4);
 	shader_modes[RSE::SHADER_SPATIAL].functions["fragment"].built_ins["PROJECTION_MATRIX"] = constt(ShaderLanguage::TYPE_MAT4);
+	shader_modes[RSE::SHADER_SPATIAL].functions["fragment"].built_ins["UNJITTERED_PROJECTION_MATRIX"] = constt(ShaderLanguage::TYPE_MAT4);
 	shader_modes[RSE::SHADER_SPATIAL].functions["fragment"].built_ins["INV_PROJECTION_MATRIX"] = constt(ShaderLanguage::TYPE_MAT4);
 	shader_modes[RSE::SHADER_SPATIAL].functions["fragment"].built_ins["VIEWPORT_SIZE"] = constt(ShaderLanguage::TYPE_VEC2);
 	shader_modes[RSE::SHADER_SPATIAL].functions["fragment"].built_ins["FOG"] = ShaderLanguage::TYPE_VEC4; // TODO consider adding to light shader

