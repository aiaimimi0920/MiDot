From 661246efd04f9fb4c040e9ae48b987817414fb5f Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Tue, 1 Sep 2026 18:54:03 +0800
Subject: [PATCH] fix(editor): release legacy main screen docks

The compatibility container owns its generated dock, while the dock manager only unregisters it. Release the wrapper and clear stale plugin metadata during removal.

Godot-Patch-Topic: editor.legacy-main-screen-dock-cleanup
---
 editor/editor_main_screen.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/editor/editor_main_screen.cpp b/editor/editor_main_screen.cpp
index 30e888c7768e7456c1682779f28b0e28fb5a7ff3..91f61ff85389aa6c7c5d077818fc737a2315c700 100644
--- a/editor/editor_main_screen.cpp
+++ b/editor/editor_main_screen.cpp
@@ -196,7 +196,9 @@ void EditorMainScreen::remove_main_plugin(EditorPlugin *p_editor) {
 		EditorDock *dock = Object::cast_to<EditorDock>(p_editor->get_meta("_dock").get_validated_object());
 		if (dock) {
 			EditorDockManager::get_singleton()->remove_dock(dock);
+			dock->queue_free();
 		}
+		p_editor->remove_meta("_dock");
 	}
 
 	editor_table.erase(p_editor);

