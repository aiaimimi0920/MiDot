From 6d03cb106e8e1bce95b8cdd1b844370687b6c5e7 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Tue, 1 Sep 2026 01:51:23 +0800
Subject: [PATCH] fix(rendering): register streaming settings early

Forward renderers read texture streaming settings before scene-level modules initialize.

Godot-Patch-Topic: runtime.texture-streaming-init-order
---
 modules/texture_streaming/texture_streaming.cpp | 14 --------------
 servers/rendering/rendering_server.cpp          | 13 +++++++++++++
 2 files changed, 13 insertions(+), 14 deletions(-)

diff --git a/modules/texture_streaming/texture_streaming.cpp b/modules/texture_streaming/texture_streaming.cpp
index 52f49989d4fafa79aef8087ccf4e2562a02871cc..cfa803983d834c861ad770d9d9437fff8955ae9d 100644
--- a/modules/texture_streaming/texture_streaming.cpp
+++ b/modules/texture_streaming/texture_streaming.cpp
@@ -224,20 +224,6 @@ RID TextureStreaming::material_set_textures(RID p_feedback_rid, const Vector<RID
 TextureStreaming::TextureStreaming() {
 	singleton = this;
 
-	// Global settings
-	GLOBAL_DEF_RST("rendering/textures/streaming/enabled", false);
-	GLOBAL_DEF(PropertyInfo(Variant::BOOL, "rendering/textures/streaming/memory_budget_enabled"), false);
-	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/memory_budget_mb"), 512);
-	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/max_ops_per_second"), 200);
-
-	// Mip level settings: 0 = full resolution (best quality), higher = lower resolution
-	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/min_lod", PROPERTY_HINT_RANGE, "0,13,1"), 0);
-	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/max_lod", PROPERTY_HINT_RANGE, "0,13,1"), 3);
-
-	// Inactivity decay: time per mip level of decay in milliseconds.
-	// The first decay happens after one rate period. Set to 0 to disable decay.
-	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/inactivity_decay_rate_ms", PROPERTY_HINT_RANGE, "0,60000,100,or_greater"), 5000);
-
 	// Load initial settings.
 	setting_streaming_is_enabled = GLOBAL_GET("rendering/textures/streaming/enabled");
 	setting_max_ops_per_second = GLOBAL_GET("rendering/textures/streaming/max_ops_per_second");
diff --git a/servers/rendering/rendering_server.cpp b/servers/rendering/rendering_server.cpp
index fb6701b903c739305ad8be0b742fc33b4a8b9e50..f7206eebdb733120065862081953b6185b7a24f2 100644
--- a/servers/rendering/rendering_server.cpp
+++ b/servers/rendering/rendering_server.cpp
@@ -41,6 +41,8 @@
 #include "servers/rendering/shader_language.h"
 #include "servers/rendering/shader_warnings.h"
 
+#include "modules/modules_enabled.gen.h"
+
 RenderingServer *RenderingServer::singleton = nullptr;
 RenderingServer *(*RenderingServer::create_func)() = nullptr;
 
@@ -3670,6 +3672,17 @@ void RenderingServer::init() {
 	GLOBAL_DEF("rendering/textures/vram_compression/compress_with_gpu", true);
 	GLOBAL_DEF("rendering/textures/vram_compression/cache_gpu_compressor", true);
 
+#ifdef MODULE_TEXTURE_STREAMING_ENABLED
+	// Forward renderers read these settings before scene-level modules are initialized.
+	GLOBAL_DEF_RST("rendering/textures/streaming/enabled", false);
+	GLOBAL_DEF(PropertyInfo(Variant::BOOL, "rendering/textures/streaming/memory_budget_enabled"), false);
+	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/memory_budget_mb"), 512);
+	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/max_ops_per_second"), 200);
+	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/min_lod", PROPERTY_HINT_RANGE, "0,13,1"), 0);
+	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/max_lod", PROPERTY_HINT_RANGE, "0,13,1"), 3);
+	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/inactivity_decay_rate_ms", PROPERTY_HINT_RANGE, "0,60000,100,or_greater"), 5000);
+#endif
+
 	GLOBAL_DEF("rendering/textures/lossless_compression/force_png", false);
 
 	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/webp_compression/compression_method", PROPERTY_HINT_RANGE, "0,6,1"), 2);

