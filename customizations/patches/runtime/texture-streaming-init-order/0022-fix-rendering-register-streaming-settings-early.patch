From 185e7cb853792aaf37df3599fd84050cc7c3db65 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Tue, 1 Sep 2026 01:51:23 +0800
Subject: [PATCH] fix(rendering): register streaming settings early

Forward renderers read texture streaming settings before scene-level modules initialize.

Godot-Patch-Topic: runtime.texture-streaming-init-order
---
 modules/texture_streaming/texture_streaming.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/modules/texture_streaming/texture_streaming.cpp b/modules/texture_streaming/texture_streaming.cpp
index 72799cefc33ed8ee5932d1b38dacf107ffca7b24..98a79e73f4dda012dda02ddeb0f5514e793403db 100644
--- a/modules/texture_streaming/texture_streaming.cpp
+++ b/modules/texture_streaming/texture_streaming.cpp
@@ -222,7 +222,7 @@ RID TextureStreaming::material_set_textures(RID p_feedback_rid, const Vector<RID
 }
 
 void TextureStreaming::register_project_settings() {
-	// Global settings
+	// Registered during core module initialization, before Forward renderers read them.
 	GLOBAL_DEF_RST("rendering/textures/streaming/enabled", false);
 	GLOBAL_DEF(PropertyInfo(Variant::BOOL, "rendering/textures/streaming/memory_budget_enabled"), false);
 	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/streaming/memory_budget_mb"), 512);

