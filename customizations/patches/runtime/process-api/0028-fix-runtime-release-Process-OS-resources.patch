diff --git a/drivers/unix/os_unix.cpp b/drivers/unix/os_unix.cpp
index 46508be07039a21d6d296d3dd26d858a7dc54ab6..5ce89f6b8a96f4723b10860aea369295478a290a 100644
--- a/drivers/unix/os_unix.cpp
+++ b/drivers/unix/os_unix.cpp
@@ -965,9 +965,19 @@ Error OS_Unix::create_process(const String &p_path, const List<String> &p_argume
 Error OS_Unix::kill(const ProcessID &p_pid) {
 	int ret = ::kill(p_pid, SIGKILL);
 	if (!ret) {
-		//avoid zombie process
-		int st;
-		_wait_for_pid_completion(p_pid, &st, 0);
+		// Avoid a zombie process and preserve a stable cached exit status.
+		int status = 0;
+		const int wait_result = _wait_for_pid_completion(p_pid, &status, 0);
+		if (wait_result == 0) {
+			status = WIFEXITED(status) ? WEXITSTATUS(status) : status;
+
+			MutexLock lock(process_map_mutex);
+			ProcessInfo *pi = process_map->getptr(p_pid);
+			if (pi) {
+				pi->is_running = false;
+				pi->exit_code = status;
+			}
+		}
 	}
 	return ret ? ERR_INVALID_PARAMETER : OK;
 }
@@ -993,6 +1003,11 @@ int OS_Unix::get_process_exit_code(const ProcessID &p_pid) const {
 	return exit_code;
 }
 
+void OS_Unix::release_process(const ProcessID &p_pid) {
+	MutexLock lock(process_map_mutex);
+	process_map->erase(p_pid);
+}
