 	if (!info.is_running) {
+		_close_process_handles(info);
 		return false;
 	}
 
@@ -1649,6 +1648,7 @@ bool OS_Windows::is_process_running(const ProcessID &p_pid) const {
 	if (dw_exit_code != STILL_ACTIVE) {
 		info.is_running = false;
 		info.exit_code = dw_exit_code;
+		_close_process_handles(info);
 		return false;
 	}
 
@@ -1661,8 +1661,9 @@ int OS_Windows::get_process_exit_code(const ProcessID &p_pid) const {
 		return -1;
 	}
 
-	const ProcessInfo &info = (*process_map)[p_pid];
+	ProcessInfo &info = (*process_map)[p_pid];
 	if (!info.is_running) {
+		_close_process_handles(info);
 		return info.exit_code;
 	}
 
@@ -1679,9 +1680,31 @@ int OS_Windows::get_process_exit_code(const ProcessID &p_pid) const {
 
 	info.is_running = false;
 	info.exit_code = dw_exit_code;
+	_close_process_handles(info);
 	return dw_exit_code;
 }
 
+void OS_Windows::release_process(const ProcessID &p_pid) {
+	MutexLock lock(process_map_mutex);
+	ProcessInfo *info = process_map->getptr(p_pid);
+	if (info == nullptr) {
+		return;
+	}
+	_close_process_handles(*info);
+	process_map->erase(p_pid);
+}
+
+void OS_Windows::_close_process_handles(ProcessInfo &p_info) const {
+	if (p_info.pi.hProcess != nullptr && p_info.pi.hProcess != GetCurrentProcess()) {
+		CloseHandle(p_info.pi.hProcess);
+		p_info.pi.hProcess = nullptr;
+	}
+	if (p_info.pi.hThread != nullptr) {
+		CloseHandle(p_info.pi.hThread);
+		p_info.pi.hThread = nullptr;
+	}
+}
