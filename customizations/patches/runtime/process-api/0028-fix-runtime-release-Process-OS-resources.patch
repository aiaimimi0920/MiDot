 drivers/unix/os_unix.h          |   1 +
 platform/windows/os_windows.cpp |  39 ++++++++--
 platform/windows/os_windows.h   |   2 +
 tests/core/io/test_process.cpp  | 127 ++++++++++++++++++++++++++++++++
 9 files changed, 198 insertions(+), 12 deletions(-)
 create mode 100644 tests/core/io/test_process.cpp

diff --git a/core/io/process.cpp b/core/io/process.cpp
index a33f68c68c45bccfc40873c37c295c963ad6d45f..c2d20a7f6018f33c864a2ce50b68381550ca02e6 100644
--- a/core/io/process.cpp
+++ b/core/io/process.cpp
@@ -99,6 +99,21 @@ void Process::_flush_remainders_if_exited() const {
 	}
 }
 
+Process::~Process() {
+	OS *os = OS::get_singleton();
+	if (os == nullptr || process_id <= 0) {
+		return;
+	}
+	bool is_running = os->is_process_running(process_id);
+	if (is_running) {
+		os->kill(process_id);
+		is_running = os->is_process_running(process_id);
+	}
+	if (!is_running) {
+		os->release_process(process_id);
+	}
+}
