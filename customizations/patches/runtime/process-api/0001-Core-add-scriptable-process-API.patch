+++ b/drivers/unix/file_access_unix_pipe.cpp
@@ -109,14 +109,16 @@ Error FileAccessUnixPipe::open_internal(const String &p_path, int p_mode_flags)
 }
 
 void FileAccessUnixPipe::_close() {
-	if (fd[0] < 0) {
+	if (fd[0] < 0 && fd[1] < 0) {
 		return;
 	}
 
-	if (fd[1] != fd[0]) {
+	if (fd[1] >= 0 && fd[1] != fd[0]) {
 		::close(fd[1]);
 	}
-	::close(fd[0]);
+	if (fd[0] >= 0) {
+		::close(fd[0]);
+	}
 	fd[0] = -1;
 	fd[1] = -1;
 
@@ -187,6 +189,19 @@ void FileAccessUnixPipe::close() {
 	_close();
 }
 
+void FileAccessUnixPipe::close_write() {
+	if (fd[1] < 0) {
+		return;
+	}
+	if (fd[1] == fd[0]) {
+		::close(fd[0]);
+		fd[0] = -1;
+	} else {
+		::close(fd[1]);
+	}
+	fd[1] = -1;
+}
+
 FileAccessUnixPipe::~FileAccessUnixPipe() {
 	_close();
 }
