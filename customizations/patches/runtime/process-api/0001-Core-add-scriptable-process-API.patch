@@ -0,0 +1,79 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="Process" inherits="RefCounted" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../class.xsd">
+	<brief_description>
+		Runs and controls a child process with redirected standard streams.
+	</brief_description>
+	<description>
+		[Process] provides a non-blocking object wrapper around a child process. Create one with [method create], then poll and read its standard output and error lines. Standard input is writable only when [code]open_stdin[/code] is [code]true[/code].
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+		<method name="close_stdin">
+			<return type="void" />
+			<description>
+				Closes standard input without closing the process output streams.
+			</description>
+		</method>
+		<method name="create" qualifiers="static">
+			<return type="Process" />
+			<param index="0" name="path" type="String" />
+			<param index="1" name="arguments" type="PackedStringArray" default="PackedStringArray()" />
+			<param index="2" name="working_directory" type="String" default="&quot;&quot;" />
+			<param index="3" name="open_stdin" type="bool" default="false" />
+			<description>
+				Starts [param path] with [param arguments]. An empty [param working_directory] uses the engine executable directory. Returns [code]null[/code] if the platform cannot create the process.
+			</description>
+		</method>
+		<method name="get_available_stderr_lines" qualifiers="const">
+			<return type="int" />
+			<description>
+				Returns the number of complete standard-error lines ready to read.
+			</description>
+		</method>
+		<method name="get_available_stdout_lines" qualifiers="const">
+			<return type="int" />
+			<description>
+				Returns the number of complete standard-output lines ready to read.
+			</description>
+		</method>
+		<method name="get_exit_status" qualifiers="const">
+			<return type="int" />
+			<description>
+				Returns the child exit status, or [code]-1[/code] while it is still running.
+			</description>
+		</method>
+		<method name="get_id" qualifiers="const">
+			<return type="int" />
+			<description>
+				Returns the child process ID.
+			</description>
+		</method>
+		<method name="get_stderr_line">
+			<return type="String" />
+			<description>
+				Returns and removes the next available standard-error line.
+			</description>
+		</method>
+		<method name="get_stdout_line">
+			<return type="String" />
+			<description>
+				Returns and removes the next available standard-output line.
+			</description>
+		</method>
+		<method name="kill">
+			<return type="void" />
+			<param index="0" name="force" type="bool" default="false" />
+			<description>
+				Terminates the child process. [param force] is retained for compatibility; platform termination behavior is defined by [method OS.kill].
+			</description>
+		</method>
+		<method name="write">
+			<return type="bool" />
+			<param index="0" name="input" type="String" />
+			<description>
+				Writes [param input] to standard input. Returns [code]false[/code] if input was not opened or the write failed.
+			</description>
+		</method>
+	</methods>
+</class>
diff --git a/drivers/unix/file_access_unix_pipe.cpp b/drivers/unix/file_access_unix_pipe.cpp
index c3276d9fb70d3e5f531d54d128ceb38614368c29..645470eda15c675ae12f0f841754d8ab8d017b9a 100644
