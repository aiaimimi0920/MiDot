From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Mon, 7 Sep 2026 13:22:11 +0800
Subject: [PATCH] perf(geometry): trim BVH build allocation

Godot-Patch-Topic: geometry.triangle-mesh-build
---
 core/math/triangle_mesh.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/core/math/triangle_mesh.cpp b/core/math/triangle_mesh.cpp
index 26e958fcc0b6d7dae1413484cd33021876315283..2d02ba28e9817c593c0277418c121a7bbe39a09e 100644
--- a/core/math/triangle_mesh.cpp
+++ b/core/math/triangle_mesh.cpp
@@ -115,7 +115,8 @@ void TriangleMesh::create(const Vector<Vector3> &p_faces, const Vector<int32_t>
 	fc /= 3;
 	triangles.resize(fc);
 
-	bvh.resize(fc * 3); //will never be larger than this (todo make better)
+	// A full binary tree with fc leaves has exactly fc - 1 internal nodes.
+	bvh.resize(fc * 2 - 1);
 	BVH *bw = bvh.ptrw();
 
 	{
@@ -127,6 +128,8 @@ void TriangleMesh::create(const Vector<Vector3> &p_faces, const Vector<int32_t>
 		const int32_t *si = p_surface_indices.ptr();
 		Triangle *w = triangles.ptrw();
 		HashMap<Vector3, int> db;
+		// Avoid repeated growth while welding typical indexed triangle meshes.
+		db.reserve(fc);
 
 		for (int i = 0; i < fc; i++) {
 			Triangle &f = w[i];

