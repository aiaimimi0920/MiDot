From ccd128dfaa9662cd8ae60c2135cf840da57be1fb Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Mon, 7 Sep 2026 13:37:17 +0800
Subject: [PATCH] feat(geometry): add opt-in triangle BVH refit

Godot-Patch-Topic: geometry.triangle-mesh-refit
---
 core/math/triangle_mesh.cpp  | 44 ++++++++++++++++++++++++++++++++++++
 core/math/triangle_mesh.h    |  1 +
 doc/classes/TriangleMesh.xml |  9 ++++++++
 3 files changed, 54 insertions(+)

diff --git a/core/math/triangle_mesh.cpp b/core/math/triangle_mesh.cpp
index 2d02ba28e9817c593c0277418c121a7bbe39a09e..8801d7edfe16f469c67509abe04245af912053d8 100644
--- a/core/math/triangle_mesh.cpp
+++ b/core/math/triangle_mesh.cpp
@@ -538,6 +538,49 @@ bool TriangleMesh::create_from_faces(const Vector<Vector3> &p_faces) {
 	return is_valid();
 }
 
+bool TriangleMesh::refit_from_faces(const Vector<Vector3> &p_faces) {
+	// Reject the entire update before touching a valid tree. This is an optional
+	// fast path: callers can rebuild when the number of faces changes.
+	if (!valid || p_faces.size() != triangles.size() * 3) {
+		return false;
+	}
+	const Vector3 *r = p_faces.ptr();
+	for (int i = 0; i < p_faces.size(); i++) {
+		if (!r[i].is_finite()) {
+			return false;
+		}
+	}
+
+	// Previously welded corners may separate under deformation. Store independent
+	// snapped corners instead of retaining an obsolete shared-vertex mapping.
+	vertices.resize(p_faces.size());
+	Vector3 *vw = vertices.ptrw();
+	Triangle *tw = triangles.ptrw();
+	BVH *bw = bvh.ptrw();
+	const int fc = triangles.size();
+	for (int i = 0; i < fc; i++) {
+		for (int j = 0; j < 3; j++) {
+			const int index = i * 3 + j;
+			vw[index] = r[index].snappedf(0.0001);
+			tw[i].indices[j] = index;
+			if (j == 0) {
+				bw[i].aabb = AABB(vw[index], Vector3());
+			} else {
+				bw[i].aabb.expand_to(vw[index]);
+			}
+		}
+		tw[i].normal = Face3(r[i * 3], r[i * 3 + 1], r[i * 3 + 2]).get_plane().get_normal();
+		bw[i].center = bw[i].aabb.get_center();
+	}
+	// _create_bvh allocates internal nodes in postorder: children always precede
+	// their parent. Ascending indices update the root last, including uneven trees.
+	for (int i = fc; i < bvh.size(); i++) {
+		bw[i].aabb = bw[bw[i].left].aabb.merge(bw[bw[i].right].aabb);
+		bw[i].center = bw[i].aabb.get_center();
+	}
+	return true;
+}
+
 Dictionary TriangleMesh::intersect_segment_scriptwrap(const Vector3 &p_begin, const Vector3 &p_end) const {
 	if (!valid) {
 		return Dictionary();
@@ -606,6 +649,7 @@ Vector<Vector3> TriangleMesh::get_faces_scriptwrap() const {
 
 void TriangleMesh::_bind_methods() {
 	ClassDB::bind_method(D_METHOD("create_from_faces", "faces"), &TriangleMesh::create_from_faces);
+	ClassDB::bind_method(D_METHOD("refit_from_faces", "faces"), &TriangleMesh::refit_from_faces);
 	ClassDB::bind_method(D_METHOD("get_faces"), &TriangleMesh::get_faces_scriptwrap);
 
 	ClassDB::bind_method(D_METHOD("intersect_segment", "begin", "end"), &TriangleMesh::intersect_segment_scriptwrap);
diff --git a/core/math/triangle_mesh.h b/core/math/triangle_mesh.h
index 0b9def0b0711d842d1eec24f86515f672f4e0db9..1172655241043e450791458a67bb866cff13bc7a 100644
--- a/core/math/triangle_mesh.h
+++ b/core/math/triangle_mesh.h
@@ -99,6 +99,7 @@ public:
 	// Wrapped functions for compatibility with method bindings
 	// and user exposed script api that can't use more native types.
 	bool create_from_faces(const Vector<Vector3> &p_faces);
+	bool refit_from_faces(const Vector<Vector3> &p_faces);
 	Dictionary intersect_segment_scriptwrap(const Vector3 &p_begin, const Vector3 &p_end) const;
 	Dictionary intersect_ray_scriptwrap(const Vector3 &p_begin, const Vector3 &p_dir) const;
 	Vector<Vector3> get_faces_scriptwrap() const;
diff --git a/doc/classes/TriangleMesh.xml b/doc/classes/TriangleMesh.xml
index 8d15e0336b28d65b30620e67c0dcf7b35254a120..49982ac2efa86aba8b9638741659ee505d42d3ef 100644
--- a/doc/classes/TriangleMesh.xml
+++ b/doc/classes/TriangleMesh.xml
@@ -20,6 +20,15 @@
 				Returns [code]true[/code] if the tree is successfully built, [code]false[/code] otherwise.
 			</description>
 		</method>
+		<method name="refit_from_faces">
+			<return type="bool" />
+			<param index="0" name="faces" type="PackedVector3Array" />
+			<description>
+				Updates an existing tree's triangle positions and bounds without rebuilding its partition. The input must contain the same number of vertices as the previous build, in the same face order. Returns [code]false[/code] without modifying the tree if it is not valid, the count differs, or any input coordinate is non-finite.
+				Uses the same coordinate snapping and face-normal calculation as [method create_from_faces]. Corners welded by the original build may separate; refitted geometry stores independent corners, which may use more vertex memory. Face and surface indices retain their original ordering. For equal-distance hits on overlapping faces or shared edges, the winning face may differ from a freshly rebuilt partition.
+				Repeated or large deformations may reduce query performance because the partition is retained. Rebuild periodically or when profiling indicates degraded traversal. Do not update and query the same instance concurrently.
+			</description>
+		</method>
 		<method name="get_faces" qualifiers="const">
 			<return type="PackedVector3Array" />
 			<description>

