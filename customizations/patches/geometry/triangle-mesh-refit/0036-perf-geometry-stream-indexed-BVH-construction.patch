From 0395f4b842f5de97845653e032e34bca1ec5dc23 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Wed, 9 Sep 2026 07:02:11 +0800
Subject: [PATCH] perf(geometry): stream indexed BVH construction

Avoid the expanded corner buffer while preserving the shared welder, face ordering and invalid-update semantics.

Godot-Patch-Topic: geometry.triangle-mesh-refit
---
 core/math/triangle_mesh.cpp | 48 +++++++++++++++++++++++++++++++++----
 core/math/triangle_mesh.h   |  2 ++
 2 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/core/math/triangle_mesh.cpp b/core/math/triangle_mesh.cpp
index 221af0301fdd125396779836fc9895b3656abe36..d3779e2cca2ad09b58467281df83dac2e49f7a9c 100644
--- a/core/math/triangle_mesh.cpp
+++ b/core/math/triangle_mesh.cpp
@@ -113,6 +113,15 @@ void TriangleMesh::create(const Vector<Vector3> &p_faces, const Vector<int32_t>
 	int fc = p_faces.size();
 	ERR_FAIL_COND(!fc || ((fc % 3) != 0));
 	fc /= 3;
+	const Vector3 *r = p_faces.ptr();
+	_create(
+			fc, [r](int p_face) { return Face3(r[p_face * 3], r[p_face * 3 + 1], r[p_face * 3 + 2]); }, p_surface_indices);
+}
+
+template <typename FaceReader>
+void TriangleMesh::_create(int p_face_count, const FaceReader &p_read_face, const Vector<int32_t> &p_surface_indices) {
+	valid = false;
+	const int fc = p_face_count;
 	triangles.resize(fc);
 
 	// A full binary tree with fc leaves has exactly fc - 1 internal nodes.
@@ -124,7 +133,6 @@ void TriangleMesh::create(const Vector<Vector3> &p_faces, const Vector<int32_t>
 		//except for the Set for repeated triangles, everything
 		//goes in-place.
 
-		const Vector3 *r = p_faces.ptr();
 		const int32_t *si = p_surface_indices.ptr();
 		Triangle *w = triangles.ptrw();
 		HashMap<Vector3, int> db;
@@ -133,7 +141,8 @@ void TriangleMesh::create(const Vector<Vector3> &p_faces, const Vector<int32_t>
 
 		for (int i = 0; i < fc; i++) {
 			Triangle &f = w[i];
-			const Vector3 *v = &r[i * 3];
+			const Face3 face = p_read_face(i);
+			const Vector3 *v = face.vertex;
 
 			for (int j = 0; j < 3; j++) {
 				int vidx = -1;
@@ -154,7 +163,7 @@ void TriangleMesh::create(const Vector<Vector3> &p_faces, const Vector<int32_t>
 				}
 			}
 
-			f.normal = Face3(r[i * 3 + 0], r[i * 3 + 1], r[i * 3 + 2]).get_plane().get_normal();
+			f.normal = face.get_plane().get_normal();
 			f.surface_index = si ? si[i] : 0;
 
 			bw[i].left = -1;
@@ -555,10 +564,39 @@ bool TriangleMesh::update_from_indexed_surfaces(const Array &p_vertex_arrays, co
 		if (count > INT32_MAX) {
 			return false;
 		}
+		if (!p_refit) {
+			// Validate all input before replacing an existing valid tree.
+			const Vector<Vector3> points = p_vertex_arrays[i];
+			for (int index : indices) {
+				if (index < 0 || index >= points.size() || !points[index].is_finite()) {
+					return false;
+				}
+			}
+		}
 	}
 	if (count == 0 || (p_refit && (!valid || count != triangles.size() * 3))) {
 		return false;
 	}
+	if (!p_refit) {
+		// Feed the same face order into the shared welder without expanding all corners.
+		int surface = 0;
+		int corner = 0;
+		Vector<Vector3> points;
+		Vector<int32_t> indices;
+		_create(
+				count / 3, [&](int) {
+					while (corner == indices.size()) {
+						points = p_vertex_arrays[surface];
+						indices = p_index_arrays[surface++];
+						corner = 0;
+					}
+					const Face3 face(points[indices[corner]], points[indices[corner + 1]], points[indices[corner + 2]]);
+					corner += 3;
+					return face;
+				},
+				Vector<int32_t>());
+		return is_valid();
+	}
 	Vector<Vector3> faces;
 	faces.resize(count);
 	Vector3 *w = faces.ptrw();
@@ -576,8 +614,8 @@ bool TriangleMesh::update_from_indexed_surfaces(const Array &p_vertex_arrays, co
 			w[offset++] = v[index];
 		}
 	}
-	// Expand on the CPU without an ArrayMesh upload/readback or an intermediate BVH.
-	return p_refit ? refit_from_faces(faces) : create_from_faces(faces);
+	// Refit retains its existing corner-indexed input contract.
+	return refit_from_faces(faces);
 }
 
 bool TriangleMesh::refit_from_faces(const Vector<Vector3> &p_faces) {
diff --git a/core/math/triangle_mesh.h b/core/math/triangle_mesh.h
index 9b34aacb7848ae0a8812312926d47f45b85eb060..839860737e37407012b224dd696d0e1f4fbf4d28 100644
--- a/core/math/triangle_mesh.h
+++ b/core/math/triangle_mesh.h
@@ -76,6 +76,8 @@ private:
 	};
 
 	int _create_bvh(BVH *p_bvh, BVH **p_bb, int p_from, int p_size, int p_depth, int &r_max_depth, int &r_max_alloc);
+	template <typename FaceReader>
+	void _create(int p_face_count, const FaceReader &p_read_face, const Vector<int32_t> &p_surface_indices);
 
 	Vector<BVH> bvh;
 	int max_depth = 0;

