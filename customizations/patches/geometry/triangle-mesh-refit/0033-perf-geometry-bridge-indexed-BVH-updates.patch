From b8aa7300e249ae270fcf1786d8bb2bf92405d9e4 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Mon, 7 Sep 2026 13:55:09 +0800
Subject: [PATCH] perf(geometry): bridge indexed BVH updates

Godot-Patch-Topic: geometry.triangle-mesh-refit
---
 core/math/triangle_mesh.cpp  | 43 ++++++++++++++++++++++++++++++++++++
 core/math/triangle_mesh.h    |  1 +
 doc/classes/TriangleMesh.xml | 10 +++++++++
 3 files changed, 54 insertions(+)

diff --git a/core/math/triangle_mesh.cpp b/core/math/triangle_mesh.cpp
index 8801d7edfe16f469c67509abe04245af912053d8..221af0301fdd125396779836fc9895b3656abe36 100644
--- a/core/math/triangle_mesh.cpp
+++ b/core/math/triangle_mesh.cpp
@@ -538,6 +538,48 @@ bool TriangleMesh::create_from_faces(const Vector<Vector3> &p_faces) {
 	return is_valid();
 }
 
+bool TriangleMesh::update_from_indexed_surfaces(const Array &p_vertex_arrays, const Array &p_index_arrays, bool p_refit) {
+	if (p_vertex_arrays.size() != p_index_arrays.size()) {
+		return false;
+	}
+	int64_t count = 0;
+	for (int i = 0; i < p_vertex_arrays.size(); i++) {
+		if (p_vertex_arrays[i].get_type() != Variant::PACKED_VECTOR3_ARRAY || p_index_arrays[i].get_type() != Variant::PACKED_INT32_ARRAY) {
+			return false;
+		}
+		const Vector<int32_t> indices = p_index_arrays[i];
+		if (indices.size() % 3 != 0) {
+			return false;
+		}
+		count += indices.size();
+		if (count > INT32_MAX) {
+			return false;
+		}
+	}
+	if (count == 0 || (p_refit && (!valid || count != triangles.size() * 3))) {
+		return false;
+	}
+	Vector<Vector3> faces;
+	faces.resize(count);
+	Vector3 *w = faces.ptrw();
+	int offset = 0;
+	for (int i = 0; i < p_vertex_arrays.size(); i++) {
+		const Vector<Vector3> points = p_vertex_arrays[i];
+		const Vector<int32_t> indices = p_index_arrays[i];
+		const Vector3 *v = points.ptr();
+		const int32_t *r = indices.ptr();
+		for (int j = 0; j < indices.size(); j++) {
+			const int index = r[j];
+			if (index < 0 || index >= points.size() || !v[index].is_finite()) {
+				return false;
+			}
+			w[offset++] = v[index];
+		}
+	}
+	// Expand on the CPU without an ArrayMesh upload/readback or an intermediate BVH.
+	return p_refit ? refit_from_faces(faces) : create_from_faces(faces);
+}
+
 bool TriangleMesh::refit_from_faces(const Vector<Vector3> &p_faces) {
 	// Reject the entire update before touching a valid tree. This is an optional
 	// fast path: callers can rebuild when the number of faces changes.
@@ -650,6 +692,7 @@ Vector<Vector3> TriangleMesh::get_faces_scriptwrap() const {
 void TriangleMesh::_bind_methods() {
 	ClassDB::bind_method(D_METHOD("create_from_faces", "faces"), &TriangleMesh::create_from_faces);
 	ClassDB::bind_method(D_METHOD("refit_from_faces", "faces"), &TriangleMesh::refit_from_faces);
+	ClassDB::bind_method(D_METHOD("update_from_indexed_surfaces", "vertex_arrays", "index_arrays", "refit"), &TriangleMesh::update_from_indexed_surfaces, DEFVAL(false));
 	ClassDB::bind_method(D_METHOD("get_faces"), &TriangleMesh::get_faces_scriptwrap);
 
 	ClassDB::bind_method(D_METHOD("intersect_segment", "begin", "end"), &TriangleMesh::intersect_segment_scriptwrap);
diff --git a/core/math/triangle_mesh.h b/core/math/triangle_mesh.h
index 1172655241043e450791458a67bb866cff13bc7a..9b34aacb7848ae0a8812312926d47f45b85eb060 100644
--- a/core/math/triangle_mesh.h
+++ b/core/math/triangle_mesh.h
@@ -100,6 +100,7 @@ public:
 	// and user exposed script api that can't use more native types.
 	bool create_from_faces(const Vector<Vector3> &p_faces);
 	bool refit_from_faces(const Vector<Vector3> &p_faces);
+	bool update_from_indexed_surfaces(const Array &p_vertex_arrays, const Array &p_index_arrays, bool p_refit = false);
 	Dictionary intersect_segment_scriptwrap(const Vector3 &p_begin, const Vector3 &p_end) const;
 	Dictionary intersect_ray_scriptwrap(const Vector3 &p_begin, const Vector3 &p_dir) const;
 	Vector<Vector3> get_faces_scriptwrap() const;
diff --git a/doc/classes/TriangleMesh.xml b/doc/classes/TriangleMesh.xml
index 49982ac2efa86aba8b9638741659ee505d42d3ef..7a6fe359b69b4b8fca22eae4d94ee29d51343899 100644
--- a/doc/classes/TriangleMesh.xml
+++ b/doc/classes/TriangleMesh.xml
@@ -20,6 +20,16 @@
 				Returns [code]true[/code] if the tree is successfully built, [code]false[/code] otherwise.
 			</description>
 		</method>
+		<method name="update_from_indexed_surfaces">
+			<return type="bool" />
+			<param index="0" name="vertex_arrays" type="Array" />
+			<param index="1" name="index_arrays" type="Array" />
+			<param index="2" name="refit" type="bool" default="false" />
+			<description>
+				Builds or refits directly from paired arrays of indexed triangle surfaces, without creating a rendering mesh. Each vertex entry must be a [PackedVector3Array] and each index entry a [PackedInt32Array] with a multiple of three indices. An empty index array contributes no faces; non-indexed input requires explicit sequential indices. Faces are concatenated in surface order. As with [method create_from_faces], a new build uses surface index zero for every face.
+				Returns [code]false[/code] without modifying the existing tree for mismatched array lengths, wrong entry types, invalid indices, non-finite referenced positions, or zero total faces. If [param refit] is [code]true[/code], also requires an existing tree and unchanged total face count, with the same limitations as [method refit_from_faces]. Callers must rebuild rather than refit when semantic topology or face ordering changes.
+			</description>
+		</method>
 		<method name="refit_from_faces">
 			<return type="bool" />
 			<param index="0" name="faces" type="PackedVector3Array" />

