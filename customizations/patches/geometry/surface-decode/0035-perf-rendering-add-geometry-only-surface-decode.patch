From 04cf0451bce2064ffab05b3dc69181e114fb7ec8 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Tue, 8 Sep 2026 21:16:47 +0800
Subject: [PATCH] perf(rendering): add geometry-only surface decode

Avoid allocating rendering-only attributes while building CPU geometry snapshots.

Godot-Patch-Topic: geometry.surface-decode
---
 doc/classes/RenderingServer.xml        | 16 +++++++++++++++
 servers/rendering/rendering_server.cpp | 27 +++++++++++++++++++++-----
 servers/rendering/rendering_server.h   |  5 ++++-
 3 files changed, 42 insertions(+), 6 deletions(-)

diff --git a/doc/classes/RenderingServer.xml b/doc/classes/RenderingServer.xml
index fa010422db12e99d24c3fb4a399fd651521ea4a3..08141386f615409dfd753d843694d79df2f32fb4 100644
--- a/doc/classes/RenderingServer.xml
+++ b/doc/classes/RenderingServer.xml
@@ -2640,6 +2640,22 @@
 				Returns the stride of the vertex positions for a mesh with given [param format]. Note importantly that vertex positions are stored consecutively and are not interleaved with the other attributes in the vertex buffer (normals and tangents).
 			</description>
 		</method>
+		<method name="mesh_surface_get_geometry_arrays" qualifiers="const">
+			<return type="Array" />
+			<param index="0" name="mesh" type="RID" />
+			<param index="1" name="surface" type="int" />
+			<description>
+				Returns only the vertex, color, bone, weight, and index arrays of a mesh surface, using the same slot layout and values as [method mesh_surface_get_arrays]. Other slots are [code]null[/code]. Normals, tangents, UVs, and custom attributes are not decoded or allocated. This read-only path is intended for bounds, deformation, and picking consumers; it does not modify the rendered mesh.
+			</description>
+		</method>
+		<method name="mesh_surface_get_geometry_blend_shape_arrays" qualifiers="const">
+			<return type="Array[]" />
+			<param index="0" name="mesh" type="RID" />
+			<param index="1" name="surface" type="int" />
+			<description>
+				Returns the surface's blend shape arrays with only their vertex slots populated. Shape order, array slot layout, and vertex values match [method mesh_surface_get_blend_shape_arrays]. Other attributes are not decoded or allocated. The rendered mesh is not modified.
+			</description>
+		</method>
 		<method name="mesh_surface_get_index_buffer_rd_rid" qualifiers="const">
 			<return type="RID" />
 			<param index="0" name="mesh" type="RID" />
diff --git a/servers/rendering/rendering_server.cpp b/servers/rendering/rendering_server.cpp
index f7206eebdb733120065862081953b6185b7a24f2..453eff21e935446760da0bc44c21eae25ea42bec 100644
--- a/servers/rendering/rendering_server.cpp
+++ b/servers/rendering/rendering_server.cpp
@@ -1403,7 +1403,7 @@ void RenderingServer::mesh_add_surface_from_arrays(RID p_mesh, RSE::PrimitiveTyp
 	mesh_add_surface(p_mesh, sd);
 }
 
-Array RenderingServer::_get_array_from_surface(uint64_t p_format, Vector<uint8_t> p_vertex_data, Vector<uint8_t> p_attrib_data, Vector<uint8_t> p_skin_data, int p_vertex_len, Vector<uint8_t> p_index_data, int p_index_len, const AABB &p_aabb, const Vector4 &p_uv_scale) const {
+Array RenderingServer::_get_array_from_surface(uint64_t p_format, Vector<uint8_t> p_vertex_data, Vector<uint8_t> p_attrib_data, Vector<uint8_t> p_skin_data, int p_vertex_len, Vector<uint8_t> p_index_data, int p_index_len, const AABB &p_aabb, const Vector4 &p_uv_scale, bool p_geometry_only) const {
 	uint32_t offsets[RSE::ARRAY_MAX];
 
 	uint32_t vertex_elem_size;
@@ -1418,9 +1418,10 @@ Array RenderingServer::_get_array_from_surface(uint64_t p_format, Vector<uint8_t
 	const uint8_t *r = p_vertex_data.ptr();
 	const uint8_t *ar = p_attrib_data.ptr();
 	const uint8_t *sr = p_skin_data.ptr();
+	const uint64_t geometry_format = RSE::ARRAY_FORMAT_VERTEX | RSE::ARRAY_FORMAT_COLOR | RSE::ARRAY_FORMAT_BONES | RSE::ARRAY_FORMAT_WEIGHTS | RSE::ARRAY_FORMAT_INDEX;
 
 	for (int i = 0; i < RSE::ARRAY_MAX; i++) {
-		if (!(p_format & (1ULL << i))) {
+		if (!(p_format & (1ULL << i)) || (p_geometry_only && !(geometry_format & (1ULL << i)))) {
 			continue;
 		}
 
@@ -1448,8 +1449,8 @@ Array RenderingServer::_get_array_from_surface(uint64_t p_format, Vector<uint8_t
 						Vector3 *w = arr_3d.ptrw();
 
 						if (p_format & RSE::ARRAY_FLAG_COMPRESS_ATTRIBUTES) {
-							// We only have vertices to read, so just read them and skip everything else.
-							if (!(p_format & RSE::ARRAY_FORMAT_NORMAL)) {
+							// Geometry-only consumers do not need the coupled normal/tangent decode.
+							if (p_geometry_only || !(p_format & RSE::ARRAY_FORMAT_NORMAL)) {
 								for (int j = 0; j < p_vertex_len; j++) {
 									const uint16_t *v = reinterpret_cast<const uint16_t *>(&r[j * vertex_elem_size + offsets[i]]);
 									Vector3 vec = Vector3(float(v[0]) / 65535.0, float(v[1]) / 65535.0, float(v[2]) / 65535.0);
@@ -1724,6 +1725,12 @@ Array RenderingServer::mesh_surface_get_arrays(RID p_mesh, int p_surface) const
 	return mesh_create_arrays_from_surface_data(sd);
 }
 
+Array RenderingServer::mesh_surface_get_geometry_arrays(RID p_mesh, int p_surface) const {
+	RenderingServerTypes::SurfaceData sd = mesh_get_surface(p_mesh, p_surface);
+	ERR_FAIL_COND_V(sd.vertex_data.is_empty() && (sd.format & RSE::ARRAY_FORMAT_VERTEX), Array());
+	return _get_array_from_surface(sd.format, sd.vertex_data, sd.attribute_data, sd.skin_data, sd.vertex_count, sd.index_data, sd.index_count, sd.aabb, sd.uv_scale, true);
+}
+
 Dictionary RenderingServer::mesh_surface_get_lods(RID p_mesh, int p_surface) const {
 	RenderingServerTypes::SurfaceData sd = mesh_get_surface(p_mesh, p_surface);
 	ERR_FAIL_COND_V(sd.vertex_count == 0, Dictionary());
@@ -1759,6 +1766,14 @@ Dictionary RenderingServer::mesh_surface_get_lods(RID p_mesh, int p_surface) con
 }
 
 TypedArray<Array> RenderingServer::mesh_surface_get_blend_shape_arrays(RID p_mesh, int p_surface) const {
+	return _mesh_surface_get_blend_shape_arrays(p_mesh, p_surface, false);
+}
+
+TypedArray<Array> RenderingServer::mesh_surface_get_geometry_blend_shape_arrays(RID p_mesh, int p_surface) const {
+	return _mesh_surface_get_blend_shape_arrays(p_mesh, p_surface, true);
+}
+
+TypedArray<Array> RenderingServer::_mesh_surface_get_blend_shape_arrays(RID p_mesh, int p_surface, bool p_geometry_only) const {
 	RenderingServerTypes::SurfaceData sd = mesh_get_surface(p_mesh, p_surface);
 	ERR_FAIL_COND_V(sd.vertex_count == 0, Array());
 
@@ -1786,7 +1801,7 @@ TypedArray<Array> RenderingServer::mesh_surface_get_blend_shape_arrays(RID p_mes
 		for (uint32_t i = 0; i < blend_shape_count; i++) {
 			Vector<uint8_t> bs_data = blend_shape_data.slice(i * divisor, (i + 1) * divisor);
 			Vector<uint8_t> unused;
-			blend_shape_array.set(i, _get_array_from_surface(bs_format, bs_data, unused, unused, sd.vertex_count, unused, 0, sd.aabb, sd.uv_scale));
+			blend_shape_array.set(i, _get_array_from_surface(bs_format, bs_data, unused, unused, sd.vertex_count, unused, 0, sd.aabb, sd.uv_scale, p_geometry_only));
 		}
 
 		return blend_shape_array;
@@ -2378,7 +2393,9 @@ void RenderingServer::_bind_methods() {
 	ClassDB::bind_method(D_METHOD("mesh_surface_get_material", "mesh", "surface"), &RenderingServer::mesh_surface_get_material);
 	ClassDB::bind_method(D_METHOD("mesh_get_surface", "mesh", "surface"), &RenderingServer::_mesh_get_surface);
 	ClassDB::bind_method(D_METHOD("mesh_surface_get_arrays", "mesh", "surface"), &RenderingServer::mesh_surface_get_arrays);
+	ClassDB::bind_method(D_METHOD("mesh_surface_get_geometry_arrays", "mesh", "surface"), &RenderingServer::mesh_surface_get_geometry_arrays);
 	ClassDB::bind_method(D_METHOD("mesh_surface_get_blend_shape_arrays", "mesh", "surface"), &RenderingServer::mesh_surface_get_blend_shape_arrays);
+	ClassDB::bind_method(D_METHOD("mesh_surface_get_geometry_blend_shape_arrays", "mesh", "surface"), &RenderingServer::mesh_surface_get_geometry_blend_shape_arrays);
 	ClassDB::bind_method(D_METHOD("mesh_get_surface_count", "mesh"), &RenderingServer::mesh_get_surface_count);
 	ClassDB::bind_method(D_METHOD("mesh_set_custom_aabb", "mesh", "aabb"), &RenderingServer::mesh_set_custom_aabb);
 	ClassDB::bind_method(D_METHOD("mesh_get_custom_aabb", "mesh"), &RenderingServer::mesh_get_custom_aabb);
diff --git a/servers/rendering/rendering_server.h b/servers/rendering/rendering_server.h
index 40df03400e08b1bec76b510a6625b4c37a4edb98..0936148803a40128d6e2b23855e03ab044ed7998 100644
--- a/servers/rendering/rendering_server.h
+++ b/servers/rendering/rendering_server.h
@@ -69,7 +69,8 @@ class RenderingServer : public Object {
 	int mm_policy = 0;
 	bool render_loop_enabled = true;
 
-	Array _get_array_from_surface(uint64_t p_format, Vector<uint8_t> p_vertex_data, Vector<uint8_t> p_attrib_data, Vector<uint8_t> p_skin_data, int p_vertex_len, Vector<uint8_t> p_index_data, int p_index_len, const AABB &p_aabb, const Vector4 &p_uv_scale) const;
+	Array _get_array_from_surface(uint64_t p_format, Vector<uint8_t> p_vertex_data, Vector<uint8_t> p_attrib_data, Vector<uint8_t> p_skin_data, int p_vertex_len, Vector<uint8_t> p_index_data, int p_index_len, const AABB &p_aabb, const Vector4 &p_uv_scale, bool p_geometry_only = false) const;
+	TypedArray<Array> _mesh_surface_get_blend_shape_arrays(RID p_mesh, int p_surface, bool p_geometry_only) const;
 
 	const Vector2 SMALL_VEC2 = Vector2(CMP_EPSILON, CMP_EPSILON);
 	const Vector3 SMALL_VEC3 = Vector3(CMP_EPSILON, CMP_EPSILON, CMP_EPSILON);
@@ -211,7 +212,9 @@ public:
 	virtual Error mesh_create_surface_data_from_arrays(RenderingServerTypes::SurfaceData *r_surface_data, RSE::PrimitiveType p_primitive, const Array &p_arrays, const Array &p_blend_shapes = Array(), const Dictionary &p_lods = Dictionary(), uint64_t p_compress_format = 0);
 	Array mesh_create_arrays_from_surface_data(const RenderingServerTypes::SurfaceData &p_data) const;
 	Array mesh_surface_get_arrays(RID p_mesh, int p_surface) const;
+	Array mesh_surface_get_geometry_arrays(RID p_mesh, int p_surface) const;
 	TypedArray<Array> mesh_surface_get_blend_shape_arrays(RID p_mesh, int p_surface) const;
+	TypedArray<Array> mesh_surface_get_geometry_blend_shape_arrays(RID p_mesh, int p_surface) const;
 	Dictionary mesh_surface_get_lods(RID p_mesh, int p_surface) const;
 
 	virtual void mesh_add_surface_from_arrays(RID p_mesh, RSE::PrimitiveType p_primitive, const Array &p_arrays, const Array &p_blend_shapes = Array(), const Dictionary &p_lods = Dictionary(), BitField<RSE::ArrayFormat> p_compress_format = 0);

