From dc4089cb4f97e3424d5cb12c07441b9a852eb2cd Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Tue, 1 Sep 2026 12:45:01 +0800
Subject: [PATCH] fix(spine): harden mesh rendering boundaries

Godot-Patch-Topic: animation.spine-runtime
---
 modules/spine_godot/SpineSprite.cpp | 73 ++++++++++++++++++++++++-----
 modules/spine_godot/SpineSprite.h   |  2 +-
 2 files changed, 61 insertions(+), 14 deletions(-)

diff --git a/modules/spine_godot/SpineSprite.cpp b/modules/spine_godot/SpineSprite.cpp
index 9a9285f63b74111add54ab9074975fa7ce27d139..f935b71c04a4744c4bf843ee2b62982739ff6ca7 100644
--- a/modules/spine_godot/SpineSprite.cpp
+++ b/modules/spine_godot/SpineSprite.cpp
@@ -488,6 +488,10 @@ void SpineSprite::remove_meshes() {
 }
 
 void SpineSprite::sort_slot_nodes() {
+	if (skeleton.is_null() || !skeleton->get_spine_object()) {
+		return;
+	}
+
 	for (int i = 0; i < (int)slot_nodes.size(); i++) {
 		slot_nodes[i].setSize(0, nullptr);
 	}
@@ -504,14 +508,21 @@ void SpineSprite::sort_slot_nodes() {
 		if (!slot_node) {
 			continue;
 		}
-		if (slot_node->get_slot_index() == -1 || slot_node->get_slot_index() >= (int)draw_order.size()) {
+		if (slot_node->get_slot_index() < 0 || slot_node->get_slot_index() >= (int)slot_nodes.size()) {
 			continue;
 		}
 		slot_nodes[slot_node->get_slot_index()].add(slot_node);
 	}
 
-	for (int i = 0; i < (int)draw_order.size(); i++) {
+	const int draw_count = MIN((int)draw_order.size(), mesh_instances.size());
+	for (int i = 0; i < draw_count; i++) {
+		if (!draw_order[i] || !mesh_instances[i]) {
+			continue;
+		}
 		int slot_index = draw_order[i]->getData().getIndex();
+		if (slot_index < 0 || slot_index >= (int)slot_nodes.size()) {
+			continue;
+		}
 		int mesh_index = mesh_instances[i]->get_index();
 		spine::Vector<SpineSlotNode *> &nodes = slot_nodes[slot_index];
 		for (int j = 0; j < (int)nodes.size(); j++) {
@@ -716,12 +727,25 @@ void SpineSprite::update_skeleton(float delta) {
 }
 
 void SpineSprite::update_meshes(Ref<SpineSkeleton> skeleton_ref) {
+	if (skeleton_ref.is_null() || !skeleton_ref->get_spine_object()) {
+		return;
+	}
+
 	spine::Skeleton *spine_skeleton = skeleton_ref->get_spine_object();
-	for (int i = 0, n = (int)spine_skeleton->getSlots().size(); i < n; ++i) {
+	for (SpineMesh2D *mesh_instance : mesh_instances) {
+		if (mesh_instance) {
+			mesh_instance->renderer_object = nullptr;
+		}
+	}
+
+	const int slot_count = MIN((int)spine_skeleton->getDrawOrder().size(), mesh_instances.size());
+	for (int i = 0; i < slot_count; ++i) {
 		spine::Slot *slot = spine_skeleton->getDrawOrder()[i];
-		spine::Attachment *attachment = slot->getAttachment();
 		SpineMesh2D *mesh_instance = mesh_instances[i];
-		mesh_instance->renderer_object = nullptr;
+		if (!slot || !mesh_instance) {
+			continue;
+		}
+		spine::Attachment *attachment = slot->getAttachment();
 
 		if (!attachment) {
 			skeleton_clipper->clipEnd(*slot);
@@ -735,17 +759,22 @@ void SpineSprite::update_meshes(Ref<SpineSkeleton> skeleton_ref) {
 		spine::Color skeleton_color = spine_skeleton->getColor();
 		spine::Color slot_color = slot->getColor();
 		spine::Color tint(skeleton_color.r * slot_color.r, skeleton_color.g * slot_color.g, skeleton_color.b * slot_color.b, skeleton_color.a * slot_color.a);
-		SpineRendererObject *renderer_object;
+		SpineRendererObject *renderer_object = nullptr;
 		spine::Vector<float> *vertices = &scratch_vertices;
 		spine::Vector<float> *uvs;
 		spine::Vector<unsigned short> *indices;
 
 		if (attachment->getRTTI().isExactly(spine::RegionAttachment::rtti)) {
 			auto *region = (spine::RegionAttachment *)attachment;
+			auto *atlas_region = (spine::AtlasRegion *)region->getRegion();
+			if (!atlas_region || !atlas_region->page || !atlas_region->page->texture) {
+				skeleton_clipper->clipEnd(*slot);
+				continue;
+			}
 
 			vertices->setSize(8, 0);
 			region->computeWorldVertices(*slot, *vertices, 0);
-			renderer_object = (SpineRendererObject *)((spine::AtlasRegion *)region->getRegion())->page->texture;
+			renderer_object = (SpineRendererObject *)atlas_region->page->texture;
 			uvs = &region->getUVs();
 			indices = &quad_indices;
 
@@ -756,10 +785,15 @@ void SpineSprite::update_meshes(Ref<SpineSkeleton> skeleton_ref) {
 			tint.a *= attachment_color.a;
 		} else if (attachment->getRTTI().isExactly(spine::MeshAttachment::rtti)) {
 			auto *mesh = (spine::MeshAttachment *)attachment;
+			auto *atlas_region = (spine::AtlasRegion *)mesh->getRegion();
+			if (!atlas_region || !atlas_region->page || !atlas_region->page->texture) {
+				skeleton_clipper->clipEnd(*slot);
+				continue;
+			}
 
 			vertices->setSize(mesh->getWorldVerticesLength(), 0);
 			mesh->computeWorldVertices(*slot, *vertices);
-			renderer_object = (SpineRendererObject *)((spine::AtlasRegion *)mesh->getRegion())->page->texture;
+			renderer_object = (SpineRendererObject *)atlas_region->page->texture;
 			uvs = &mesh->getUVs();
 			indices = &mesh->getTriangles();
 
@@ -792,7 +826,11 @@ void SpineSprite::update_meshes(Ref<SpineSkeleton> skeleton_ref) {
 		if (indices->size() > 0) {
 			mesh_instance->set_light_mask(get_light_mask());
 			size_t num_vertices = vertices->size() / 2;
-			if (num_vertices == 0 || vertices->size() % 2 != 0 || uvs->size() != vertices->size() || !renderer_object) {
+			bool invalid_indices = indices->size() % 3 != 0;
+			for (int j = 0; !invalid_indices && j < (int)indices->size(); j++) {
+				invalid_indices = indices->buffer()[j] >= num_vertices;
+			}
+			if (num_vertices == 0 || vertices->size() % 2 != 0 || uvs->size() != vertices->size() || invalid_indices || !renderer_object) {
 				skeleton_clipper->clipEnd(*slot);
 				continue;
 			}
@@ -831,8 +869,9 @@ void SpineSprite::update_meshes(Ref<SpineSkeleton> skeleton_ref) {
 			Ref<Material> custom_material;
 
 			// See if we have a slot node for this slot with a custom material
-			auto &nodes = slot_nodes[slot->getData().getIndex()];
-			if (nodes.size() > 0) {
+			const int slot_index = slot->getData().getIndex();
+			if (slot_index >= 0 && slot_index < (int)slot_nodes.size() && slot_nodes[slot_index].size() > 0) {
+				auto &nodes = slot_nodes[slot_index];
 				auto slot_node = nodes[0];
 				if (slot_node) {
 					switch (blend_mode) {
@@ -884,10 +923,18 @@ void SpineSprite::update_meshes(Ref<SpineSkeleton> skeleton_ref) {
 
 void createLinesFromMesh(Vector<Vector2> &scratch_points, spine::Vector<unsigned short> &triangles, spine::Vector<float> *vertices) {
 	scratch_points.resize(0);
-	for (int i = 0; i < triangles.size(); i += 3) {
+	if (!vertices || vertices->size() == 0 || vertices->size() % 2 != 0) {
+		return;
+	}
+
+	const size_t vertex_count = vertices->size() / 2;
+	for (int i = 0; i + 2 < (int)triangles.size(); i += 3) {
 		int i1 = triangles[i];
 		int i2 = triangles[i + 1];
 		int i3 = triangles[i + 2];
+		if (i1 >= (int)vertex_count || i2 >= (int)vertex_count || i3 >= (int)vertex_count) {
+			continue;
+		}
 		Vector2 v1(vertices->buffer()[i1 * 2], vertices->buffer()[i1 * 2 + 1]);
 		Vector2 v2(vertices->buffer()[i2 * 2], vertices->buffer()[i2 * 2 + 1]);
 		Vector2 v3(vertices->buffer()[i3 * 2], vertices->buffer()[i3 * 2 + 1]);
@@ -901,7 +948,7 @@ void createLinesFromMesh(Vector<Vector2> &scratch_points, spine::Vector<unsigned
 }
 
 void SpineSprite::draw() {
-	if (!animation_state.is_valid() && !skeleton.is_valid()) {
+	if (skeleton.is_null() || !skeleton->get_spine_object() || !get_tree()) {
 		return;
 	}
 	if (!Engine::get_singleton()->is_editor_hint() && !get_tree()->is_debugging_collisions_hint()) {
diff --git a/modules/spine_godot/SpineSprite.h b/modules/spine_godot/SpineSprite.h
index f939013a2004fa7d0314142236a45f5038c6ec8e..72e0ab649979835249a502a84ed5f6115255dd88 100644
--- a/modules/spine_godot/SpineSprite.h
+++ b/modules/spine_godot/SpineSprite.h
@@ -86,7 +86,7 @@ public:
 	SpineMesh2D() :
 			renderer_object(nullptr), indices_changed(true), num_vertices(0), num_indices(0), vertex_stride(0), attribute_stride(0){};
 	~SpineMesh2D() {
-		if (mesh.is_valid()) {
+		if (mesh.is_valid() && RS::get_singleton()) {
 			RS::get_singleton()->free_rid(mesh);
 		}
 	}

