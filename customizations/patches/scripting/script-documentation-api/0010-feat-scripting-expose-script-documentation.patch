index e22e2485e31c13301bc01b6e9d8c208f0a706d28..910adfb1a80a37f3a74eb2a957b14c60add911ae 100644
--- a/core/object/script_language.h
+++ b/core/object/script_language.h
@@ -133,6 +133,7 @@ protected:
 	TypedArray<Dictionary> _get_script_property_list();
 	TypedArray<Dictionary> _get_script_method_list();
 	TypedArray<Dictionary> _get_script_signal_list();
+	TypedArray<Dictionary> _get_script_documentation_list();
 	Dictionary _get_script_constant_map();
 
 	void _set_debugger_break_language();
diff --git a/doc/classes/Script.xml b/doc/classes/Script.xml
index 1b2252461c1cfbdf5381b75e38fd1216c4590b87..a3b483c4da5bcdaef284f653679fc4500dae3bce 100644
--- a/doc/classes/Script.xml
+++ b/doc/classes/Script.xml
@@ -71,6 +71,13 @@
 				Returns a dictionary containing constant names and their values.
 			</description>
 		</method>
+		<method name="get_script_documentation_list">
+			<return type="Dictionary[]" />
+			<description>
+				Returns structured documentation for this script and its inner classes. Each dictionary contains the class [code]name[/code], [code]inherits[/code], descriptions, tutorials, enums, constants, signals, variables, and methods.
+				Signal and method entries include their arguments. This method returns an empty array outside editor builds.
+			</description>
+		</method>
 		<method name="get_script_method_list">
 			<return type="Dictionary[]" />
 			<description>
