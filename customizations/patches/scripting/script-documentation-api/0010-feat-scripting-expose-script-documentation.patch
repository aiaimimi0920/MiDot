From dfb6dc26b39b98e68ad7a95980b78e379d96ad01 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Sun, 30 Aug 2026 19:26:59 +0800
Subject: [PATCH] feat(scripting): expose script documentation

Restore the legacy structured documentation API without changing modern DocData internals.

Godot-Patch-Topic: scripting.script-documentation-api
---
 core/object/script_language.cpp               | 104 ++++++++++++++++++
 core/object/script_language.h                 |   1 +
 doc/classes/Script.xml                        |   7 ++
 .../gdscript/test_script_documentation.cpp    | 101 +++++++++++++++++
 4 files changed, 213 insertions(+)
 create mode 100644 tests/modules/gdscript/test_script_documentation.cpp

diff --git a/core/object/script_language.cpp b/core/object/script_language.cpp
index 7a5e998e667aea77975f278240a69555a7193824..e0d1783494eebeeede3214e4fc5833942325ccdd 100644
--- a/core/object/script_language.cpp
+++ b/core/object/script_language.cpp
@@ -160,6 +160,109 @@ PropertyInfo Script::get_class_category() const {
 
 #endif // TOOLS_ENABLED
 
+TypedArray<Dictionary> Script::_get_script_documentation_list() {
+	TypedArray<Dictionary> result;
+
+#ifdef TOOLS_ENABLED
+	for (const DocData::ClassDoc &class_doc : get_documentation()) {
+		Dictionary class_dict;
+		class_dict["name"] = class_doc.name;
+		class_dict["inherits"] = class_doc.inherits;
+		class_dict["brief_description"] = class_doc.brief_description.strip_edges();
+		class_dict["description"] = class_doc.description.strip_edges();
+
+		TypedArray<Dictionary> tutorials;
+		for (const DocData::TutorialDoc &tutorial_doc : class_doc.tutorials) {
+			Dictionary tutorial;
+			tutorial["title"] = tutorial_doc.title;
+			tutorial["link"] = tutorial_doc.link;
+			tutorials.push_back(tutorial);
+		}
+		class_dict["tutorials"] = tutorials;
+
+		TypedArray<Dictionary> enums;
+		for (const KeyValue<String, DocData::EnumDoc> &E : class_doc.enums) {
+			Dictionary enumeration;
+			enumeration["name"] = E.key;
+			enumeration["description"] = E.value.description.strip_edges();
+			enums.push_back(enumeration);
+		}
+		class_dict["enums"] = enums;
+
+		TypedArray<Dictionary> constants;
+		for (const DocData::ConstantDoc &constant_doc : class_doc.constants) {
+			Dictionary constant;
+			constant["name"] = constant_doc.name;
+			constant["value"] = constant_doc.value;
+			constant["enumeration"] = constant_doc.enumeration;
+			constant["description"] = constant_doc.description.strip_edges();
+			constants.push_back(constant);
+		}
+		class_dict["constants"] = constants;
+
+		TypedArray<Dictionary> signals;
+		for (const DocData::MethodDoc &signal_doc : class_doc.signals) {
+			Dictionary signal;
+			signal["name"] = signal_doc.name;
+			signal["return_type"] = signal_doc.return_type;
+			signal["qualifiers"] = signal_doc.qualifiers;
+			signal["description"] = signal_doc.description.strip_edges();
+
+			TypedArray<Dictionary> arguments;
+			for (const DocData::ArgumentDoc &argument_doc : signal_doc.arguments) {
+				Dictionary argument;
+				argument["name"] = argument_doc.name;
+				argument["type"] = argument_doc.type.is_empty() ? String("Variant") : argument_doc.type;
+				argument["default_value"] = argument_doc.default_value;
+				arguments.push_back(argument);
+			}
+			signal["arguments"] = arguments;
+			signals.push_back(signal);
+		}
+		class_dict["signals"] = signals;
+
+		TypedArray<Dictionary> variables;
+		for (const DocData::PropertyDoc &property_doc : class_doc.properties) {
+			Dictionary variable;
+			variable["name"] = property_doc.name;
+			variable["type"] = property_doc.type;
+			variable["enumeration"] = property_doc.enumeration;
+			variable["description"] = property_doc.description.strip_edges();
+			variable["default_value"] = property_doc.default_value;
+			variable["setter"] = property_doc.setter;
+			variable["getter"] = property_doc.getter;
+			variables.push_back(variable);
+		}
+		class_dict["variables"] = variables;
+
+		TypedArray<Dictionary> methods;
+		for (const DocData::MethodDoc &method_doc : class_doc.methods) {
+			Dictionary method;
+			method["name"] = method_doc.name;
+			method["return_type"] = method_doc.return_type;
+			method["qualifiers"] = method_doc.qualifiers;
+			method["description"] = method_doc.description.strip_edges();
+
+			TypedArray<Dictionary> arguments;
+			for (const DocData::ArgumentDoc &argument_doc : method_doc.arguments) {
+				Dictionary argument;
+				argument["name"] = argument_doc.name;
+				argument["type"] = argument_doc.type;
+				argument["default_value"] = argument_doc.default_value;
+				arguments.push_back(argument);
+			}
+			method["arguments"] = arguments;
+			methods.push_back(method);
+		}
+		class_dict["methods"] = methods;
+
+		result.push_back(class_dict);
+	}
+#endif // TOOLS_ENABLED
+
+	return result;
+}
+
 void Script::_bind_methods() {
 	ClassDB::bind_method(D_METHOD("can_instantiate"), &Script::can_instantiate);
 	//ClassDB::bind_method(D_METHOD("instance_create","base_object"),&Script::instance_create);
@@ -178,6 +281,7 @@ void Script::_bind_methods() {
 	ClassDB::bind_method(D_METHOD("get_script_property_list"), &Script::_get_script_property_list);
 	ClassDB::bind_method(D_METHOD("get_script_method_list"), &Script::_get_script_method_list);
 	ClassDB::bind_method(D_METHOD("get_script_signal_list"), &Script::_get_script_signal_list);
+	ClassDB::bind_method(D_METHOD("get_script_documentation_list"), &Script::_get_script_documentation_list);
 	ClassDB::bind_method(D_METHOD("get_script_constant_map"), &Script::_get_script_constant_map);
 	ClassDB::bind_method(D_METHOD("get_property_default_value", "property"), &Script::_get_property_default_value);
 
