 modules/gdscript/gdscript_editor.cpp          |  15 +-
 modules/gdscript/gdscript_helper.cpp          | 199 ++++++++++++++++++
 modules/gdscript/gdscript_helper.h            |  98 +++++++++
 modules/gdscript/register_types.cpp           |   6 +
 5 files changed, 420 insertions(+), 7 deletions(-)
 create mode 100644 modules/gdscript/doc_classes/GDScriptHelper.xml
 create mode 100644 modules/gdscript/gdscript_helper.cpp
 create mode 100644 modules/gdscript/gdscript_helper.h

diff --git a/modules/gdscript/doc_classes/GDScriptHelper.xml b/modules/gdscript/doc_classes/GDScriptHelper.xml
new file mode 100644
index 0000000000000000000000000000000000000000..92cbf86862a598cdc7b1c3c014870c94598ab977
--- /dev/null
+++ b/modules/gdscript/doc_classes/GDScriptHelper.xml
@@ -0,0 +1,109 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="GDScriptHelper" inherits="RefCounted" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
+	<brief_description>
+		Exposes GDScript editor-language analysis to scripts.
+	</brief_description>
+	<description>
+		[GDScriptHelper] validates GDScript source, returns its function outline, requests code completion, and resolves symbols without opening the script editor.
+		[b]Note:[/b] This class is available only in editor builds. Completion and context-sensitive lookup source must contain [code]String.chr(0xffff)[/code] at the cursor position.
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+		<method name="get_completion_hint" qualifiers="const">
+			<return type="String" />
+			<description>
+				Returns the call hint produced by the last successful [method set_completion_code] request.
+			</description>
+		</method>
+		<method name="get_completion_options" qualifiers="const">
+			<return type="Dictionary[]" />
+			<description>
+				Returns completion dictionaries from the last [method set_completion_code] request. Each dictionary contains [code]type[/code], [code]display_text[/code], [code]insert_text[/code], and [code]default_value[/code].
+			</description>
+		</method>
+		<method name="get_errors" qualifiers="const">
+			<return type="Dictionary[]" />
+			<description>
+				Returns validation errors from the last [method set_validate_code] request. Each dictionary contains zero-based [code]line[/code] and [code]column[/code] values and a [code]message[/code].
+			</description>
+		</method>
+		<method name="get_functions" qualifiers="const">
+			<return type="Dictionary" />
+			<description>
+				Returns a dictionary that maps function names to zero-based declaration lines from the last successful [method set_validate_code] request.
+			</description>
+		</method>
+		<method name="has_completion_hint" qualifiers="const">
+			<return type="bool" />
+			<description>
+				Returns [code]true[/code] if the last completion request produced a call hint.
+			</description>
+		</method>
+		<method name="has_completion_options" qualifiers="const">
+			<return type="bool" />
+			<description>
+				Returns [code]true[/code] if the last completion request produced at least one option.
+			</description>
+		</method>
+		<method name="has_errors" qualifiers="const">
+			<return type="bool" />
+			<description>
+				Returns [code]true[/code] if the last validation request produced at least one error.
+			</description>
+		</method>
+		<method name="has_functions" qualifiers="const">
+			<return type="bool" />
+			<description>
+				Returns [code]true[/code] if the last successful validation request found at least one function.
+			</description>
+		</method>
+		<method name="is_completion_forced" qualifiers="const">
+			<return type="bool" />
+			<description>
+				Returns whether completion should take priority over the call hint for the last request.
+			</description>
+		</method>
+		<method name="lookup_code">
+			<return type="Dictionary" />
+			<param index="0" name="code" type="String" />
+			<param index="1" name="symbol" type="String" />
+			<param index="2" name="script_path" type="String" default="&quot;&quot;" />
+			<param index="3" name="script_owner" type="Object" default="null" />
+			<description>
+				Resolves [param symbol] in [param code]. On success, returns a dictionary containing [code]type[/code], [code]script[/code], [code]class_name[/code], [code]class_member[/code], [code]class_path[/code], and [code]location[/code]. Returns an empty dictionary if the symbol cannot be resolved.
+			</description>
+		</method>
+		<method name="set_completion_code">
+			<return type="int" enum="Error" />
+			<param index="0" name="code" type="String" />
+			<param index="1" name="script_path" type="String" default="&quot;&quot;" />
+			<param index="2" name="script_owner" type="Object" default="null" />
+			<description>
+				Analyzes [param code] and stores its completion options and call hint. The source must contain [code]String.chr(0xffff)[/code] at the cursor position.
+			</description>
+		</method>
+		<method name="set_validate_code">
+			<return type="bool" />
+			<param index="0" name="code" type="String" />
+			<param index="1" name="script_path" type="String" default="&quot;&quot;" />
+			<description>
+				Validates [param code], stores its errors and function outline, and returns [code]true[/code] if the source has no errors.
+			</description>
+		</method>
+	</methods>
+	<constants>
+		<constant name="LOOKUP_RESULT_SCRIPT_LOCATION" value="0" enum="LookupResultType" />
+		<constant name="LOOKUP_RESULT_CLASS" value="1" enum="LookupResultType" />
+		<constant name="LOOKUP_RESULT_CLASS_CONSTANT" value="2" enum="LookupResultType" />
+		<constant name="LOOKUP_RESULT_CLASS_PROPERTY" value="3" enum="LookupResultType" />
+		<constant name="LOOKUP_RESULT_CLASS_METHOD" value="4" enum="LookupResultType" />
+		<constant name="LOOKUP_RESULT_CLASS_SIGNAL" value="5" enum="LookupResultType" />
+		<constant name="LOOKUP_RESULT_CLASS_ENUM" value="6" enum="LookupResultType" />
+		<constant name="LOOKUP_RESULT_CLASS_TBD_GLOBALSCOPE" value="7" enum="LookupResultType" is_deprecated="true" />
+		<constant name="LOOKUP_RESULT_CLASS_ANNOTATION" value="8" enum="LookupResultType" />
+		<constant name="LOOKUP_RESULT_LOCAL_CONSTANT" value="9" enum="LookupResultType" />
+		<constant name="LOOKUP_RESULT_LOCAL_VARIABLE" value="10" enum="LookupResultType" />
+		<constant name="LOOKUP_RESULT_MAX" value="11" enum="LookupResultType" />
+	</constants>
+</class>
