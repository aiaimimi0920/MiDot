+
+#include "modules/gdscript/editor/gdscript_editor_language.h"
+#endif
+
+namespace TestGDScriptHelper {
+
+TEST_CASE("[GDScriptHelper] Runtime typed defaults coexist with the public helper") {
+	GDScriptDataType element_type;
+	element_type.kind = GDScriptDataType::BUILTIN;
+	element_type.builtin_type = Variant::INT;
+	GDScriptDataType array_type;
+	array_type.kind = GDScriptDataType::BUILTIN;
+	array_type.builtin_type = Variant::ARRAY;
+	array_type.set_container_element_type(0, element_type);
+	const Array array = GDScriptRuntimeHelper::construct_empty_value_for_data_type(array_type);
+	CHECK(array.is_empty());
+	CHECK(array.get_typed_builtin() == Variant::INT);
+	CHECK(GDScriptRuntimeHelper::construct_empty_value_for_data_type(element_type) == Variant(0));
+
+	GDScriptDataType key_type;
+	key_type.kind = GDScriptDataType::BUILTIN;
+	key_type.builtin_type = Variant::STRING;
+	GDScriptDataType dictionary_type;
+	dictionary_type.kind = GDScriptDataType::BUILTIN;
+	dictionary_type.builtin_type = Variant::DICTIONARY;
+	dictionary_type.set_container_element_type(0, key_type);
+	dictionary_type.set_container_element_type(1, element_type);
+	const Dictionary dictionary = GDScriptRuntimeHelper::construct_empty_value_for_data_type(dictionary_type);
+	CHECK(dictionary.is_empty());
+	CHECK(dictionary.get_typed_key_builtin() == Variant::STRING);
+	CHECK(dictionary.get_typed_value_builtin() == Variant::INT);
+}
+
+#ifdef TOOLS_ENABLED
+
+TEST_CASE("[GDScriptHelper] Headless validation completion and lookup preserve the API") {
+	GDScriptLanguage::get_singleton()->init();
+	GDScriptEditorLanguage *original_language = GDScriptEditorLanguage::get_singleton();
+	REQUIRE(original_language == nullptr);
+	REQUIRE(EditorSettings::get_singleton() == nullptr);
+	Ref<GDScriptHelper> helper = memnew(GDScriptHelper);
+	CHECK(helper->set_validate_code("extends RefCounted\nfunc sample():\n\tpass\n"));
+	CHECK_FALSE(helper->has_errors());
+	CHECK(helper->has_functions());
+	CHECK(helper->get_functions().has("sample"));
+	CHECK(GDScriptEditorLanguage::get_singleton() == original_language);
+
+	CHECK_FALSE(helper->set_validate_code("func broken(:\n"));
+	REQUIRE(helper->has_errors());
+	const Dictionary error = helper->get_errors()[0];
+	CHECK(error.has("line"));
+	CHECK(error.has("column"));
+	CHECK(error.has("message"));
+	CHECK(int(error["line"]) == 0);
+
+	const String code = "extends RefCounted\nfunc sample():\n\tvar local_value: int = 1\n\tloc" + String::chr(0xFFFF) + "\n";
+	REQUIRE(helper->set_completion_code(code) == OK);
+	REQUIRE(helper->has_completion_options());
+	bool found_local = false;
+	for (const Dictionary &option : helper->get_completion_options()) {
+		CHECK(option.has("type"));
+		CHECK(option.has("display_text"));
+		CHECK(option.has("insert_text"));
+		CHECK(option.has("default_value"));
+		if (option["display_text"] == String("local_value")) {
+			found_local = true;
+			CHECK(int(option["type"]) == 3); // Existing CodeEdit variable kind.
+		}
+	}
+	CHECK(found_local);
+	CHECK(GDScriptEditorLanguage::get_singleton() == original_language);
+
+	const Dictionary lookup = helper->lookup_code("extends " + String::chr(0xFFFF) + "RefCounted\n", "RefCounted");
+	REQUIRE(lookup.has("type"));
+	CHECK(int(lookup["type"]) == GDScriptHelper::LOOKUP_RESULT_CLASS);
+	CHECK(lookup["class_name"] == String("RefCounted"));
+	CHECK(lookup.has("script"));
+	CHECK(lookup.has("class_member"));
+	CHECK(lookup.has("class_path"));
+	CHECK(lookup.has("location"));
+	CHECK(GDScriptEditorLanguage::get_singleton() == original_language);
+	const Dictionary local_lookup = helper->lookup_code("extends RefCounted\nfunc sample():\n\tvar local_value: int = 1\n\t" + String::chr(0xFFFF) + "local_value\n", "local_value");
+	REQUIRE(local_lookup.has("type"));
+	CHECK(int(local_lookup["type"]) == GDScriptHelper::LOOKUP_RESULT_LOCAL_VARIABLE);
+	CHECK(int(local_lookup["location"]) == 3);
+
+	REQUIRE(helper->set_completion_code("extends Node\nfunc _rea" + String::chr(0xFFFF) + "\n") == OK);
+	bool found_ready = false;
+	for (const Dictionary &option : helper->get_completion_options()) {
+		if (String(option["display_text"]).begins_with("_ready(")) {
+			found_ready = true;
+		}
+	}
+	CHECK(found_ready);
+	CHECK(GDScriptEditorLanguage::get_singleton() == original_language);
+}
+
+TEST_CASE("[GDScriptHelper] Existing editor language is borrowed without replacement") {
+	REQUIRE(GDScriptEditorLanguage::get_singleton() == nullptr);
+	GDScriptLanguage::get_singleton()->init();
+	{
+		GDScriptEditorLanguage editor_language;
+		Ref<GDScriptHelper> helper = memnew(GDScriptHelper);
+		CHECK(helper->set_validate_code("extends RefCounted\nfunc sample():\n\tpass\n"));
+		CHECK(GDScriptEditorLanguage::get_singleton() == &editor_language);
+		CHECK(helper->set_completion_code("extends Node\nfunc _rea" + String::chr(0xFFFF) + "\n") == OK);
+		CHECK(GDScriptEditorLanguage::get_singleton() == &editor_language);
+		CHECK(helper->lookup_code("", "Node").has("type"));
+		CHECK(GDScriptEditorLanguage::get_singleton() == &editor_language);
+	}
+	CHECK(GDScriptEditorLanguage::get_singleton() == nullptr);
+}
+
+#endif // TOOLS_ENABLED
+
+} // namespace TestGDScriptHelper
+
+#endif // MODULE_GDSCRIPT_ENABLED

