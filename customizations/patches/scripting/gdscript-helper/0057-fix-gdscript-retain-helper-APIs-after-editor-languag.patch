From c2b50b21a6594cde1338f4cf4c1478da8a6f2a9f Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Thu, 22 Oct 2026 23:44:12 +0800
Subject: [PATCH] fix(gdscript): retain helper APIs after editor language split

Keep the public helper available to headless tools while using the upstream EditorLanguage API and scoped editor-language lifetime. Cover typed runtime defaults, validation, completion and symbol lookup.

Godot-Patch-Topic: scripting.gdscript-helper
---
 modules/gdscript/gdscript_editor.cpp          |   2 +-
 modules/gdscript/gdscript_helper.cpp          |  39 ++++-
 .../modules/gdscript/test_gdscript_helper.cpp | 161 ++++++++++++++++++
 3 files changed, 194 insertions(+), 8 deletions(-)
 create mode 100644 tests/modules/gdscript/test_gdscript_helper.cpp

diff --git a/modules/gdscript/gdscript_editor.cpp b/modules/gdscript/gdscript_editor.cpp
index b7dc9768988d4f7c5e20cb8edc1610c072396d32..6c914e5f7a215e0357f1aa2037ce56a04db496bb 100644
--- a/modules/gdscript/gdscript_editor.cpp
+++ b/modules/gdscript/gdscript_editor.cpp
@@ -3847,7 +3847,7 @@ static void _find_call_arguments(GDScriptParser::CompletionContext &p_context, c
 				break;
 			}
 
-			const bool type_hints = EditorSettings::get_singleton()->get_setting("text_editor/completion/add_type_hints");
+			const bool type_hints = EditorSettings::get_singleton() == nullptr || bool(EDITOR_GET("text_editor/completion/add_type_hints"));
 
 			List<MethodInfo> virtual_methods;
 			if (is_static) {
diff --git a/modules/gdscript/gdscript_helper.cpp b/modules/gdscript/gdscript_helper.cpp
index f8f5bbbdbf75c18cffb9e295e50246874d180a46..6070b8307978d969a37d723855500695a3e51e69 100644
--- a/modules/gdscript/gdscript_helper.cpp
+++ b/modules/gdscript/gdscript_helper.cpp
@@ -75,7 +75,35 @@ Variant construct_empty_value_for_data_type(const GDScriptDataType &p_data_type)
 
 #include "core/io/resource_loader.h"
 #include "core/object/class_db.h"
-#include "gdscript_editor.h"
+#include "core/os/mutex.h"
+#include "editor/gdscript_editor_language.h"
+
+namespace {
+
+Mutex analysis_language_mutex;
+
+// EditorLanguage is normally initialized only for the editor. Keep the helper
+// available to headless tools without retaining a singleton across editor startup.
+class ScopedGDScriptEditorLanguage {
+	MutexLock<Mutex> language_lock{ analysis_language_mutex };
+	GDScriptEditorLanguage *language = GDScriptEditorLanguage::get_singleton();
+	bool owns_language = language == nullptr;
+
+public:
+	ScopedGDScriptEditorLanguage() {
+		if (owns_language) {
+			language = memnew(GDScriptEditorLanguage);
+		}
+	}
+	~ScopedGDScriptEditorLanguage() {
+		if (owns_language) {
+			memdelete(language);
+		}
+	}
+	GDScriptEditorLanguage *operator->() const { return language; }
+};
+
+} // namespace
 
 void GDScriptHelper::_bind_methods() {
 	ClassDB::bind_method(D_METHOD("set_validate_code", "code", "script_path"), &GDScriptHelper::set_validate_code, DEFVAL(String()));
@@ -138,8 +166,7 @@ int GDScriptHelper::_get_completion_kind_priority(EditorLanguage::CompletionKind
 bool GDScriptHelper::set_validate_code(const String &p_code, const String &p_path) {
 	functions.clear();
 	errors.clear();
-	GDScriptEditorLanguage *language = GDScriptEditorLanguage::get_singleton();
-	ERR_FAIL_NULL_V(language, false);
+	ScopedGDScriptEditorLanguage language;
 	return language->validate(p_code, p_path, &errors, nullptr, &functions, nullptr);
 }
 
@@ -176,8 +203,7 @@ Error GDScriptHelper::set_completion_code(const String &p_code, const String &p_
 	completion_forced = false;
 	completion_hint.clear();
 
-	GDScriptEditorLanguage *language = GDScriptEditorLanguage::get_singleton();
-	ERR_FAIL_NULL_V(language, ERR_UNAVAILABLE);
+	ScopedGDScriptEditorLanguage language;
 	const Error error = language->complete_code(p_code, p_path, p_owner, &completion_options, completion_forced, completion_hint);
 	completion_options.sort_custom<CompletionOptionComparator>();
 	return error;
@@ -214,8 +240,7 @@ bool GDScriptHelper::is_completion_forced() const {
 
 Dictionary GDScriptHelper::lookup_code(const String &p_code, const String &p_symbol, const String &p_path, Object *p_owner) {
 	Dictionary result;
-	GDScriptEditorLanguage *language = GDScriptEditorLanguage::get_singleton();
-	ERR_FAIL_NULL_V(language, result);
+	ScopedGDScriptEditorLanguage language;
 
 	EditorLanguage::LookupResult lookup_result;
 	if (language->lookup_code(p_code, p_symbol, p_path, p_owner, lookup_result) != OK) {
