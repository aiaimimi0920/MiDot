From 88fe05c380c1c7d4977dc8bd3d96eca8d69cd960 Mon Sep 17 00:00:00 2001
From: aiaimimi0920 <153103332+aiaimimi0920@users.noreply.github.com>
Date: Fri, 23 Oct 2026 00:10:19 +0800
Subject: [PATCH] fix(gdscript): use the initialized upstream analysis service

Native execution confirms the editor-language module initializes in all tools builds, including headless tests and scripts. Borrow that service instead of introducing transient singleton ownership; assert the actual headless settings contract and prevent cascading test diagnostics.

Godot-Patch-Topic: scripting.gdscript-helper
---
 modules/gdscript/gdscript_helper.cpp          | 37 +++----------------
 .../modules/gdscript/test_gdscript_helper.cpp | 35 ++++++++++++++----
 2 files changed, 33 insertions(+), 39 deletions(-)

diff --git a/modules/gdscript/gdscript_helper.cpp b/modules/gdscript/gdscript_helper.cpp
index 6070b8307978d969a37d723855500695a3e51e69..38a9e41e2180cdedf28822a6c91af4736310adc0 100644
--- a/modules/gdscript/gdscript_helper.cpp
+++ b/modules/gdscript/gdscript_helper.cpp
@@ -75,36 +75,8 @@ Variant construct_empty_value_for_data_type(const GDScriptDataType &p_data_type)
 
 #include "core/io/resource_loader.h"
 #include "core/object/class_db.h"
-#include "core/os/mutex.h"
 #include "editor/gdscript_editor_language.h"
 
-namespace {
-
-Mutex analysis_language_mutex;
-
-// EditorLanguage is normally initialized only for the editor. Keep the helper
-// available to headless tools without retaining a singleton across editor startup.
-class ScopedGDScriptEditorLanguage {
-	MutexLock<Mutex> language_lock{ analysis_language_mutex };
-	GDScriptEditorLanguage *language = GDScriptEditorLanguage::get_singleton();
-	bool owns_language = language == nullptr;
-
-public:
-	ScopedGDScriptEditorLanguage() {
-		if (owns_language) {
-			language = memnew(GDScriptEditorLanguage);
-		}
-	}
-	~ScopedGDScriptEditorLanguage() {
-		if (owns_language) {
-			memdelete(language);
-		}
-	}
-	GDScriptEditorLanguage *operator->() const { return language; }
-};
-
-} // namespace
-
 void GDScriptHelper::_bind_methods() {
 	ClassDB::bind_method(D_METHOD("set_validate_code", "code", "script_path"), &GDScriptHelper::set_validate_code, DEFVAL(String()));
 	ClassDB::bind_method(D_METHOD("has_errors"), &GDScriptHelper::has_errors);
@@ -166,7 +138,8 @@ int GDScriptHelper::_get_completion_kind_priority(EditorLanguage::CompletionKind
 bool GDScriptHelper::set_validate_code(const String &p_code, const String &p_path) {
 	functions.clear();
 	errors.clear();
-	ScopedGDScriptEditorLanguage language;
+	GDScriptEditorLanguage *language = GDScriptEditorLanguage::get_singleton();
+	ERR_FAIL_NULL_V(language, false);
 	return language->validate(p_code, p_path, &errors, nullptr, &functions, nullptr);
 }
 
@@ -203,7 +176,8 @@ Error GDScriptHelper::set_completion_code(const String &p_code, const String &p_
 	completion_forced = false;
 	completion_hint.clear();
 
-	ScopedGDScriptEditorLanguage language;
+	GDScriptEditorLanguage *language = GDScriptEditorLanguage::get_singleton();
+	ERR_FAIL_NULL_V(language, ERR_UNAVAILABLE);
 	const Error error = language->complete_code(p_code, p_path, p_owner, &completion_options, completion_forced, completion_hint);
 	completion_options.sort_custom<CompletionOptionComparator>();
 	return error;
@@ -240,7 +214,8 @@ bool GDScriptHelper::is_completion_forced() const {
 
 Dictionary GDScriptHelper::lookup_code(const String &p_code, const String &p_symbol, const String &p_path, Object *p_owner) {
 	Dictionary result;
-	ScopedGDScriptEditorLanguage language;
+	GDScriptEditorLanguage *language = GDScriptEditorLanguage::get_singleton();
+	ERR_FAIL_NULL_V(language, result);
 
 	EditorLanguage::LookupResult lookup_result;
 	if (language->lookup_code(p_code, p_symbol, p_path, p_owner, lookup_result) != OK) {
diff --git a/tests/modules/gdscript/test_gdscript_helper.cpp b/tests/modules/gdscript/test_gdscript_helper.cpp
index d71745a1808dbf1dfc3d7da2b70bb31e2d2fd242..9850934eb71c0792a3d06916a6b016d9f768579d 100644
--- a/tests/modules/gdscript/test_gdscript_helper.cpp
+++ b/tests/modules/gdscript/test_gdscript_helper.cpp
@@ -79,7 +79,10 @@ TEST_CASE("[GDScriptHelper] Runtime typed defaults coexist with the public helpe
 TEST_CASE("[GDScriptHelper] Headless validation completion and lookup preserve the API") {
 	GDScriptLanguage::get_singleton()->init();
 	GDScriptEditorLanguage *original_language = GDScriptEditorLanguage::get_singleton();
-	REQUIRE(original_language == nullptr);
+	REQUIRE(original_language != nullptr);
+	if (original_language == nullptr) {
+		return;
+	}
 	REQUIRE(EditorSettings::get_singleton() == nullptr);
 	Ref<GDScriptHelper> helper = memnew(GDScriptHelper);
 	CHECK(helper->set_validate_code("extends RefCounted\nfunc sample():\n\tpass\n"));
@@ -90,6 +93,9 @@ TEST_CASE("[GDScriptHelper] Headless validation completion and lookup preserve t
 
 	CHECK_FALSE(helper->set_validate_code("func broken(:\n"));
 	REQUIRE(helper->has_errors());
+	if (!helper->has_errors()) {
+		return;
+	}
 	const Dictionary error = helper->get_errors()[0];
 	CHECK(error.has("line"));
 	CHECK(error.has("column"));
@@ -97,7 +103,11 @@ TEST_CASE("[GDScriptHelper] Headless validation completion and lookup preserve t
 	CHECK(int(error["line"]) == 0);
 
 	const String code = "extends RefCounted\nfunc sample():\n\tvar local_value: int = 1\n\tloc" + String::chr(0xFFFF) + "\n";
-	REQUIRE(helper->set_completion_code(code) == OK);
+	const Error completion_error = helper->set_completion_code(code);
+	REQUIRE(completion_error == OK);
+	if (completion_error != OK) {
+		return;
+	}
 	REQUIRE(helper->has_completion_options());
 	bool found_local = false;
 	for (const Dictionary &option : helper->get_completion_options()) {
@@ -115,6 +125,9 @@ TEST_CASE("[GDScriptHelper] Headless validation completion and lookup preserve t
 
 	const Dictionary lookup = helper->lookup_code("extends " + String::chr(0xFFFF) + "RefCounted\n", "RefCounted");
 	REQUIRE(lookup.has("type"));
+	if (!lookup.has("type")) {
+		return;
+	}
 	CHECK(int(lookup["type"]) == GDScriptHelper::LOOKUP_RESULT_CLASS);
 	CHECK(lookup["class_name"] == String("RefCounted"));
 	CHECK(lookup.has("script"));
@@ -124,6 +137,9 @@ TEST_CASE("[GDScriptHelper] Headless validation completion and lookup preserve t
 	CHECK(GDScriptEditorLanguage::get_singleton() == original_language);
 	const Dictionary local_lookup = helper->lookup_code("extends RefCounted\nfunc sample():\n\tvar local_value: int = 1\n\t" + String::chr(0xFFFF) + "local_value\n", "local_value");
 	REQUIRE(local_lookup.has("type"));
+	if (!local_lookup.has("type")) {
+		return;
+	}
 	CHECK(int(local_lookup["type"]) == GDScriptHelper::LOOKUP_RESULT_LOCAL_VARIABLE);
 	CHECK(int(local_lookup["location"]) == 3);
 
@@ -139,19 +155,22 @@ TEST_CASE("[GDScriptHelper] Headless validation completion and lookup preserve t
 }
 
 TEST_CASE("[GDScriptHelper] Existing editor language is borrowed without replacement") {
-	REQUIRE(GDScriptEditorLanguage::get_singleton() == nullptr);
+	GDScriptEditorLanguage *original_language = GDScriptEditorLanguage::get_singleton();
+	REQUIRE(original_language != nullptr);
+	if (original_language == nullptr) {
+		return;
+	}
 	GDScriptLanguage::get_singleton()->init();
 	{
-		GDScriptEditorLanguage editor_language;
 		Ref<GDScriptHelper> helper = memnew(GDScriptHelper);
 		CHECK(helper->set_validate_code("extends RefCounted\nfunc sample():\n\tpass\n"));
-		CHECK(GDScriptEditorLanguage::get_singleton() == &editor_language);
+		CHECK(GDScriptEditorLanguage::get_singleton() == original_language);
 		CHECK(helper->set_completion_code("extends Node\nfunc _rea" + String::chr(0xFFFF) + "\n") == OK);
-		CHECK(GDScriptEditorLanguage::get_singleton() == &editor_language);
+		CHECK(GDScriptEditorLanguage::get_singleton() == original_language);
 		CHECK(helper->lookup_code("", "Node").has("type"));
-		CHECK(GDScriptEditorLanguage::get_singleton() == &editor_language);
+		CHECK(GDScriptEditorLanguage::get_singleton() == original_language);
 	}
-	CHECK(GDScriptEditorLanguage::get_singleton() == nullptr);
+	CHECK(GDScriptEditorLanguage::get_singleton() == original_language);
 }
 
 #endif // TOOLS_ENABLED

