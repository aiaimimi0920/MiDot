index 0000000000000000000000000000000000000000..2fc656a7508ef13f1934ad40bbc0110816606098
--- /dev/null
+++ b/thirdparty/spout-library/Binaries/x64/SpoutLibrary.h
@@ -0,0 +1,613 @@
+//
+//	SpoutLibrary.dll
+//
+//	Spout SDK dll compatible with any C++ compiler
+//
+/*
+		Copyright (c) 2016-2025, Lynn Jarvis. All rights reserved.
+
