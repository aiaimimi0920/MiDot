diff --git a/modules/gif/doc_classes/ImageFrames.xml b/modules/gif/doc_classes/ImageFrames.xml
new file mode 100644
index 0000000000000000000000000000000000000000..d0fcd8a6b8f028def8f5007b2550ad7ef1cce2a6
--- /dev/null
+++ b/modules/gif/doc_classes/ImageFrames.xml
@@ -0,0 +1,101 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="ImageFrames" inherits="Resource" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
+	<brief_description>
+		A sequence of image frames with individual durations.
+	</brief_description>
+	<description>
+		[ImageFrames] loads, stores, and saves animated GIF frames. Each frame contains an [Image] and a duration in seconds. Editor imports can convert GIF files to [AnimatedTexture] or [SpriteFrames] resources.
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+		<method name="add_frame">
+			<return type="void" />
+			<param index="0" name="image" type="Image" />
+			<param index="1" name="duration" type="float" default="0.05" />
+			<description>
+				Appends [param image] with its display [param duration] in seconds. The duration must be greater than [code]0.0[/code].
+			</description>
+		</method>
+		<method name="clear">
+			<return type="void" />
+			<description>
+				Removes all frames.
+			</description>
+		</method>
+		<method name="get_bounding_rect" qualifiers="const">
+			<return type="Rect2" />
+			<description>
+				Returns the smallest rectangle starting at [code]Vector2(0, 0)[/code] that encloses every frame image.
+			</description>
+		</method>
+		<method name="get_frame_count" qualifiers="const">
+			<return type="int" />
+			<description>
+				Returns the number of frames.
+			</description>
+		</method>
+		<method name="get_frame_duration" qualifiers="const">
+			<return type="float" />
+			<param index="0" name="index" type="int" />
+			<description>
+				Returns the duration in seconds of the frame at [param index].
+			</description>
+		</method>
+		<method name="get_frame_image" qualifiers="const">
+			<return type="Image" />
+			<param index="0" name="index" type="int" />
+			<description>
+				Returns the image of the frame at [param index].
+			</description>
+		</method>
+		<method name="load">
+			<return type="int" enum="Error" />
+			<param index="0" name="path" type="String" />
+			<param index="1" name="max_frames" type="int" default="0" />
+			<description>
+				Loads a GIF from [param path], replacing existing frames. If [param max_frames] is greater than [code]0[/code], stops after that many frames. Returns [constant OK] on success.
+			</description>
+		</method>
+		<method name="load_gif_from_buffer">
+			<return type="int" enum="Error" />
+			<param index="0" name="data" type="PackedByteArray" />
+			<param index="1" name="max_frames" type="int" default="0" />
+			<description>
+				Loads GIF-encoded [param data], replacing existing frames. If [param max_frames] is greater than [code]0[/code], stops after that many frames. Returns [constant OK] on success.
+			</description>
+		</method>
+		<method name="remove_frame">
+			<return type="void" />
+			<param index="0" name="index" type="int" />
+			<description>
+				Removes the frame at [param index].
+			</description>
+		</method>
+		<method name="save_gif">
+			<return type="int" enum="Error" />
+			<param index="0" name="filepath" type="String" />
+			<param index="1" name="color_count" type="int" default="256" />
+			<description>
+				Saves the frames to [param filepath] as a GIF. Multiple frames produce an infinitely looping animation and preserve durations with GIF's hundredth-of-a-second precision.
+				[param color_count] is clamped from [code]2[/code] to [code]256[/code] and rounded up to a power of two. Images that do not fit exactly in the palette use deterministic RGB quantization. Pixels with alpha below [code]0.5[/code] are transparent.
+			</description>
+		</method>
+		<method name="set_frame_duration">
+			<return type="void" />
+			<param index="0" name="index" type="int" />
+			<param index="1" name="duration" type="float" />
+			<description>
+				Sets the duration in seconds of the frame at [param index]. The duration must be greater than [code]0.0[/code].
+			</description>
+		</method>
+		<method name="set_frame_image">
+			<return type="void" />
+			<param index="0" name="index" type="int" />
+			<param index="1" name="image" type="Image" />
+			<description>
+				Replaces the image of the frame at [param index].
+			</description>
+		</method>
+	</methods>
+</class>
