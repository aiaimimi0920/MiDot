+
+class ImageFrames;
+
+typedef Error (*LoadImageFramesFunction)(const Ref<ImageFrames> &p_image_frames, const Variant &p_source, int p_max_frames);
+
+class ImageFrames : public Resource {
+	GDCLASS(ImageFrames, Resource);
+
+	struct Frame {
