+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="GifExporter" inherits="RefCounted" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
+	<brief_description>
+		Compatibility API for incrementally building animated GIF files.
+	</brief_description>
+	<description>
+		[GifExporter] preserves the legacy [method begin_export], [method write_frame], and [method end_export] workflow while using the modern GIF module internally. Frame delays use GIF hundredths of a second. Images are converted to RGBA8, composited over the supplied background color, quantized to the requested bit depth, and optionally Floyd-Steinberg dithered.
+		Call [method end_export] to observe write errors. Destroying an active exporter attempts to finish it for compatibility, but cannot report failure.
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+		<method name="begin_export">
+			<return type="bool" />
+			<param index="0" name="file_path" type="String" />
+			<param index="1" name="width" type="int" />
+			<param index="2" name="height" type="int" />
+			<param index="3" name="frame_delay" type="float" />
+			<param index="4" name="loop_count" type="int" default="0" />
+			<param index="5" name="bit_depth" type="int" default="8" />
+			<param index="6" name="dither" type="bool" default="false" />
+			<description>
+				Starts an export to [param file_path]. [param frame_delay] is the default delay in hundredths of a second, [param loop_count] is [code]0[/code] for infinite looping, and [param bit_depth] must be from [code]1[/code] to [code]8[/code]. Returns [code]false[/code] for invalid arguments or if an export is already active.
+			</description>
+		</method>
+		<method name="end_export">
+			<return type="bool" />
+			<description>
+				Writes all buffered frames and finishes the active export. Returns [code]false[/code] if no export is active, no frames were added, or the file cannot be written. A failed write remains active so it can be retried.
+			</description>
+		</method>
+		<method name="write_frame">
+			<return type="bool" />
+			<param index="0" name="frame" type="Image" />
+			<param index="1" name="background_color" type="Color" />
+			<param index="2" name="frame_delay" type="float" />
+			<param index="3" name="bit_depth" type="int" default="8" />
+			<param index="4" name="dither" type="bool" default="false" />
+			<description>
+				Buffers [param frame] using [param frame_delay] in hundredths of a second. A delay of [code]0[/code] uses the default passed to [method begin_export]. The image must match the export dimensions. Alpha is composited over [param background_color].
+			</description>
+		</method>
+	</methods>
+</class>
