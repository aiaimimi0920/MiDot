# Independent upstream checkout and incomplete initialization attempts.
/engine/
/engine.initialize-*/

# Current and archived compiled releases.
/export/
/export.stage-*/
/archive/export-*/
/archive/engine-color-dynamic-*/

# Local tool installations and temporary workspaces.
/.tools/
/.codex_tmp/
/.tmp/
/.validation/dynamic-theme-final/toolchain/

# Reproducible documentation snapshots and superseded fixture locations.
# Maintained fixture sources live in customizations/tests or topic verification/.
/archive/analysis/color-doc*/
/archive/verification/*-doctool*/
/archive/verification/gdscript-helper-smoke/
/archive/verification/gif-smoke/
/archive/verification/process-smoke/
/archive/verification/spine-smoke/
/archive/verification/spout-smoke/

# Generated caches. Keep historical source, probes, patches, and fixtures.
**/.godot/
**/__pycache__/
*.pyc

# Local validation/build output, not the validation source projects.
/.validation/**/*.log
/.validation/**/*.exe
/.validation/**/*.dll
/.validation/**/*.pck
/.validation/**/*.pdb
/.validation/**/*.exit
/.validation/**/build-*.exit-code.txt
/.runtime/**/*.log
/.runtime/**/*.exit
/.runtime/**/*.exe
/.runtime/**/*.dll
/.runtime/**/*.pck
/.runtime/**/*.pdb
/archive/verification/**/*.log
