# Independent upstream checkout and incomplete initialization attempts.
/engine/
/engine.initialize-*/

# Local compiled releases.
/export/
/export.stage-*/

# Retired archives are not part of the maintained workspace.
/archive/

# Local tool installations and temporary workspaces.
/.tools/
/.codex_tmp/
/.tmp/
/.validation/dynamic-theme-final/toolchain/

# Generated caches. Maintained tests live in customizations/.
**/.godot/
**/__pycache__/
*.pyc

# Local validation/build output, not the validation source projects.
/.validation/**/*.log
/.validation/**/*.exe
/.validation/**/*.dll
/.validation/**/*.pck
/.validation/**/*.pdb
/.validation/**/*.exit
/.validation/**/build-*.exit-code.txt
/.runtime/**/*.log
/.runtime/**/*.exit
/.runtime/**/*.exe
/.runtime/**/*.dll
/.runtime/**/*.pck
/.runtime/**/*.pdb
